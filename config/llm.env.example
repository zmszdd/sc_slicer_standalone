# Copy this file to config/llm.env and fill in the key you want to use.
#
# Provider options:
# - opencode: use the local opencode CLI and its configured credentials.
# - openai: use an OpenAI-compatible HTTP endpoint.

LLM_PROVIDER=opencode
MODEL_NAME=opencode-go/deepseek-v4-flash

# Only needed when LLM_PROVIDER=openai:
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# API_BASE_URL=https://api.openai.com/v1
