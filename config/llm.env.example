# Copy this file to config/llm.env and fill in the key you want to use.
#
# Provider options:
# - opencode: OpenAI-compatible OpenCode HTTP endpoint.
# - deepseek: official DeepSeek endpoint (uses config/stage2_deepseek.local.env).

LLM_PROVIDER=opencode
MODEL_NAME=opencode-go/deepseek-v4.1-flash

# Only needed when LLM_PROVIDER=opencode and the key is not in the environment:
# OPENCODE_API_KEY=
# Optional override for the OpenCode-compatible endpoint:
# API_BASE_URL=https://opencode.ai/inference/go/openai/v1
