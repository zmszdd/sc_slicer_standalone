# Optional path overrides for a portable checkout.
# Copy to config/paths.local.env and edit for the current machine.
# Environment variables have higher precedence than either file.

# Repository-relative default: ${SC_ROOT}/c4_pipeline_output
# C4_OUTPUT_ROOT=/data/sc_slicer/c4_pipeline_output

# Verified positive flatten corpus used by stage2/stage3 mainline runs.
# VERIFIED_FLATTEN_ROOT=/data/sc_slicer/verified_flatten_pass_1568_exact_cases

# Official negative flatten corpus and its readiness summary.
# NEGATIVE_FLATTEN_ROOT=/data/sc_slicer/c4_pipeline_output/objective_negative_flatten_20261121
# NEGATIVE_FLATTEN_SUMMARY=/data/sc_slicer/c4_pipeline_output/objective_negative_flatten_20261121/input-summary.json

# Colon-separated forge-std candidates for negative witness authoring.
# FORGE_STD_CANDIDATES=/data/forge-std:/data/another/project/lib/forge-std
