        for (uint i = 0; i < 3; i++) {
            PanopticVaultAccountant.ManagerPrices[]
                memory managerPrices = new PanopticVaultAccountant.ManagerPrices[](1);
            managerPrices[0] = PanopticVaultAccountant.ManagerPrices({
                poolPrice: i == 0 ? TWAP_TICK + deviations[i * 2] : TWAP_TICK,
                token0Price: i == 1 ? TWAP_TICK + deviations[i * 2] : TWAP_TICK,
                token1Price: i == 2 ? TWAP_TICK + deviations[i * 2] : TWAP_TICK
            });

            bytes memory managerInput = abi.encode(managerPrices, pools, new TokenId[][](1));

            // Should succeed at exact boundary
            uint256 nav = accountant.computeNAV(vault, address(underlyingToken), managerInput);

            // Expected: token0(100) + token1(200) + collateral0(50) + collateral1(75) + underlying(1000) = 1425
            uint256 expectedNav = 100e18 + 200e18 + 50e18 + 75e18 + 1000e18;
            uint256 tolerance = 15e18; // Tolerance for boundary deviation calculations
            assertApproxEqAbs(
                nav,
                expectedNav,
                tolerance,
                string(
                    abi.encodePacked(
                        "Boundary test ",
                        Strings_0.toString(i),
                        " should succeed with correct value"
                    )
                )
            );
        }
    }

    function test_computeNAV_flippedOracles_conversion() public {
        PanopticVaultAccountant.PoolInfo[] memory pools = createDefaultPools();
        pools[0].isUnderlyingToken0InOracle0 = true;
        pools[0].isUnderlyingToken0InOracle1 = true;
        accountant.updatePoolsHash(vault, keccak256(abi.encode(pools)));

        // Create different underlying to force conversion with flipped oracles
        MockERC20Partial flippedUnderlying = new MockERC20Partial("Flipped", "FLIP");

        setupPrecisionTestScenario(
            100e18, // token0
            200e18, // token1
            0, // no underlying balance
            0,
            0, // no collateral
            LeftRightUnsigned.wrap(0),
            LeftRightUnsigned.wrap(0)
        );

        bytes memory managerInput = createManagerInput(pools, new TokenId[][](1));
        uint256 nav = accountant.computeNAV(vault, address(flippedUnderlying), managerInput);

        // Expected: token0(100) + token1(200) converted with flipped oracles = ~300 (varies by conversion)
        uint256 expectedNavMin = 250e18; // Conservative minimum after flipped conversion
        uint256 expectedNavMax = 350e18; // Conservative maximum after flipped conversion
        assertTrue(
            nav >= expectedNavMin && nav <= expectedNavMax,
            "Flipped oracle conversion should work with expected range"
        );
    }

    /*//////////////////////////////////////////////////////////////
                        INTEGRATION TESTS
    //////////////////////////////////////////////////////////////*/

    function test_computeNAV_fullIntegration_realScenario() public {
        PanopticVaultAccountant.PoolInfo[] memory pools = createDefaultPools();
        accountant.updatePoolsHash(vault, keccak256(abi.encode(pools)));

        // Simulate a realistic vault scenario
        setupPrecisionTestScenario(
            1000e18, // 1000 USDC (token0)
            0.5e18, // 0.5 ETH (token1)
            500e18, // 500 underlying tokens
            100e18, // 100 collateral0
            0.1e18, // 0.1 collateral1
            LeftRightUnsigned.wrap((50e18 << 128) | 200e18), // Realistic premiums
            LeftRightUnsigned.wrap((20e18 << 128) | 150e18)
        );

        // Multiple positions representing a real strategy
        mockPool.setNumberOfLegs(vault, 3);
        uint256[2][] memory positions = new uint256[2][](2);
        positions[0] = [uint256(1), uint256(50)]; // Position 1
        positions[1] = [uint256(2), uint256(25)]; // Position 2
        mockPool.setMockPositionBalanceArray(positions);

        TokenId[][] memory tokenIds = new TokenId[][](1);
        tokenIds[0] = new TokenId[](2);
        tokenIds[0][0] = createOutOfRangeTokenId(TWAP_TICK, false, false); // OTM short put
        tokenIds[0][1] = createMultiLegTokenId(TWAP_TICK); // Spread

        bytes memory managerInput = createManagerInput(pools, tokenIds);
        uint256 nav = accountant.computeNAV(vault, address(underlyingToken), managerInput);

        // Expected base: token0(1000) + token1(0.5) + collateral0(100) + collateral1(0.1) + underlying(500) = ~1600.6
        // Plus premiums: (200-150) + (50-20) = 50 + 30 = 80
        // Plus position effects for realistic strategy
        uint256 expectedNavBase = 1000e18 + 0.5e18 + 100e18 + 0.1e18 + 500e18 + 80e18;
        uint256 tolerance = 200e18; // Large tolerance for complex realistic scenario
        assertApproxEqAbs(
            nav,
            expectedNavBase,
            tolerance,
            "NAV should match expected realistic scenario calculation"
        );

        // Test determinism
        uint256 nav2 = accountant.computeNAV(vault, address(underlyingToken), managerInput);
        assertEq(nav, nav2, "NAV calculation should be deterministic");
    }
}


contract PoC is Test {
    // Vault Data
    VaultAccountantMock public mockAccountant;
    HypoVault public vault;
    ERC20S public token;

    // Accountant Data
    PanopticVaultAccountant public accountant;
    MockERC20Partial public token0;
    MockERC20Partial public token1;
    MockERC20Partial public underlyingToken;
    MockV3CompatibleOracle public poolOracle;
    MockV3CompatibleOracle public oracle0;
    MockV3CompatibleOracle public oracle1;
    MockPanopticPool public mockPool;

    // Test Addresses
    address Manager = address(0x1234);
    address FeeWallet = address(0x5678);
    address Alice = address(0x123456);
    address Bob = address(0x12345678);
    address Charlie = address(0x1234567891);
    address Dave = address(0x12345678912);
    address Eve = address(0x123456789123);

    // Test Parameters
    uint256 constant INITIAL_BALANCE = 1000000 ether;
    uint256 constant BOOTSTRAP_SHARES = 1_000_000;
    int24 constant TWAP_TICK = 100;
    int24 constant MAX_PRICE_DEVIATION = 50;
    uint32 constant TWAP_WINDOW = 600; // 10 minutes

    function setUp() public {
        mockAccountant = new VaultAccountantMock();
        token = new ERC20S("Test Token", "TEST", 18);
        vault = new HypoVault(address(token), Manager, IVaultAccountant(address(mockAccountant)), 100); // 1% performance fee

        // Set fee wallet
        vault.setFeeWallet(FeeWallet);

        // Mint tokens and approve vault for all users
        address[6] memory users = [Alice, Bob, Charlie, Dave, Eve, Manager];
        for (uint i = 0; i < users.length; i++) {
            token.mint(users[i], INITIAL_BALANCE);
            vm.prank(users[i]);
            token.approve(address(vault), type(uint256).max);
        }
        
        accountant = new PanopticVaultAccountant();
        token0 = new MockERC20Partial("Token0", "T0");
        token1 = new MockERC20Partial("Token1", "T1");
        underlyingToken = new MockERC20Partial("Underlying", "UND");
        poolOracle = new MockV3CompatibleOracle();
        oracle0 = new MockV3CompatibleOracle();
        oracle1 = new MockV3CompatibleOracle();
        mockPool = new MockPanopticPool();

        // Setup default oracle behavior
        _setupDefaultOracles();
    }

    function _setupDefaultOracles() internal {
        // Setup consistent tick cumulatives for TWAP calculation
        // The TWAP filter computes (tickCumulative[i] - tickCumulative[i+1]) / (twapWindow / 20)
        // So for a constant tick of 100, we need cumulative differences of 100 * (twapWindow / 20)
        int56[] memory defaultTicks = new int56[](20);
        uint32 intervalDuration = TWAP_WINDOW / 20; // 30 seconds

        // Create tick cumulatives that will result in TWAP_TICK when filtered
        for (uint i = 0; i < 20; i++) {
            defaultTicks[i] = int56(
                int256(TWAP_TICK) * int256(uint256(intervalDuration)) * int256(20 - i)
            );
        }
        poolOracle.setTickCumulatives(defaultTicks);
        oracle0.setTickCumulatives(defaultTicks);
        oracle1.setTickCumulatives(defaultTicks);
    }

    function test_submissionValidity() external {
        // Proof of Concept code demonstrating the vulnerability where available assets
        // do not properly account for long positions

        // Create interfaces to properly cast types
        PanopticPool mockPoolInterface = PanopticPool(address(mockPool));

        // Setup the accountant and mock pool
        PanopticVaultAccountant.PoolInfo[] memory pools = new PanopticVaultAccountant.PoolInfo[](1);
        pools[0] = PanopticVaultAccountant.PoolInfo({
            pool: mockPoolInterface,
            token0: token0,
            token1: token1,
            poolOracle: poolOracle,
            oracle0: oracle0,
            isUnderlyingToken0InOracle0: true,
            oracle1: oracle1,
            isUnderlyingToken0InOracle1: false,
            maxPriceDeviation: MAX_PRICE_DEVIATION,
            twapWindow: TWAP_WINDOW
        });

        // Setup the vault
        accountant.updatePoolsHash(address(vault), keccak256(abi.encode(pools)));

        // Setup initial token balances
        uint256 initialAmount = 1000 ether;
        token0.mint(address(vault), initialAmount);

        // First, let's compute the baseline NAV without any positions
        PanopticVaultAccountant.ManagerPrices[]
            memory baseManagerPrices = new PanopticVaultAccountant.ManagerPrices[](1);
        baseManagerPrices[0] = PanopticVaultAccountant.ManagerPrices({
            poolPrice: TWAP_TICK,
            token0Price: TWAP_TICK,
            token1Price: TWAP_TICK
        });

        // Empty position array for baseline
        TokenId[][] memory emptyTokenIds = new TokenId[][](1);
        emptyTokenIds[0] = new TokenId[](0);

        bytes memory baseManagerInput = abi.encode(baseManagerPrices, pools, emptyTokenIds);

        // Calculate baseline NAV with no positions
        uint256 baselineNAV = accountant.computeNAV(
            address(vault),
            address(token0),
            baseManagerInput
        );
        console.log("Baseline NAV (no positions): ", baselineNAV);

        // Simulate a short position: reduce available assets due to collateral locked in AMM pool
        uint256 shortPositionAmount = 500 ether;
        token0.mint(address(mockPool), shortPositionAmount); // Tokens moved to AMM pool for short position

        // Setup mock position for the accountant
        uint256[2][] memory shortPositions = new uint256[2][](1);
        shortPositions[0] = [uint256(1), uint256(shortPositionAmount)]; // Position ID and amount
        mockPool.setMockPositionBalanceArray(shortPositions);
        mockPool.setNumberOfLegs(address(vault), 0);

        // For short position premium
        mockPool.setMockPremiums(
            LeftRightUnsigned.wrap(0),
            LeftRightUnsigned.wrap(uint256(shortPositionAmount))
        );

        // Create manager input for NAV calculation
        PanopticVaultAccountant.ManagerPrices[]
            memory managerPrices = new PanopticVaultAccountant.ManagerPrices[](1);
        managerPrices[0] = PanopticVaultAccountant.ManagerPrices({
            poolPrice: TWAP_TICK,
            token0Price: TWAP_TICK,
            token1Price: TWAP_TICK
        });

        bytes memory managerInput = abi.encode(managerPrices, pools, emptyTokenIds);

        // Calculate NAV with short position (should be reduced due to locked collateral)
        uint256 navWithShort = accountant.computeNAV(address(vault), address(token0), managerInput);

        console.log("NAV with short position (expected reduced): ", navWithShort);
        console.log("Reduction due to short position: ", baselineNAV - navWithShort);

        // Verify short position correctly reduces available assets
        assertLt(navWithShort, baselineNAV, "Short position should reduce NAV");
        assertEq(
            baselineNAV - navWithShort,
            shortPositionAmount,
            "NAV should be reduced by short position amount"
        );

        // Now simulate a long position: tokens move from AMM pool back to Panoptic Pool
        uint256 longPositionAmount = 400 ether;
        token0.mint(address(vault), longPositionAmount); // Tokens moved back to Panoptic Pool

        // Update mocks to reflect both positions
        uint256[2][] memory bothPositions = new uint256[2][](2);
        bothPositions[0] = [uint256(1), uint256(shortPositionAmount)]; // Short position
        bothPositions[1] = [uint256(2), uint256(longPositionAmount)]; // Long position
        mockPool.setMockPositionBalanceArray(bothPositions);

        // Update premiums to include both positions - long premium in leftSlot, short in rightSlot
        mockPool.setMockPremiums(
            LeftRightUnsigned.wrap(uint256(longPositionAmount)),
            LeftRightUnsigned.wrap(uint256(shortPositionAmount))
        );

        // The vulnerability: calculate NAV again but with long position
        uint256 navWithBoth = accountant.computeNAV(address(vault), address(token0), managerInput);

        console.log("NAV with both positions: ", navWithBoth);
        console.log("Increase from short-only to both positions: ", navWithBoth - navWithShort);

        // This demonstrates the vulnerability: NAV increases due to tokens returned to vault,
        // but these tokens are needed to back the long positions
        assertGt(navWithBoth, navWithShort, "NAV improperly increases with long position");

        // Calculate the vulnerable assets available for withdrawal
        uint256 availableForWithdrawal = navWithBoth - (baselineNAV - navWithShort);
        console.log("Vulnerable assets available for withdrawal: ", availableForWithdrawal);

        // Demonstrate the issue: The LP should not be able to withdraw these assets
        // as they are needed to back the long positions
        assertGt(
            availableForWithdrawal,
            0,
            "Vulnerability exists: assets needed for long positions can be withdrawn"
        );

        // Vulnerability impact: The vulnerability is WORSE than expected!
        // The available withdrawal amount is 2x the long position amount
        console.log(
            "Vulnerability ratio: available withdrawal / long position = ",
            (availableForWithdrawal * 100) / longPositionAmount,
            "%"
        );

        // Demonstrate that the vulnerability is WORSE than expected - available withdrawal is 2x the long position amount
        assertEq(
            availableForWithdrawal,
            2 * longPositionAmount,
            "CRITICAL VULNERABILITY: Available withdrawal is exactly 2x the long position amount"
        );

        // EXPLANATION OF DOUBLE-COUNTING VULNERABILITY:
        // 1. The vault's token balance increased by longPositionAmount (400 ether)
        // 2. The NAV also incorrectly adds the long position value (400 ether) as a positive contribution
        //    instead of treating it as a liability
        // 3. This results in double-counting: once for the actual tokens and once for the position value
        // 4. Therefore, LPs can withdraw 2x the amount needed to back long positions

        console.log("EXPLANATION OF DOUBLE-COUNTING:");
        console.log("1. Actual tokens returned to vault: ", longPositionAmount);
        console.log("2. Long position incorrectly counted as positive value: ", longPositionAmount);
        console.log("3. Total double-counted assets: ", 2 * longPositionAmount);
        
    }
}
