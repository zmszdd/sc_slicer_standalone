    function twapFilter(
        IV3CompatibleOracle oracleContract,
        uint32 twapWindow
    ) external view returns (int24) {
        uint32[] memory secondsAgos = new uint32[](20);

        int256[] memory twapMeasurement = new int256[](19);

        unchecked {
            // construct the time slots
