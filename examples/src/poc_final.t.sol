                    _asset: 0,
                    _isLong: 1,
                    _tokenType: 0,
                    _riskPartner: 0,
                    _strike: currentTick - 500,
                    _width: 10
                })
                .addLeg({
                    legIndex: 1,
                    _optionRatio: 1,
                    _asset: 1,
                    _isLong: 0,
                    _tokenType: 1,
                    _riskPartner: 1,
                    _strike: currentTick + 500,
                    _width: 12
                });
    }

