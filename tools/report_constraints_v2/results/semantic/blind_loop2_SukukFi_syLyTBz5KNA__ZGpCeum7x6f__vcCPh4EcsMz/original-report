sOperator(owner, msg.sender))) revert InvalidOwner();\n+        if (controller == address(0)) revert ZeroAddress();\n         if (assets == 0) revert ZeroAssets();\n@@ function requestRedeem(uint256 shares, address controller, address owner) external nonReentrant returns (uint256 requestId) {\n-        if (shares == 0) revert ZeroShares();\n+        if (shares == 0) revert ZeroShares();\n+        if (controller == address(0)) revert ZeroAddress();\n         bool isOwnerOrOperator = owner == msg.sender || IERC7540($.shareToken).isOperator(owner, msg.sender);\n\n```",
      "proofOfConcept": "## poc \nAdded test in `test/ERC7575VaultUpgradeableCoverageTests.t.sol:330–360`\n```solidity\n    function testZeroAddressControllerLocksDeposit() public {\n        uint256 amount = 1000 * 1e18;\n        vm.prank(user1);\n        vault.requestDeposit(amount, address(0), user1);\n\n        uint256 pendingBefore = vault.pendingDepositRequest(0, address(0));\n        assertEq(pendingBefore, amount);\n\n        vm.prank(user1);\n        vm.expectRevert();\n        vault.cancelDepositRequest(0, address(0));\n\n        vault.fulfillDeposit(address(0), amount);\n\n        uint256 claimable = vault.claimableDepositRequest(0, address(0));\n        assertEq(claimable, amount);\n\n        vm.prank(user1);\n        vm.expectRevert();\n        vault.deposit(amount, user1, address(0));\n\n        address[] memory reqs = vault.getActiveDepositRequesters();\n        bool found;\n        for (uint256 i = 0; i < reqs.length; i++) {\n            if (reqs[i] == address(0)) {\n                found = true;\n                break;\n            }\n        }\n        assertTrue(found, \"zero address remains active requester\");\n    }\n```\n\n```c\nforge test -vv --match-test testZeroAddressControllerLocksDeposit\n```",
