{
  "schema_version": "report-evidence/1",
  "source_sha256": "8f3c823557cea3bc0b42fff92cfb67396cde7e27827184fb1b8067e4b23e1b78",
  "fragments": [
    {
      "id": "e_8f3c823557ce_0001",
      "text": "### Root Cause",
      "start": 0,
      "end": 14,
      "line": 1
    },
    {
      "id": "e_8f3c823557ce_0002",
      "text": "In `transferFrom()`, the code does this:",
      "start": 17,
      "end": 57,
      "line": 2
    },
    {
      "id": "e_8f3c823557ce_0003",
      "text": "But the ERC-20 standard says the first argument must be the account whose tokens were taken (`from`), not the spender (`msg.sender`).",
      "start": 60,
      "end": 193,
      "line": 5
    },
    {
      "id": "e_8f3c823557ce_0004",
      "text": "Correct version:",
      "start": 195,
      "end": 211,
      "line": 7
    },
    {
      "id": "e_8f3c823557ce_0005",
      "text": "Because of this one-line mistake, every `transferFrom()` emits a lie in the event log.",
      "start": 213,
      "end": 299,
      "line": 9
    },
    {
      "id": "e_8f3c823557ce_0006",
      "text": "### Vulnerable Path",
      "start": 301,
      "end": 320,
      "line": 11
    },
    {
      "id": "e_8f3c823557ce_0007",
      "text": "1. Alice calls `approve(Bob, 1000)`",
      "start": 323,
      "end": 358,
      "line": 12
    },
    {
      "id": "e_8f3c823557ce_0008",
      "text": "2. Bob calls `transferFrom(Alice → Bridge, 1000)`",
      "start": 359,
      "end": 408,
      "line": 13
    },
    {
      "id": "e_8f3c823557ce_0009",
      "text": "3. On-chain:",
      "start": 409,
      "end": 421,
      "line": 14
    },
    {
      "id": "e_8f3c823557ce_0010",
      "text": "- Alice’s balance −1000",
      "start": 427,
      "end": 450,
      "line": 15
    },
    {
      "id": "e_8f3c823557ce_0011",
      "text": "- Bridge balance +1000",
      "start": 456,
      "end": 478,
      "line": 16
    },
    {
      "id": "e_8f3c823557ce_0012",
      "text": "→ everything correct",
      "start": 484,
      "end": 504,
      "line": 17
    },
    {
      "id": "e_8f3c823557ce_0013",
      "text": "4. Event emitted:",
      "start": 505,
      "end": 522,
      "line": 18
    },
    {
      "id": "e_8f3c823557ce_0014",
      "text": "5. Any system that watches events thinks Bob owns and sent the tokens",
      "start": 523,
      "end": 592,
      "line": 19
    },
    {
      "id": "e_8f3c823557ce_0015",
      "text": "### Impact",
      "start": 594,
      "end": 604,
      "line": 21
    },
    {
      "id": "e_8f3c823557ce_0016",
      "text": "Bridges that credit based on Transfer events → mint tokens to Bob instead of Alice",
      "start": 607,
      "end": 689,
      "line": 22
    }
  ]
}
