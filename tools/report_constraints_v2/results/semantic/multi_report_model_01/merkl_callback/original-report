      "body": "## Finding description and impact\n\nThe `Distributor._claim()` function incorrectly supplies the cumulative entitlement `(amount)` to the onClaim callback rather than the actual transferred amount `(toSend).` After the first claim, these values diverge, causing integrating protocols to operate on incorrect token amount assumptions.\n\n## Impact\nAny contract relying on the amount parameter for reward accounting will receive incorrect values after the first claim. This can cause state desynchronization, incorrect reward distribution, or loss of funds in downstream protocols.\n\n## Recommended mitigation steps\n```diff\nDescribe the best method(s) to mitigate the finding.\nif (toSend != 0) {\n    IERC20(token).safeTransfer(recipient, toSend);\n    if (data.length != 0) {\n-       try IClaimRecipient(recipient).onClaim(user, token, amount, data)\n+       try IClaimRecipient(recipient).onClaim(user, token, toSend, data)\n\n```",
      "proofOfConcept": "```solidity\n// SPDX-License-Identifier: UNLICENSED\npragma solidity ^0.8.17;\n\nimport { console } from \"forge-std/console.sol\";\nimport { IERC20 } from \"@openzeppelin/contracts/token/ERC20/IERC20.sol\";\n\nimport { Fixture } from \"../Fixture.t.sol\";\nimport { Distributor, MerkleTree } from \"../../contracts/Distributor.sol\";\nimport { IAccessControlManager } from \"../../contracts/interfaces/IAccessControlManager.sol\";\nimport { IClaimRecipient } from \"../../contracts/interfaces/IClaimRecipient.sol\";\n\n\ncontract AmountTrackingRecipient is IClaimRecipient {\n    bytes32 public constant CALLBACK_SUCCESS = keccak256(\"IClaimRecipient.onClaim\");\n\n    uint256 public reportedAmount;\n    uint256 public balanceBefore;\n    uint256 public balanceAfter;\n    address public token;\n\n    function setToken(address _token) external {\n        token = _token;\n    }\n\n    function recordBalanceBefore() external {\n        balanceBefore = IERC20(token).balanceOf(address(this));\n    }\n\n    function onClaim(address, address, uint256 amount, bytes memory) external returns (bytes32) {\n        reportedAmount = amount;\n        balanceAfter = IERC20(token).balanceOf(address(this));\n        return CALLBACK_SUCCESS;\n    }\n\n    function getActualReceived() external view returns (uint256) {\n        return balanceAfter - balanceBefore;\n    }\n\n    function getMismatch() external view returns (bool hasMismatch, uint256 reported, uint256 actual) {\n        actual = balanceAfter - balanceBefore;\n        reported = reportedAmount;\n        hasMismatch = reported != actual;\n    }\n}\n\n\ncontract C4PoC_OnClaimAmountMismatch is Fixture {\n    Distributor public distributor;\n    Distributor public distributorImpl;\n    AmountTrackingRecipient public recipient;\n\n    function setUp() public override {\n        super.setUp();\n\n        // Deploy Distributor (not included in base Fixture)\n        distributorImpl = new Distributor();\n        distributor = Distributor(deployUUPS(address(distributorImpl), hex\"\"));\n        distributor.initialize(IAccessControlManager(address(accessControlManager)));\n\n        // Deploy recipient contract for tracking callback amounts\n        recipient = new AmountTrackingRecipient();\n        recipient.setToken(address(angle));\n\n        // Setup dispute parameters - simplified for testing\n        vm.startPrank(governor);\n        distributor.setDisputeAmount(0);\n        distributor.setDisputePeriod(0);\n        vm.stopPrank();\n\n        // Fund the distributor with tokens for claims\n        angle.mint(address(distributor), 100e18);\n    }\n\n    /**\n     * @notice Helper to compute merkle leaf\n     */\n    function computeLeaf(address user, address token, uint256 amount) public pure returns (bytes32) {\n        return keccak256(abi.encode(user, token, amount));\n    }\n\n    /**\n     * @notice Helper to compute merkle root for a single leaf (simplified)\n     */\n    function computeSingleLeafRoot(bytes32 leaf) public pure returns (bytes32) {\n        return leaf; // For a single leaf tree, root = leaf\n    }\n\nfunction test_demonstrateOnClaimAmountBug() external {\n    // --- STEP 1: Setup first merkle tree where Alice can claim 10e18 ---\n    bytes32 firstLeaf = computeLeaf(alice, address(angle), 10e18);\n    bytes32 firstRoot = computeSingleLeafRoot(firstLeaf);\n\n    vm.prank(governor);\n    distributor.updateTree(MerkleTree({ merkleRoot: firstRoot, ipfsHash: bytes32(0) }));\n\n    // Move past dispute period\n    vm.warp(block.timestamp + 2 hours);\n\n    // --- STEP 2: Alice claims first time with recipient contract ---\n    // Set Alice's recipient to our tracking contract\n    vm.prank(alice);\n    distributor.setClaimRecipient(address(recipient), address(angle));\n\n    // Prepare claim data\n    bytes32[][] memory claimProofs = new bytes32[][](1);\n    address[] memory claimUsers = new address[](1);\n    address[] memory claimTokens = new address[](1);\n    uint256[] memory claimAmounts = new uint256[](1);\n    address[] memory claimRecipients = new address[](1);\n    bytes[] memory claimDatas = new bytes[](1);\n\n    claimProofs[0] = new bytes32[](0); // Single leaf = no proof needed\n    claimUsers[0] = alice;\n    claimTokens[0] = address(angle);\n    claimAmounts[0] = 10e18;\n    claimRecipients[0] = address(0); // Use default (our tracking recipient)\n    claimDatas[0] = abi.encode(\"trigger callback\");\n\n    // Record balance before claim\n    recipient.recordBalanceBefore();\n\n    // Alice claims\n    vm.prank(alice);\n    distributor.claimWithRecipient(claimUsers, claimTokens, claimAmounts, claimProofs, claimRecipients, claimDatas);\n\n    // Check first claim - amounts should match for first claim\n    (bool firstMismatch, uint256 firstReported, uint256 firstActual) = recipient.getMismatch();\n\n    console.log(\"=== First Claim ===\");\n    console.log(\"Reported amount in callback:\", firstReported);\n    console.log(\"Actual tokens received:\", firstActual);\n    console.log(\"Has mismatch:\", firstMismatch);\n\n    // First claim should be correct (10e18 reported, 10e18 received)\n    assertEq(firstReported, 10e18, \"First claim: reported should be 10e18\");\n    assertEq(firstActual, 10e18, \"First claim: actual should be 10e18\");\n    assertFalse(firstMismatch, \"First claim should have no mismatch\");\n\n    // --- STEP 3: Update merkle tree - Alice now entitled to 15e18 cumulative ---\n    bytes32 secondLeaf = computeLeaf(alice, address(angle), 15e18);\n    bytes32 secondRoot = computeSingleLeafRoot(secondLeaf);\n\n    vm.prank(governor);\n    distributor.updateTree(MerkleTree({ merkleRoot: secondRoot, ipfsHash: bytes32(0) }));\n\n    // Move past dispute period\n    vm.warp(block.timestamp + 2 hours);\n\n    // --- STEP 4: Alice claims second time ---\n    claimAmounts[0] = 15e18; // New cumulative amount\n    claimProofs[0] = new bytes32[](0);\n\n    // Record balance before second claim\n    recipient.recordBalanceBefore();\n\n    // Alice claims again\n    vm.prank(alice);\n    distributor.claimWithRecipient(claimUsers, claimTokens, claimAmounts, claimProofs, claimRecipients, claimDatas);\n\n    // Check second claim - THIS IS WHERE THE BUG IS EXPOSED\n    (bool secondMismatch, uint256 secondReported, uint256 secondActual) = recipient.getMismatch();\n\n    console.log(\"\");\n    console.log(\"=== Second Claim (BUG EXPOSED) ===\");\n    console.log(\"Reported amount in callback:\", secondReported);\n    console.log(\"Actual tokens received:\", secondActual);\n    console.log(\"Has mismatch:\", secondMismatch);\n\n    // BUG: Callback reports 15e18 but only 5e18 was actually transferred!\n    // The callback should receive toSend (5e18), not amount (15e18)\n    assertEq(secondReported, 15e18, \"Second claim: reported is cumulative 15e18\");\n    assertEq(secondActual, 5e18, \"Second claim: actual should be only 5e18 (15-10)\");\n    assertTrue(secondMismatch, \"Second claim SHOULD have mismatch - this is the bug!\");\n\n    // Calculate the discrepancy\n    uint256 amountDiscrepancy = secondReported - secondActual;\n    console.log(\"\");\n    console.log(\"=== BUG IMPACT ===\");\n    console.log(\"Discrepancy (reported - actual):\", amountDiscrepancy);\n    console.log(\"Integrating contracts think they received:\", secondReported);\n    console.log(\"But they actually only received:\", secondActual);\n\n    assertEq(amountDiscrepancy, 10e18, \"Discrepancy should be 10e18 (the previously claimed amount)\");\n}\n\nfunction test_onClaimBugScalesWithClaims() public {\n    // This test shows the mismatch grows larger with each subsequent claim\n\n    bytes32 initialLeaf = computeLeaf(alice, address(angle), 5e18);\n    bytes32 initialRoot = computeSingleLeafRoot(initialLeaf);\n\n    vm.prank(governor);\n    distributor.updateTree(MerkleTree({ merkleRoot: initialRoot, ipfsHash: bytes32(0) }));\n    vm.warp(block.timestamp + 2 hours);\n\n    vm.prank(alice);\n    distributor.setClaimRecipient(address(recipient), address(angle));\n\n    bytes32[][] memory scalingProofs = new bytes32[][](1);\n    address[] memory scalingUsers = new address[](1);\n    address[] memory scalingTokens = new address[](1);\n    uint256[] memory scalingAmounts = new uint256[](1);\n    address[] memory scalingRecipients = new address[](1);\n    bytes[] memory scalingDatas = new bytes[](1);\n\n    scalingProofs[0] = new bytes32[](0);\n    scalingUsers[0] = alice;\n    scalingTokens[0] = address(angle);\n    scalingAmounts[0] = 5e18;\n    scalingRecipients[0] = address(0);\n    scalingDatas[0] = abi.encode(\"test\");\n\n    // First claim\n    recipient.recordBalanceBefore();\n    vm.prank(alice);\n    distributor.claimWithRecipient(scalingUsers, scalingTokens, scalingAmounts, scalingProofs, scalingRecipients, scalingDatas);\n\n    // Update to 10e18\n    bytes32 updatedLeaf = computeLeaf(alice, address(angle), 10e18);\n    bytes32 updatedRoot = computeSingleLeafRoot(updatedLeaf);\n    vm.prank(governor);\n    distributor.updateTree(MerkleTree({ merkleRoot: updatedRoot, ipfsHash: bytes32(0) }));\n    vm.warp(block.timestamp + 2 hours);\n\n    // Second claim\n    scalingAmounts[0] = 10e18;\n    recipient.recordBalanceBefore();\n    vm.prank(alice);\n    distributor.claimWithRecipient(scalingUsers, scalingTokens, scalingAmounts, scalingProofs, scalingRecipients, scalingDatas);\n\n    (bool scalingMismatch2, uint256 scalingReported2, uint256 scalingActual2) = recipient.getMismatch();\n    assertEq(scalingReported2, 10e18, \"Reports 10e18\");\n    assertEq(scalingActual2, 5e18, \"Actually received 5e18\");\n    assertTrue(scalingMismatch2);\n\n    // Update to 20e18\n    bytes32 finalLeaf = computeLeaf(alice, address(angle), 20e18);\n    bytes32 finalRoot = computeSingleLeafRoot(finalLeaf);\n    vm.prank(governor);\n    distributor.updateTree(MerkleTree({ merkleRoot: finalRoot, ipfsHash: bytes32(0) }));\n    vm.warp(block.timestamp + 2 hours);\n\n    // Third claim\n    scalingAmounts[0] = 20e18;\n    recipient.recordBalanceBefore();\n    vm.prank(alice);\n    distributor.claimWithRecipient(scalingUsers, scalingTokens, scalingAmounts, scalingProofs, scalingRecipients, scalingDatas);\n\n    (bool scalingMismatch3, uint256 scalingReported3, uint256 scalingActual3) = recipient.getMismatch();\n    assertEq(scalingReported3, 20e18, \"Reports 20e18\");\n    assertEq(scalingActual3, 10e18, \"Actually received 10e18\");\n    assertTrue(scalingMismatch3);\n\n    console.log(\"=== Mismatch Progression ===\");\n    console.log(\"Claim 2: Reported %s, Actual %s\", scalingReported2, scalingActual2);\n    console.log(\"Claim 3: Reported %s, Actual %s\", scalingReported3, scalingActual3);\n}\n\n}\n```",
