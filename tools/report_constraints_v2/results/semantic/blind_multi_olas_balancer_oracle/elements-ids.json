    {
      "id": "pool_balances_read_as_spot",
      "kind": "precondition",
      "text": "BalancerPriceOracle.getPrice() reads pool balances directly from the Vault and returns a simple reserve ratio, a spot price that changes whenever the pool is traded.",
      "modality": "asserted",
      "entity_ids": [
        "balancer_price_oracle",
        "balancer_vault",
        "pool"
      ],
      "evidence_ids": [
        "e_d166b8fd1ba7_0003"
      ]
    },
    {
      "id": "update_price_permissionless",
      "kind": "precondition",
      "text": "updatePrice() is permissionless, so any address can decide when the oracle snapshot is updated.",
      "modality": "asserted",
      "entity_ids": [
        "balancer_price_oracle",
        "attacker"
      ],
      "evidence_ids": [
        "e_d166b8fd1ba7_0004"
      ]
    },
    {
      "id": "attacker_holds_manipulated_spot",
      "kind": "precondition",
      "text": "An attacker can keep the pool in a manipulated spot regime over time.",
      "modality": "potential",
      "entity_ids": [
        "attacker",
        "pool"
      ],
      "evidence_ids": [
        "e_d166b8fd1ba7_0005"
      ]
    },
    {
      "id": "call_update_price",
      "kind": "action",
      "text": "The attacker calls updatePrice(), which writes the oracle snapshot based on the current spot price returned by getPrice().",
      "modality": "potential",
      "entity_ids": [
        "attacker",
        "balancer_price_oracle"
      ],
      "evidence_ids": [
        "e_d166b8fd1ba7_0004"
      ]
    },
    {
      "id": "snapshot_moves_to_attacker_regime",
      "kind": "root_cause",
      "text": "Because updatePrice() derives the snapshot from the current spot regime, repeated updates while the pool is manipulated move the stored snapshot away from the original market price toward the attacker-controlled regime.",
      "modality": "potential",
      "entity_ids": [
        "attacker",
        "balancer_price_oracle",
        "pool"
      ],
      "evidence_ids": [
        "e_d166b8fd1ba7_0004",
        "e_d166b8fd1ba7_0005"
      ]
    },
    {
      "id": "validate_compares_spot_to_snapshot",
      "kind": "root_cause",
      "text": "validatePrice(slippage) compares current spot price to a band around the computed timeWeightedAverage, which in practice only enforces that current spot is near the oracle's stored snapshot state.",
      "modality": "asserted",
      "entity_ids": [
        "balancer_price_oracle"
      ],
      "evidence_ids": [
        "e_d166b8fd1ba7_0005"
      ]
    },
    {
      "id": "intent_no_raw_vault_balances_oracle",
      "kind": "security_intent",
      "text": "Raw Vault balances must not be used as an oracle for slippage protection of large protocol swaps.",
      "modality": "asserted",
      "entity_ids": [
        "balancer_price_oracle",
        "balancer_vault",
        "protocol_swaps"
      ],
      "evidence_ids": [
        "e_d166b8fd1ba7_0007"
      ]
    },
    {
      "id": "intent_snapshot_not_steerable",
      "kind": "security_intent",
      "text": "The oracle snapshot must not be steerable away from the original market price by an attacker controlling the pool spot regime and calling updatePrice() over time.",
      "modality": "asserted",
