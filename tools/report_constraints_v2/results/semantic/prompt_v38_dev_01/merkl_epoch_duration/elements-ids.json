  "statements": [
    {
      "id": "p_epoch_model",
      "kind": "precondition",
      "text": "The Merkl protocol relies on discrete 1-hour epochs (EPOCH_DURATION) for reward calculation and distribution.",
      "modality": "asserted",
      "entity_ids": [
        "distribution_creator_contract",
        "campaign"
      ],
      "evidence_ids": [
        "e_cd512f8674c8_0007"
      ]
    },
    {
      "id": "p_creator_nonnultiple_duration",
      "kind": "precondition",
      "text": "A creator supplies a campaign duration of 5400 seconds (1.5 hours), which is not a multiple of EPOCH_DURATION.",
      "modality": "asserted",
      "entity_ids": [
        "campaign_creator",
        "campaign"
      ],
      "evidence_ids": [
        "e_cd512f8674c8_0008"
      ]
    },
    {
      "id": "a_invoke_create_campaign",
      "kind": "action",
      "text": "The creator invokes createCampaign/_createCampaign to create the campaign with the supplied duration.",
      "modality": "asserted",
      "entity_ids": [
        "campaign_creator",
        "distribution_creator_contract"
      ],
      "evidence_ids": [
        "e_cd512f8674c8_0001",
        "e_cd512f8674c8_0004"
      ]
    },
    {
      "id": "rc_missing_multiple_check",
      "kind": "root_cause",
      "text": "DistributionCreator._createCampaign and overrideCampaign only enforce the minimum duration and fail to enforce the documented multiple-of-EPOCH_DURATION requirement.",
      "modality": "asserted",
      "entity_ids": [
        "distribution_creator_contract"
      ],
      "evidence_ids": [
        "e_cd512f8674c8_0004"
      ]
    },
    {
      "id": "i_partial_epoch_campaign",
      "kind": "impact",
      "text": "The resulting campaign covers one full epoch and one half-epoch (a partial epoch).",
      "modality": "asserted",
      "entity_ids": [
        "campaign"
      ],
      "evidence_ids": [
        "e_cd512f8674c8_0008"
      ]
    },
    {
      "id": "i_offchain_reject_or_drop",
      "kind": "impact",
      "text": "The off-chain indexing engine may reject the campaign entirely (locking user funds) or drop the final partial epoch (causing loss of user rewards).",
      "modality": "potential",
      "entity_ids": [
        "campaign",
        "offchain_indexing_engine",
        "user_funds"
      ],
      "evidence_ids": [
        "e_cd512f8674c8_0009"
      ]
    },
    {
      "id": "si_enforce_duration_multiple",
      "kind": "security_intent",
      "text": "Campaign creation should enforce at its checkpoint that the supplied duration is a multiple of EPOCH_DURATION, as explicitly required by the CampaignParameter documentation.",
      "modality": "asserted",
      "entity_ids": [
        "distribution_creator_contract"
      ],
      "evidence_ids": [
        "e_cd512f8674c8_0003",
        "e_cd512f8674c8_0004"
      ]
    },
