          }),\n            calculatedAmountThreshold: type(int256).min,\n            recipient: address(this)\n        });\n\n        int128 exactIn_paid = result1.delta0();      // positive = user pays\n        int128 exactIn_received = -result1.delta1(); // negative flipped = user receives\n\n        console.log(\"=== Pool 1: ExactIn ===\");\n        console.log(\"Input (token0 paid):\", uint256(int256(exactIn_paid)));\n        console.log(\"Output (token1 received):\", uint256(int256(exactIn_received)));\n\n        // === Pool 2: ExactOut for SAME output ===\n        PoolBalanceUpdate result2 = router.swap({\n            poolKey: pool2,\n            params: createSwapParameters({\n                _isToken1: true,\n                _amount: -exactIn_received,  // negative = exactOut this amount\n                _sqrtRatioLimit: SqrtRatio.wrap(0),\n                _skipAhead: 0\n            }),\n            calculatedAmountThreshold: type(int256).min,\n            recipient: address(this)\n        });\n\n        int128 exactOut_paid = result2.delta0();      // positive = user pays\n        int128 exactOut_received = -result2.delta1(); // negative flipped = user receives\n\n        console.log(\"\");\n        console.log(\"=== Pool 2: ExactOut (same output target) ===\");\n        console.log(\"Input (tokenA paid):\", uint256(int256(exactOut_paid)));\n        console.log(\"Output (tokenB received):\", uint256(int256(exactOut_received)));\n\n        // === Compare ===\n        console.log(\"\");\n        console.log(\"=== Comparison ===\");\n\n        uint256 inCost = uint256(int256(exactIn_paid));\n        uint256 outCost = uint256(int256(exactOut_paid));\n\n        console.log(\"Same output received:\", uint256(int256(exactIn_received)) == uint256(int256(exactOut_received)));\n        console.log(\"ExactIn cost:\", inCost);\n        console.log(\"ExactOut cost:\", outCost);\n\n        if (inCost > outCost) {\n            console.log(\"RESULT: ExactIn pays MORE by\", inCost - outCost);\n        } else if (outCost > inCost) {\n            console.log(\"RESULT: ExactOut pays MORE by\", outCost - inCost);\n        } else {\n            console.log(\"RESULT: Equal (no asymmetry)\");\n        }\n\n        // The vulnerability: costs should be equal but aren't\n        assertTrue(inCost != outCost, \"Fee asymmetry exists\");\n    }\n}\n\n```",
