          {
            "evidence_id": "e_02fe82175a0c_0007",
            "text": "The condition treats any two matched amounts with disjoint 1-bits as zero-cost trades. This affects ALL limit order matching (both partial and full matches), while fill orders remain unaffected as they use different validation logic."
          }
        ]
      },
      {
        "statement_id": "rc_bitwise_and_instead_of_or",
        "role": "root_cause",
        "evidence": [
          {
            "evidence_id": "e_02fe82175a0c_0005",
            "text": "The intent is to prevent zero-cost trades where one side receives tokens without sending any. However, the bitwise `&` operator causes false positives when legitimate trade amounts have no overlapping bits (e.g., 256 & 255 = 0)."
          }
        ]
      }
