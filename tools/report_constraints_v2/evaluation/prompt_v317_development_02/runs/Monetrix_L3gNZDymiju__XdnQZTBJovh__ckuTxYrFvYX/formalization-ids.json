      "scope": "sUSDM ERC-4626 vault wrapping 6-decimal USDM; decimals() reports 6 while internal share accounting and _decimalsOffset()=6 imply 12-decimal shares; integrators using decimals() to scale balanceOf() overestimate holdings by 10^6",
      "modality": "asserted",
      "impact_ids": [
        "impact_decimals_6_instead_of_12"
      ],
      "properties": {
        "preconditions": {
          "text": "USDM, the underlying asset of the sUSDM vault, has 6 decimals.; sUSDM overrides _decimalsOffset() to return 6.; sUSDM overrides decimals() to return a hardcoded 6.",
          "expression": {
            "op": "and",
            "args": [
              {
                "op": "eq",
                "args": [
                  {
                    "var": "underlying_decimals"
                  },
