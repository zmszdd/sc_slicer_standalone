{
  "schema_version": "stage2-newsc-binding/1",
  "case_key": "Ekubo_3FTodhsvBkM__9MpUh5dZn3f__nFbsAHPP4jP",
  "binding_provenance": "hand-authored prototype binding (stage-3 side binding work, disclosed); zero model calls",
  "state": {
    "inherits": "TokenWrapperPoC",
    "declarations": []
  },
  "setup": [
    "address tokenOwner = makeAddr(\"abcd\");",
    "address spender = makeAddr(\"ef01\");",
    "address recipient = address(0x1234);",
    "uint128 amount = 100 ether;",
    "underlying.transfer(tokenOwner, amount);",
    "vm.startPrank(tokenOwner);",
    "underlying.approve(address(periphery), amount);",
    "periphery.wrap(wrapper, amount);",
    "wrapper.approve(spender, amount);",
    "vm.stopPrank();"
  ],
  "attack": [
    "vm.startPrank(spender);",
    "vm.recordLogs();",
    "bool success = wrapper.transferFrom(tokenOwner, recipient, amount);",
    "vm.stopPrank();"
  ],
  "post": [
    "Vm.Log[] memory logs = vm.getRecordedLogs();",
    "bool foundTransferEvent = false;",
    "address eventFrom;",
    "for (uint i = 0; i < logs.length; i++) {",
    "    if (logs[i].topics.length == 3 && logs[i].topics[0] == keccak256(\"Transfer(address,address,uint256)\")) {",
    "        foundTransferEvent = true;",
    "        eventFrom = address(uint160(uint256(logs[i].topics[1])));",
    "        break;",
    "    }",
    "}"
  ],
  "binding_sanity": [
    "assertTrue(success, \"STAGE2_BINDING_ERROR: transferFrom call failed\");",
    "assertTrue(foundTransferEvent, \"STAGE2_BINDING_ERROR: Transfer event not found in recorded logs\");"
  ],
  "symbols": {
    "from_address": {
      "phase": "pre", "type": "address", "expr": "tokenOwner", "unit": null,
      "binding_description": "the from argument of TokenWrapper.transferFrom in the PoC scenario (token owner)"
    },
    "spender_address": {
      "phase": "pre", "type": "address", "expr": "spender", "unit": null,
      "binding_description": "msg.sender at the transferFrom call in the PoC scenario (the approved spender)"
    },
    "transferfrom_invoked": {
      "phase": "post", "type": "bool", "expr": "success", "unit": null,
      "binding_description": "TokenWrapper.transferFrom executed and returned true"
    },
    "event_emitted": {
      "phase": "post", "type": "bool", "expr": "foundTransferEvent", "unit": null,
      "binding_description": "a Transfer(address,address,uint256) event is present in the recorded logs"
    },
    "event_source_address": {
      "phase": "post", "type": "address", "expr": "eventFrom", "unit": null,
      "binding_description": "topics[1] (indexed from) of the emitted Transfer event"
    }
  }
}
