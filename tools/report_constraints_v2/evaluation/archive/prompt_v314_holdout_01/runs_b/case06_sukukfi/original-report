   \n        // Verify Alice STILL has claimable balance after unregistration\n        uint256 userClaimableAfterUnreg = mainVault.claimableDepositRequest(0, user);\n        console.log(\"  AFTER UNREGISTRATION:\");\n        console.log(\"   Vault status: UNREGISTERED \");\n        console.log(\"  !!!BUG CONFIRMED!!! claimableDepositAssets[user]:\", userClaimableAfterUnreg / 1e18, \"tokens\"); //Bug confirmed\n        console.log(\"   1000 tokens orphaned in unregistered vault!\");\n        \n        // ═══════════════════════════════════════════════════════════════\n        // STEP 8: Verify user CAN Still Claim (But Shouldn't Be Possible)\n        // ═══════════════════════════════════════════════════════════════\n        \n        console.log(\"STEP 8: user Attempts to Claim\");\n        \n        uint256 aliceBalanceBefore = mainShareToken.balanceOf(user);\n        \n        vm.prank(user);\n        mainVault.deposit(firstDeposit, user, user);\n        \n        uint256 aliceBalanceAfter = mainShareToken.balanceOf(user);\n        \n        console.log(\"  user user balance before:\", aliceBalanceBefore / 1e18);\n        console.log(\"  user user balance after:\", aliceBalanceAfter / 1e18);\n        console.log(\"  user user Claim succeeded (deposit() still works)\");\n        console.log(\"  user BUT vault should NOT have been unregistered!usern\");\n    }\n```",
