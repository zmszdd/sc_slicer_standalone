    uint256 underlyingYield_ = (balance_ - pool.lastUnderlyingBalance).to18(decimals_);\n            uint256 yield_ = underlyingYield_ * pool.tokenPrice;\n\n            pool.lastUnderlyingBalance = balance_;\n            yields_[i] = yield_;\n            totalYield_ += yield_;\n        }\n\n        if (totalYield_ == 0) {\n            undistributedRewards += rewards_;\n            return;\n        }\n\n        for (uint256 i = 0; i < length_; i++) {\n            if (yields_[i] == 0) continue;\n            distributedRewards[rewardPoolIndex_][depositPoolAddresses[rewardPoolIndex_][i]] += \n                (yields_[i] * rewards_) / totalYield_;\n        }\n    }\n}\n\n// Main test contract\ncontract FixedUnderflowTest is Test {\n    VulnerableDistributor public distributor;\n    MockRewardPool public rewardPool;\n    MockYieldToken public aaveToken;\n\n    address public depositPool1 = makeAddr(\"depositPool1\");\n    uint256 public constant REWARD_POOL_INDEX = 0;\n\n    function setUp() public {\n        // Set a proper timestamp first to avoid underflow\n        vm.warp(10000); // Set timestamp to 10000 seconds\n\n        rewardPool = new MockRewardPool();\n        distributor = new VulnerableDistributor(address(rewardPool));\n        aaveToken = new MockYieldToken(\"aETH\");\n\n        // Set initial balance\n        aaveToken.setBalance(address(distributor), 1000e18);\n\n        // Add deposit pool\n        distributor.addDepositPool(REWARD_POOL_INDEX, depositPool1, address(aaveToken), address(aaveToken));\n\n        // Now we can safely subtract from block.timestamp\n        distributor.setTimestamp(REWARD_POOL_INDEX, uint128(block.timestamp - 7200));\n\n        console.log(\"Setup complete - Initial balance: 1000 tokens\");\n        console.log(\"Current timestamp: %s\", block.timestamp);\n    }\n\n    /**\n     * @notice Test demonstrating underflow vulnerability\n     */\n    function testUnderflowVulnerability() public {\n        console.log(\"=== UNDERFLOW VULNERABILITY TEST ===\");\n\n        // Set lastUnderlyingBalance to current balance\n        distributor.setLastUnderlyingBalance(REWARD_POOL_INDEX, depositPool1, 1000e18);\n        console.log(\"Set lastUnderlyingBalance: 1000 tokens\");\n\n        // Simulate balance decrease (slashing, fees, etc.)\n        aaveToken.enableDecrease(100e18); // 100 token decrease\n\n        uint256 newBalance = aaveToken.balanceOf(address(distributor));\n        console.log(\"Balance after decrease: %s tokens\", newBalance / 1e18);\n        console.log(\"This will cause underflow: %s - %s\", newBalance / 1e18, 1000);\n\n        // This should revert due to underflow\n        vm.expectRevert();\n        distributor.distributeRewards(REWARD_POOL_INDEX);\n\n        console.log(\" VULNERABILITY CONFIRMED: distributeRewards reverts due to underflow\");\n        console.log(\"   Protocol reward distribution is completely broken\");\n    }\n\n    /**\n     * @notice Test showing DOS impact\n     */\n    function testDOSImpact() public {\n        console.log(\"=== DOS IMPACT TEST ===\");\n\n        // Setup underflow condition\n        distributor.setLastUnderlyingBalance(REWARD_POOL_INDEX, depositPool1, 1000e18);\n        aaveToken.enableDecrease(50e18);\n\n        console.log(\"Underflow condition established\");\n        console.log(\"Testing multiple attempts to distribute rewards...\");\n\n        // Multiple attempts should all fail\n        for (uint i = 0; i < 3; i++) {\n            vm.expectRevert();\n            distributor.distributeRewards(REWARD_POOL_INDEX);\n            console.log(\"Attempt %s: FAILED (as expected)\", i + 1);\n        }\n\n        console.log(\" DOS CONFIRMED: All reward distribution attempts fail\");\n        console.log(\"   Protocol remains broken until manual intervention\");\n    }\n\n    /**\n     * @notice Test showing successful normal operation\n     */\n    function testNormalOperation() public {\n        console.log(\"=== NORMAL OPERATION TEST ==