l(uint256 rewardPoolIndex_) external view {\n        require(exists[rewardPoolIndex_], \"Pool doesn't exist\");\n    }\n\n    function isRewardPoolPublic(uint256 rewardPoolIndex_) external view returns (bool) {\n        return isPublic[rewardPoolIndex_];\n    }\n\n    function getPeriodRewards(uint256, uint128, uint128) external pure returns (uint256) {\n        return 1000e18;\n    }\n}\n\n// Decimal conversion library\nlibrary DecimalUtils {\n    function to18(uint256 value, uint8 fromDecimals) internal pure returns (uint256) {\n        if (fromDecimals == 18) return value;\n        if (fromDecimals < 18) {\n            return value * (10 ** (18 - fromDecimals));\n        }\n        return value / (10 ** (fromDecimals - 18));\n    }\n}\n\n// Vulnerable Distributor contract\ncontract VulnerableDistributor {\n    using DecimalUtils for uint256;\n\n    enum Strategy { NONE, AAVE }\n\n    struct DepositPool {\n        address token;\n        uint256 tokenPrice;\n        uint256 lastUnderlyingBalance;\n        Strategy strategy;\n        address aToken;\n        bool isExist;\n    }\n\n    address public rewardPool;\n    uint256 public minRewardsDistributePeriod = 3600;\n    uint256 public undistributedRewards = 0;\n\n    mapping(uint256 => address[]) public depositPoolAddresses;\n    mapping(uint256 => mapping(address => DepositPool)) public depositPools;\n    mapping(uint256 => uint128) public rewardPoolLastCalculatedTimestamp;\n    mapping(uint256 => mapping(address => uint256)) public distributedRewards;\n\n    constructor(address _rewardPool) {\n        rewardPool = _rewardPool;\n    }\n\n    function addDepositPool(\n        uint256 rewardPoolIndex_,\n        address depositPoolAddress_,\n        address token_,\n        address aToken_\n    ) external {\n        depositPoolAddresses[rewardPoolIndex_].push(depositPoolAddress_);\n        depositPools[rewardPoolIndex_][depositPoolAddress_] = DepositPool({\n            token: token_,\n            tokenPrice: 2500e18