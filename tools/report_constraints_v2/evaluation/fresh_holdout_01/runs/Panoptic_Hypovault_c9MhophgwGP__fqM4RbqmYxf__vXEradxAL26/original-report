l user shares:\", totalUserShares);\n        console2.log(\"\");\n        console2.log(\"Bootstrap shares:\");\n        console2.log(\"  Count:\", BOOTSTRAP_SHARES);\n        console2.log(\"  Ownership bps:\", (BOOTSTRAP_SHARES * 10000) / totalSupply);\n        console2.log(\"  Total supply:\", totalSupply);\n\n        // Simulate vault earning 30% profit\n        uint256 profit = totalUserDeposits * 30 / 100; // 1350 ETH profit\n        uint256 newNAV = totalUserDeposits + profit; // 5850 ETH total\n\n        // Add real tokens to vault to simulate the profit\n        token.mint(address(vault), profit);\n\n        console2.log(\"\\n=== AFTER 30% PROFIT ===\");\n        console2.log(\"  Original total investment: %s ETH\", totalUserDeposits / 1e18);\n        console2.log(\"  Profit earned by vault: %s ETH\", profit / 1e18);\n        console2.log(\"  New total NAV: %s ETH\", newNAV / 1e18);\n\n        // Calculate what users SHOULD get without bootstrap shares\n        uint256 aliceExpected = aliceDeposit + (profit * aliceDeposit) / totalUserDeposits;\n        uint256 bobExpected = bobDeposit + (profit * bobDeposit) / totalUserDeposits;\n        uint256 charlieExpected = charlieDeposit + (profit * charlieDeposit) / totalUserDeposits;\n\n        console2.log(\"\\nExpected returns WITHOUT bootstrap shares:\");\n        console2.log(\"  Alice should get: %s ETH\", aliceExpected / 1e18);\n        console2.log(\"  Bob should get: %s ETH\", bobExpected / 1e18);\n        console2.log(\"  Charlie should get: %s ETH\", charlieExpected / 1e18);\n\n        // All users withdraw their shares\n        vm.prank(Alice);\n        vault.requestWithdrawal(uint128(aliceShares));\n        vm.prank(Bob);\n        vault.requestWithdrawal(uint128(bobShares));\n        vm.prank(Charlie);\n        vault.requestWithdrawal(uint128(charlieShares));\n\n        vm.startPrank(Manager);\n        mockAccountant.setNav(newNAV);\n\n        // Calculate actual withdrawal amounts (with bootstrap shares dilution)\n        (uint128 currentEpochAssetsDeposited,,) = vault.depositEpochState(vault.depositEpoch());\n        uint256 currentTotalAssets = newNAV + 1 - currentEpochAssetsDeposited - vault.reservedWithdrawalAssets();\n\n        uint256 aliceAssetsToReceive = (aliceShares * currentTotalAssets) / totalSupply;\n        uint256 bobAssetsToReceive = (bobShares * currentTotalAssets) / totalSupply;\n        uint256 charlieAssetsToReceive = (charlieShares * currentTotalAssets) / totalSupply;\n\n        vault.fulfillWithdrawals(\n            totalUserShares, aliceAssetsToReceive + bobAssetsToReceive + charlieAssetsToReceive + 100 ether, \"\"\n        );\n\n        // Execute withdrawals\n        uint256 aliceBalanceBefore = token.balanceOf(Alice);\n        uint256 bobBalanceBefore = token.balanceOf(Bob);\n        uint256 charlieBalanceBefore = token.balanceOf(Charlie);\n\n        vault.executeWithdrawal(Alice, 0);\n        vault.executeWithdrawal(Bob, 0);\n        vault.executeWithdrawal(Charlie, 0);\n        vm.stopPrank();\n\n        uint256 aliceActual = token.balanceOf(Alice) - aliceBalanceBefore;\n        uint256 bobActual = token.balanceOf(Bob) - bobBalanceBefore;\n        uint256 charlieActual = token.balanceOf(Charlie) - charlieBalanceBefore;\n        uint256 totalActualReceived = aliceActual + bobActual + charlieActual;\n\n        console2.log(\"\\nActual returns WITH bootstrap shares:\");\n        console2.log(\"  Alice actually got: %s ETH\", aliceActual / 1e18);\n        console2.log(\"  Bob actually got: %s ETH\", bobActual / 1e18);\n        console2.log(\"  Charlie actually got: %s ETH\", charlieActual / 1e18);\n        console2.log(\"  Total received by users: %s ETH\", totalActualReceived / 1e18);\n\n        // Calculate dilution for each user\n        uint256 aliceDilution = aliceExpected - aliceActual;\n        uint256 bobDilution = bobExpected - bobActual;\n        uint256 charlieDilution = charlieExpected - charlieActual;\n        uint256 totalDilution = aliceDilution + bobDilution + charlieDilution;\n\n        console2.log(\"\\n=== DILUTION ANALYSIS ===\");\n        console2.log(\"Individual losses to bootstrap shares:\");\n        console2.log(\"  Alice lost: %s ETH\", aliceDilution / 1e18);\n        console2.log(\"  Bob lost: %s ETH\", bobDilution / 1e18);\n        console2.log(\"  Charlie lost: %s ETH\", charlieDilution / 1e18);\n        console2.log(\"  Total lost by all users: %s ETH\", totalDilution / 1e18);\n    }\n```",
