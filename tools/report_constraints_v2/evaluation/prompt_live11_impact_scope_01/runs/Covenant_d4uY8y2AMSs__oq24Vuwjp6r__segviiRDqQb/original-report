  "body": "## Finding description and impact\n\nLatentSwapLEX exposes `setDefaultNoCapLimit(address token, uint8)` documented as: “if defaultMintRedeemNoCap == 0, new markets will use 1 baseToken as the MintRedeemNoCap as the default” and “for markets with this quote token”. At init, the code reads `tokenNoCapLimit[marketParams.baseToken]` and assigns that to the market’s `noCapLimit`. This creates a policy confusion: governance expecting to configure the default mint/redeem cap for “markets with this quote token” by calling `setDefaultNoCapLimit(quoteToken, x)` will have no effect. Only overrides set for the baseToken address are used. As a result, markets instantiated under a given quote do not inherit the intended cap setting, potentially leaving large markets unbounded or overly restricted depending on expectation.\n\n\nMisconfiguration risk: quote-level policy changes are silently ignored. Operators can believe caps are set for an entire quote currency class when in fact they are not, leading to unintended liquidity growth or unnecessary constraints.\n\n## Recommended mitigation steps\nClarify and align semantics: if the intention is quote-scoped policy, read `tokenNoCapLimit[marketParams.quoteToken]` at init. If base-scoped is intended, rename the function/docs to reflect base token scope and adjust comments accordingly.",
  "proof_of_concept": "# test/poc/NoCapLimitOverrideBug.t.sol\n```sol\n\n// SPDX-License-Identifier: GPL-3.0-or-later\npragma solidity ^0.8.30;\n\nimport \"forge-std/Test.sol\";\nimport {Covenant} from \"../../src/Covenant.sol\";\nimport {LatentSwapLEX} from \"../../src/lex/latentswap/LatentSwapLEX.sol\";\nimport {ILatentSwapLEX, LexConfig} from \"../../src/lex/latentswap/interfaces/ILatentSwapLEX.sol\";\nimport {MockOracle} from \"../mocks/MockOracle.sol\";\nimport {MockERC20} from \"../mocks/MockERC20.sol\";\nimport {FixedPoint} from \"../../src/lex/latentswap/libraries/FixedPoint.sol\";\nimport {LatentSwapLib} from \"../../src/periphery/libraries/LatentSwapLib.sol\";\nimport {MarketId, MarketParams} from \"../../src/interfaces/ICovenant.sol\";\n\ncontract NoCapLimitOverrideBugTest is Test {\n    uint160 internal constant P_MAX = uint160((1095445 * FixedPoint.Q96) / 1000000);\n    uint160 internal constant P_MIN = uint160(FixedPoint.Q192 / P_MAX);\n    uint32 internal constant DURATION = 30 * 24 * 60 * 60;\n    uint8 internal constant SWAP_FEE = 0;\n    int64 internal constant LN_RATE_BIAS = 5012540000000000; // WAD\n    uint160 private P_LIM_H = LatentSwapLib.getSqrtPriceFromLTVX96(P_MIN, P_MAX, 9500);\n    uint160 private P_LIM_MAX = LatentSwapLib.getSqrtPriceFromLTVX96(P_MIN, P_MAX, 9999);\n\n    Covenant public covenant;\n    LatentSwapLEX public lex;\n    address private _mockOracle;\n    address private _mockBaseAsset;\n    address private _mockQuoteAsset;\n\n    function setUp() public {\n        _mockOracle = address(new MockOracle(address(this)));\n        _mockBaseAsset = address(new MockERC20(address(this), \"MockBaseAsset\", \"MBA\", 18));\n        _mockQuoteAsset = address(new MockERC20(address(this), \"MockQaseAsset\", \"MQA\", 18));\n        covenant = new Covenant(address(this));\n        lex = new LatentSwapLEX(address(this), address(covenant), P_MAX, P_MIN, P_LIM_H, P_LIM_MAX, LN_RATE_BIAS, DURATION, SWAP_FEE);\n        covenant.setEnabledLEX(address(lex), true);\n        covenant.setEnabledCurator(_mockOracle, true);\n    }\n\n    function test_poc_NoCapLimitOverrideAppliedToWrongToken() public {\n        // Intention: override noCapLimit for quote token to 255, expecting markets with this quote to have no cap\n        lex.setDefaultNoCapLimit(_mockQuoteAsset, 255);\n\n        // Create market using that quote\n        MarketParams memory marketParams = MarketParams({\n            baseToken: _mockBaseAsset,\n            quoteToken: _mockQuoteAsset,\n            curator: _mockOracle,\n            lex: address(lex)\n        });\n        MarketId marketId = covenant.createMarket(marketParams, hex\"\");\n\n        // Read config\n        LexConfig memory cfg = lex.getLexConfig(marketId);\n\n        // Bug: override stored for quote token is not applied; code uses baseToken as key\n        // Expect cfg.noCapLimit != 255 (likely 60 for 18 decimals)\n        assertTrue(cfg.noCapLimit != 255, \"override incorrectly applied to quote token (should not be 255)\");\n\n        // Now apply override for base token and create again to show override actually affects config\n        LatentSwapLEX lex2 = new LatentSwapLEX(address(this), address(covenant), P_MAX, P_MIN, P_LIM_H, P_LIM_MAX, LN_RATE_BIAS, DURATION, SWAP_FEE);\n        covenant.setEnabledLEX(address(lex2), true);\n        lex2.setDefaultNoCapLimit(_mockBaseAsset, 255);\n\n        MarketParams memory marketParams2 = MarketParams({\n            baseToken: _mockBaseAsset,\n            quoteToken: _mockQuoteAsset,\n            curator: _mockOracle,\n            lex: address(lex2)\n        });\n        MarketId marketId2 = covenant.createMarket(marketParams2, hex\"\");\n        LexConfig memory cfg2 = lex2.getLexConfig(marketId2);\n        assertEq(cfg2.noCapLimit, 255, \"override only applies when set for base token\");\n    }\n}\n```\n\n\n# Run\n```bash\n\nforge test --match-path test/poc/NoCapLimitOverrideBug.t.sol -vvv\n[⠊] Compiling...\nNo files changed, compilation skipped\n\nRan 1 test for test/poc/NoCapLimitOverrideBug.t.sol:NoCapLimitOverrideBugTest\n[PASS] test_poc_NoCapLimitOverrideAppliedToWrongToken() (gas: 7824083)\nSuite result: ok. 1 passed; 0 failed; 0 skipped; finished in 4.66ms (1.90ms CPU time)\n\nRan 1 test suite in 16.05ms (4.66ms CPU time): 1 tests passed, 0 failed, 0 skipped (1 total tests)\n```",
