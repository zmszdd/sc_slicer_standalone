turn true;\n        assembly {\n            // . . . Rest of the code . . .\n            if iszero(zeroFound) {\n                // . . . Rest of the code . . .\n                if and(aNeg, bNeg) {\n-                    if eq(aExp, bExp) {\n+                    if and(eq(aExp, bExp), iszero(eq(aMan, bMan))) {\n                        retVal := gt(aMan, bMan)\n                    }\n \n+                    if and(eq(aExp, bExp), eq(aMan, bMan)) {\n+                        retVal := true\n+                    }\n \n                    if gt(aExp, bExp) {\n                        retVal := true\n                    }\n                }\n                // . . . Rest of the code . . .\n            }\n        }\n    }\n```",
