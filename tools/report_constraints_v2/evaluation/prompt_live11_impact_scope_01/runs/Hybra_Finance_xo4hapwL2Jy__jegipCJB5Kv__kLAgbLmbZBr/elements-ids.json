        "e_a8de1e73195a_0014"
      ]
    },
    {
      "id": "rc_current_weights_not_snapshot",
      "kind": "root_cause",
      "text": "GaugeManager._updateForAfterDistribution() uses current voting weights instead of epoch-snapshot weights when calculating reward distributions, and no weightsPerEpoch snapshot mechanism exists.",
      "modality": "asserted",
      "entity_ids": [
        "gauge_manager"
      ],
      "evidence_ids": [
        "e_a8de1e73195a_0003",
        "e_a8de1e73195a_0004"
      ]
    },
    {
      "id": "i_zero_rewards_modified_weights",
      "kind": "impact",
      "text": "Gauges with modified weights between update_period() and distribute() receive zero rewards despite having weight during the reward period (complete loss of epoch rewards).",
      "modality": "asserted",
      "entity_ids": [
        "gauge_a",
        "gauge_manager"
      ],
      "evidence_ids": [
        "e_a8de1e73195a_0020"
      ]
    },
    {
      "id": "i_permanent_fund_lockup",
      "kind": "impact",
      "text": "Rewards become permanently stuck in the GaugeManager contract with no recovery mechanism.",
      "modality": "asserted",
      "entity_ids": [
        "gauge_manager"
      ],
      "evidence_ids": [
        "e_a8de1e73195a_0021"
      ]
    },
    {
      "id": "i_insolvency_accumulation",
      "kind": "impact",
      "text": "Over multiple epochs, substantial emission tokens can accumulate as stuck funds, creating protocol insolvency risk.",
      "modality": "potential",
      "entity_ids": [
        "gauge_manager"
      ],
      "evidence_ids": [
        "e_a8de1e73195a_0022"
      ]
    },
    {
      "id": "i_reward_theft_disproportionate",
      "kind": "impact",
      "text": "An attacker front-running distribute() and voting heavily for Gauge B causes Gauge B to receive disproportionate rewards meant for other gauges.",
      "modality": "potential",
      "entity_ids": [
        "attacker",
        "gauge_b"
      ],
      "evidence_ids": [
        "e_a8de1e73195a_0027",
        "e_a8de1e73195a_0028"
      ]
    },
    {
      "id": "si_proportional_to_snapshots",
      "kind": "security_intent",
      "text": "Emissions allocated to gauges must be strictly proportional to their effective weight snapshots.",
