        "gauge_manager"
      ],
      "evidence_ids": [
        "e_a8de1e73195a_0030"
      ]
    },
    {
      "id": "si_epoch_boundary_consistency",
      "kind": "security_intent",
      "text": "Weight snapshots take effect strictly at epoch boundaries; updates in one epoch must not retroactively affect settled allocations.",
      "modality": "asserted",
      "entity_ids": [
        "gauge_manager"
      ],
      "evidence_ids": [
        "e_a8de1e73195a_0031"
      ]
    },
    {
      "id": "assumption_no_snapshot_mechanism",
      "kind": "assumption",
      "text": "The codebase lacks any weightsPerEpoch mapping or snapshot mechanism, so current weights are used at distribution time.",
      "modality": "asserted",
      "entity_ids": [
        "gauge_manager"
      ],
      "evidence_ids": [
        "e_a8de1e73195a_0004"
      ]
