MITS_PER_SIDE + 2);\n        price++;\n        setupOrder(mySide, users[0], amountOrder, ((price) * 1 ether));\n        assertEq(clob.getNumBids(),  MAX_NUM_LIMITS_PER_SIDE + 3);\n        price++;\n        setupOrder(mySide, users[0], amountOrder, ((price) * 1 ether));\n        assertEq(clob.getNumBids(),  MAX_NUM_LIMITS_PER_SIDE + 4);\n    }\n}",
