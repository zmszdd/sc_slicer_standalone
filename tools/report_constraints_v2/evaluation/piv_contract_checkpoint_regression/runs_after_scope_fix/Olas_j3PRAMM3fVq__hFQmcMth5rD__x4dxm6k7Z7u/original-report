  "body": "The `_performSwap` function for V3 (Slipstream) swaps in `BuyBackBurnerBalancer.sol` implements swaps with no effective slippage protection:\n\n```solidity\nfunction _performSwap(address secondToken, uint256 secondTokenAmount, int24 tickSpacing)\n    internal\n    virtual\n    override\n    returns (uint256 olasAmount)\n{\n    IERC20(secondToken).approve(swapRouter, secondTokenAmount);\n\n    ISwapRouter.ExactInputSingleParams memory params = ISwapRouter.ExactInputSingleParams({\n        tokenIn: secondToken,\n        tokenOut: olas,\n        tickSpacing: tickSpacing,\n        recipient: address(this),\n        deadline: block.timestamp,\n        amountIn: secondTokenAmount,\n        amountOutMinimum: 1,        // ❌ BUG: Accepts 1 wei output!\n        sqrtPriceLimitX96: 0        // ❌ BUG: No price limit!\n    });\n\n    olasAmount = ISwapRouter(swapRouter).exactInputSingle(params);\n}\n```\n\n**Key Issues:**\n1. `amountOutMinimum = 1` - Swap succeeds even if 99.99999999% of value is lost\n2. `sqrtPriceLimitX96 = 0` - No price boundary for the swap\n3. No post-swap validation (unlike V2 implementation)\n\n#### Comparison: V2 vs V3 Protection\n\n| Protection | V2 Swaps | V3 Swaps |\n|------------|----------|----------|\n| Pre-swap oracle check | ✅ `validatePrice()` | ⚠️ TWAP only |\n| In-swap min output | ❌ `limit=0` | ❌ `min=1` |\n| Post-swap validation | ✅ Price bounds check | ❌ NONE |\n\nThe V2 implementation compensates for `limit=0` with pre/post checks. V3 has none.\n\n#### Attack Scenario\n\n1. Attacker monitors mempool for `buyBack()` transactions targeting V3 pools\n2. When buyback tx is detected, attacker front-runs with large buy → inflates price\n3. Victim's buyback executes at inflated price, receives minimal OLAS\n4. Attacker back-runs by selling → extracts profit\n5. Protocol receives fraction of fair OLAS value\n\n#### Impact\n\n- **Direct financial loss**: Protocol receives significantly less OLAS than fair value\n- **Repeatable**: Every V3 buyback is exploitable\n- **Cumulative damage**: Undermines entire buyback-and-burn mechanism\n- **No user error**: Bug is in core implementation\n\n### Severity Justification\n\n| Criteria | Assessment |\n|----------|------------|\n| **Direct fund loss** | ✅ Yes - reduced OLAS acquisition |\n| **Attack complexity** | Low - standard MEV technique |\n| **External conditions** | Requires public mempool (mitigable via Flashbots) |\n| **Partial mitigation** | V2 swaps are protected; only V3 affected |\n\nRecommended Mitigation Steps\n\n### Option 1: Use Oracle-Based Minimum Output (Recommended)\n\n```solidity\nfunction _performSwap(address secondToken, uint256 secondTokenAmount, int24 tickSpacing)\n    internal\n    virtual\n    override\n    returns (uint256 olasAmount)\n{\n    // Get expected output from oracle\n    uint256 expectedOut = getExpectedOutput(secondToken, secondTokenAmount);\n    uint256 minOut = expectedOut * (100 - maxSlippage) / 100;\n    \n    IERC20(secondToken).approve(swapRouter, secondTokenAmount);\n\n    ISwapRouter.ExactInputSingleParams memory params = ISwapRouter.ExactInputSingleParams({\n        tokenIn: secondToken,\n        tokenOut: olas,\n        tickSpacing: tickSpacing,\n        recipient: address(this),\n        deadline: block.timestamp,\n        amountIn: secondTokenAmount,\n        amountOutMinimum: minOut,           // ✅ FIX: Proper slippage\n        sqrtPriceLimitX96: getSqrtPriceLimit() // ✅ FIX: Price boundary\n    });\n\n    olasAmount = ISwapRouter(swapRouter).exactInputSingle(params);\n    \n    // Post-swap validation (like V2)\n    require(olasAmount >= minOut, \"Slippage exceeded\");\n}\n```\n\n### Option 2: Add Post-Swap Validation (Simpler)\n\n```solidity\nfunction _buyOLAS(address secondToken, uint256 secondTokenAmount, int24 feeTierOrTickSpacing)\n    internal\n    virtual\n    returns (uint256 olasAmount)\n{\n    // ... existing code ...\n    \n    // Get pre-swap price from oracle/pool\n    uint256 expectedPrice = getLiquidityPrice(pool);\n    \n    olasAmount = _performSwap(secondToken, secondTokenAmount, feeTierOrTickSpacing);\n    \n    // ✅ ADD: Post-swap validation\n    uint256 expectedOutput = secondTokenAmount * 1e18 / expectedPrice;\n    uint256 minAcceptable = expectedOutput * (100 - maxSlippage) / 100;\n    require(olasAmount >= minAcceptable, \"V3 slippage limit breached\");\n}\n```",
  "proof_of_concept": "### Test File: `test/SlippageExploit.t.sol`\n\n```solidity\n// SPDX-License-Identifier: MIT\npragma solidity ^0.8.28;\n\nimport \"forge-std/Test.sol\";\n\ncontract MaliciousRouter {\n    uint256 public sandwichExtraction = 0;\n    uint256 public constant EXTRACTION_RATE = 50; // 50% extraction\n    \n    function exactInputSingle(ExactInputSingleParams calldata params) external returns (uint256 amountOut) {\n        uint256 fairValue = params.amountIn;\n        uint256 extracted = (fairValue * EXTRACTION_RATE) / 100;\n        amountOut = fairValue - extracted;\n        \n        // Contract accepts this because amountOutMinimum = 1!\n        require(amountOut >= params.amountOutMinimum, \"Slippage exceeded\");\n        \n        sandwichExtraction += extracted;\n        return amountOut;\n    }\n    \n    struct ExactInputSingleParams {\n        address tokenIn;\n        address tokenOut;\n        int24 tickSpacing;\n        address recipient;\n        uint256 deadline;\n        uint256 amountIn;\n        uint256 amountOutMinimum;\n        uint160 sqrtPriceLimitX96;\n    }\n}\n\ncontract VulnerableSwapper {\n    address public swapRouter;\n    \n    constructor(address _router) { swapRouter = _router; }\n    \n    // Mirrors BuyBackBurnerBalancer._performSwap (lines 132-153)\n    function performSwapV3(uint256 amount) external returns (uint256) {\n        MaliciousRouter.ExactInputSingleParams memory params = MaliciousRouter.ExactInputSingleParams({\n            tokenIn: address(0),\n            tokenOut: address(0),\n            tickSpacing: 100,\n            recipient: address(this),\n            deadline: block.timestamp,\n            amountIn: amount,\n            amountOutMinimum: 1,     //  VULNERABILITY\n            sqrtPriceLimitX96: 0     //  VULNERABILITY\n        });\n        return MaliciousRouter(swapRouter).exactInputSingle(params);\n    }\n}\n\ncontract SlippageExploitTest is Test {\n    function test_MEVExtractionViaSandwich() public {\n        MaliciousRouter router = new MaliciousRouter();\n        VulnerableSwapper swapper = new VulnerableSwapper(address(router));\n        \n        uint256 swapAmount = 100e18;\n        uint256 received = swapper.performSwapV3(swapAmount);\n        uint256 extracted = router.sandwichExtraction();\n        \n        // PROOF: 50% of value extracted\n        assertEq(extracted, 50e18);\n        assertEq(received, 50e18);\n    }\n}\n```\n\n### Run Command\n\n```bash\ncd autonolas-tokenomics\nforge test --match-test test_MEVExtractionViaSandwich -vvv\n```",
