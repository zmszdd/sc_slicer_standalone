      "id": "zero_split_leg",
      "kind": "root_cause",
      "text": "The computed remainingAmount can be zero when a user exits their entire position (or the fee rounds to zero), and VotingEscrow.multiSplit enforces every split weight to be strictly positive, so the contract forwards [remainingAmount, userAmount, feeAmount] with a zero element and reverts with \"ZW\".",
      "modality": "asserted",
      "entity_ids": [
        "governance_hybr",
        "voting_escrow"
      ],
      "evidence_ids": [
        "e_9ba997156c6e_0005",
        "e_9ba997156c6e_0008"
      ]
    },
    {
      "id": "withdrawal_reverts",
      "kind": "impact",
      "text": "The revert propagates and the withdrawal fails, leaving the user unable to exit their position.",
      "modality": "asserted",
      "entity_ids": [
        "user",
        "governance_hybr",
        "voting_escrow"
      ],
      "evidence_ids": [
        "e_9ba997156c6e_0009",
        "e_9ba997156c6e_0001"
      ]
    },
    {
      "id": "legitimate_users_cannot_withdraw",
      "kind": "impact",
      "text": "Legitimate users cannot withdraw their locked HYBR when their remainder or fee share is zero, causing a self-DoS on exits.",
      "modality": "asserted",
      "entity_ids": [
        "user",
        "locked_hybr"
      ],
      "evidence_ids": [
        "e_9ba997156c6e_0011",
        "e_9ba997156c6e_0003"
      ]
    },
    {
      "id": "exit_should_succeed",
      "kind": "security_intent",
      "text": "A legitimate gHYBR holder performing a full exit via GovernanceHYBR.withdraw should be able to withdraw their locked HYBR rather than have the call revert.",
