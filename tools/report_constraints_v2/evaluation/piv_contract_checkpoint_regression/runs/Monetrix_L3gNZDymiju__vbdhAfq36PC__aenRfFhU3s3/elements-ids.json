      "entity_ids": [
        "accountant"
      ],
      "evidence_ids": [
        "e_7262743e6198_0006",
        "e_7262743e6198_0007"
      ]
    },
    {
      "id": "total_backing_ignores_borrow",
      "kind": "root_cause",
      "text": "accountant.totalBacking() counts supplied collateral but ignores the borrow liability, so yieldShortfall() treats the omitted borrow amount as surplus.",
      "modality": "asserted",
      "entity_ids": [
        "accountant",
        "monetrix_vault",
        "false_surplus"
      ],
      "evidence_ids": [
        "e_7262743e6198_0015",
