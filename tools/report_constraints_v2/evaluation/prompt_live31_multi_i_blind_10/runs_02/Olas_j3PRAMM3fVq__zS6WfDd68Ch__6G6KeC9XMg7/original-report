ex, uint16 observationCardinality) = _getPoolData(pool);\nuint16 oldestIndex = (observationIndex + 1) % observationCardinality;\n(uint32 oldestTimestamp,,,,) = IUniswapV3(pool).observations(oldestIndex);\n\nif (block.timestamp - oldestTimestamp < SECONDS_AGO) {\n    revert InsufficientHistory(); \n}\n\n// Ensure TWAP check always runs and use it for amount calculations\n```",
      "proofOfConcept": "```solidity\n// SPDX-License-Identifier: MIT\npragma solidity ^0.8.30;\n\nimport {Test, console} from \"forge-std/Test.sol\";\n\n/**\n * @title TokenomicsMidEpochUpdate PoC\n * @notice Demonstrates SR-M-01: Mid-epoch tokenomics update wipes staking rewards and resets bond limits\n * \n * VULNERABILITY:\n * The `updateInflationPerSecondAndFractions` function incorrectly:\n * 1. Resets `stakingIncentive` to zero (line 1384)\n * 2. Overwrites `effectiveBond` with full `maxBond` (line 1381)\n * \n * This causes:\n * - Loss of accumulated staking rewards for the current epoch\n * - Bypass of inflation caps by resetting effectiveBond\n */\n\n// Minimal mock of the vulnerable Tokenomics logic\ncontract MockTokenomicsVulnerable {\n    uint256 public constant ONE_YEAR = 365 days;\n    \n    // State variables\n    address public owner;\n    uint256 public currentYear;\n    uint256 public timeLaunch;\n    uint256 public epochLen;\n    uint256 public epochCounter;\n    uint256 public inflationPerSecond;\n    uint96 public maxBond;\n    uint96 public effectiveBond;\n    \n    // Staking points mapping\n    mapping(uint256 => StakingPoint) public mapEpochStakingPoints;\n    \n    struct StakingPoint {\n        uint8 stakingFraction;\n        uint96 stakingIncentive;\n        uint96 maxStakingIncentive;\n        uint96 minStakingWeight;\n    }\n    \n    constructor() {\n        owner = msg.sender;\n        timeLaunch = block.timestamp;\n        epochLen = 7 days;\n        epochCounter = 1;\n        currentYear = 0;\n        inflationPerSecond = 1e18; // 1 OLAS per second for simplicity\n        maxBond = 1000 ether;\n        effectiveBond = 1000 ether;\n    }\n    \n    // Simulate accumulating staking rewards during epoch\n    function simulateStakingRewards(uint256 epoch, uint96 amount) external {\n        mapEpochStakingPoints[epoch].stakingIncentive = amount;\n        mapEpochStakingPoints[epoch].stakingFraction = 20; // 20%\n    }\n    \n    // Simulate bonds being issued (reducing effectiveBond)\n    function simulateBondsIssued(uint96 amount) external {\n        effectiveBond -= amount;\n    }\n    \n    // VULNERABLE FUNCTION - mirrors the actual implementation\n    function updateInflationPerSecondAndFractions(\n        uint256 maxBondFraction,\n        uint256 topUpComponentFraction,\n        uint256 topUpAgentFraction,\n        uint256 stakingFraction\n    ) external {\n        require(msg.sender == owner, \"OwnerOnly\");\n        \n        uint256 curEpochLen = epochLen;\n        uint256 numYears = (block.timestamp + curEpochLen - timeLaunch) / ONE_YEAR;\n        require(numYears <= currentYear, \"Year change not allowed\");\n        \n        uint256 curEpochCounter = epochCounter;\n        \n        // Update fractions\n        mapEpochStakingPoints[curEpochCounter].stakingFraction = uint8(stakingFraction);\n        \n        // Calculate updated inflation per second (simplified)\n        uint256 curInflationPerSecond = inflationPerSecond;\n        \n        // Recalculate maxBond\n        uint256 curMaxBond = (curEpochLen * curInflationPerSecond * maxBondFraction) / 100;\n        \n        // VULNERABILITY #1: effectiveBond is overwritten, ignoring already-issued bonds\n        maxBond = uint96(curMaxBond);\n        effectiveBond = uint96(curMaxBond); // BUG: Should account for already issued bonds\n        \n        // VULNERABILITY #2: stakingIncentive is reset to zero\n        mapEpochStakingPoints[curEpochCounter].stakingIncentive = 0; // BUG: Wipes accumulated rewards\n    }\n    \n    // View function to check staking incentive\n    function getStakingIncentive(uint256 epoch) external view returns (uint96) {\n        return mapEpochStakingPoints[epoch].stakingIncentive;\n    }\n}\n\ncontract TokenomicsMidEpochUpdateTest is Test {\n    MockTokenomicsVulnerable public tokenomics;\n    address public owner;\n    \n    function setUp() public {\n        owner = address(this);\n        tokenomics = new MockTokenomicsVulnerable();\n    }\n    \n    /**\n     * @notice PoC: Demonstrates staking rewards being wiped mid-epoch\n     */\n    function testStakingRewardsWipedMidEpoch() public {\n        uint256 currentEpoch = tokenomics.epochCounter();\n        \n        // Step 1: Simulate staking rewards accumulated during the epoch\n        // This represents rewards that stakers have earned and should receive\n        uint96 accumulatedRewards = 500 ether;\n        tokenomics.simulateStakingRewards(currentEpoch, accumulatedRewards);\n        \n        // Verify rewards are recorded\n        uint96 rewardsBefore = tokenomics.getStakingIncentive(currentEpoch);\n        assertEq(rewardsBefore, accumulatedRewards, \"Rewards should be accumulated\");\n        console.log(\"Staking rewards before update:\", rewardsBefore / 1e18, \"OLAS\");\n        \n        // Step 2: Owner calls updateInflationPerSecondAndFractions mid-epoch\n        // This is a legitimate admin action to adjust protocol parameters\n        tokenomics.updateInflationPerSecondAndFractions(\n            50,  // maxBondFraction\n            10,  // topUpComponentFraction\n            10,  // topUpAgentFraction\n            30   // stakingFraction\n        );\n        \n        // Step 3: Check staking rewards after update - THEY ARE WIPED!\n        uint96 rewardsAfter = tokenomics.getStakingIncentive(currentEpoch);\n        assertEq(rewardsAfter, 0, \"VULNERABILITY: Rewards were wiped to zero!\");\n        console.log(\"Staking rewards after update:\", rewardsAfter, \"OLAS\");\n        console.log(\"\");\n        console.log(\"IMPACT: Stakers lost\", accumulatedRewards / 1e18, \"OLAS in rewards!\");\n    }\n    \n    /**\n     * @notice PoC: Demonstrates effectiveBond reset allowing unbounded bond minting\n     */\n    function testEffectiveBondResetBypassesInflationCap() public {\n        // Step 1: Record initial bond state\n        uint96 initialMaxBond = tokenomics.maxBond();\n        uint96 initial