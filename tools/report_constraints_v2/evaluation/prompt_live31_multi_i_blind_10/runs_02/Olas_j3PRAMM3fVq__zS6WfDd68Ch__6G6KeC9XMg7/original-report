ffectiveBondAfterUpdate / 1e18, \"OLAS\");\n        console.log(\"Total bonds that can be issued:\", (bondsIssued + effectiveBondAfterUpdate) / 1e18, \"OLAS\");\n        \n        // The total bonds that can now be issued exceeds what the inflation schedule allowed\n        assertTrue(bondsIssued + effectiveBondAfterUpdate > initialMaxBond, \n            \"VULNERABILITY: Total issuable bonds exceeds original maxBond!\");\n    }\n}\n\n```",
