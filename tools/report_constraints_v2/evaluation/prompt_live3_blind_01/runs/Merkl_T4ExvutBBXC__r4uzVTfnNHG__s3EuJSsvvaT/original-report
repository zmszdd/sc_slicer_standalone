a recipient contract that implements daily claim limits to prevent abuse:\n\n```solidity\ncontract RateLimitedRecipient is IClaimRecipient {\n    mapping(address => uint256) public dailyClaimed;\n    uint256 public constant DAILY_LIMIT = 1000e18;\n\n    function onClaim(\n        address user,\n        address token,\n        uint256 amount,\n        bytes calldata data\n    ) external override returns (bytes32) {\n        if (dailyClaimed[user] + amount > DAILY_LIMIT) {\n            revert(\"Rate limit exceeded\");\n        }\n        dailyClaimed[user] += amount;\n        return CALLBACK_SUCCESS;\n    }\n}\n```\n\n**Attack Scenario:**\n1. Alice sets RateLimitedRecipient as her claim recipient\n2. Malicious operator attempts to claim 2000 tokens for Alice\n3. Callback executes: `dailyClaimed[alice] + 2000 > 1000` → reverts\n4. **Empty catch block swallows the revert**\n5. Claim proceeds successfully\n6. Alice receives 2000 tokens despite 1000 token daily limit\n\n**Impact:** The rate limiting validation is completely bypassed, allowing operators to exceed intended limits.\n\n**Why This is NOT a V12 Duplicate:**\n\nV12-M-01 identifies \"Improper Error Handling of onClaim Callback\" focusing on wrong return values **reverting the entire batch**. This finding demonstrates the **opposite problem**: reverting callbacks are silently ignored, allowing claims to succeed when they should fail. These are distinct attack vectors:\n- V12-M-01: Wrong return value → DoS entire batch\n- This finding: Reverting callback → Bypass validation logic\n\n**General Attack Pattern:**\n\n1. User implements `IClaimRecipient` with access control/validation in `onClaim()`:\n```solidity\nfunction onClaim(address user, address token, uint256 amount, bytes calldata data) external returns (bytes32) {\n    if (!isAuthorized(user)) revert Unauthorized();\n    if (amount > maxClaimAmount) revert ExcessiveClaim();\n    // ... perform intended actions ...\n    return CALLBACK_SUCCESS;\n}\n```\n\n2. User sets this recipient via `setClaimRecipient()`\n3. Malicious operator calls `claimWithRecipient()` with non-empty `data`\n4. `onClaim()` reverts due to failed validation\n5. **Empty catch block swallows the revert**\n6. Claim succeeds and tokens are transferred\n7. Intended validation/access control is bypassed\n\n**Impact:**\n\n1. **Callback Validation Bypass**: Recipients cannot reliably enforce access control or validation logic\n2. **Protocol Invariant Undermined**: The callback mechanism exists to allow recipients to perform custom logic and validation, but it can be completely bypassed\n3. **Silent Failures**: Recipients have no way to prevent unwanted claims if their validation logic reverts\n4. **Inconsistent Behavior**: Success with wrong return value → revert; Failure with revert → success (asymmetric)\n\n**Who Can Exploit:**\n- Any operator or authorized claimer can bypass recipient validation\n- Recipients cannot prevent bypass (reverts are swallowed)\n\n**Financial Impact:**\n- Depends on what logic the recipient intended to enforce\n- Could enable unauthorized claims, excessive claims, or violation of custom rules\n\n### Recommended mitigation steps\n\n**Option 1 (Preferred): Respect Callback Reverts**\n\nModify the catch block to revert on callback failures when data is provided:\n\n```solidity\nif (data.length != 0) {\n    try IClaimRecipient(recipient).onClaim(user, token, amount, data) returns (bytes32 callbackSuccess) {\n        if (callbackSuccess != CALLBACK_SUCCESS) revert Errors.InvalidReturnMessage();\n    } catch {\n        // CHANGED: Revert instead of silently continuing\n        revert Errors.CallbackFailed();\n    }\n}\n```\n\n**Option 2 (Alternative): Make Empty Data Opt-Out**\n\nOnly enforce callback validation when data is non-empty, but make it strict:\n\n```solidity\nif (data.length != 0) {\n    // No try-catch - let reverts propagate naturally\n    bytes32 callbackSuccess = IClaimRecipient(recipient).onClaim(user, token, amount, data);\n    if (callbackSuccess != CALLBACK_SUCCESS) revert Errors.InvalidReturnMessage();\n}\n```\n\n**Option 3: Document Behavior and Emit Event**\n\nIf silent swallowing is intended, at minimum emit an event:\n\n```solidity\nif (data.length != 0) {\n    try IClaimRecipient(recipient).onClaim(user, token, amount, data) returns (bytes32 callbackSuccess) {\n        if (callbackSuccess != CALLBACK_SUCCESS) revert Errors.InvalidReturnMessage();\n    } catch (bytes memory reason) {\n        // ADDED: Emit event for transparency\n        emit CallbackFailed(user, token, recipient, reason);\n    }\n}\n```\n\n**Rationale:**\n- Option 1 provides consistency: both wrong returns and reverts cause the claim to fail\n- Option 2 simplifies logic and makes callback validation strict when opted-in\n- Option 3 maintains current behavior but adds transparency\n- All options address the asymmetric error handling issue",
      "proofOfConcept": "```solidity\n// SPDX-License-Identifier: UNLICENSED\npragma solidity ^0.8.17;\n\nimport { Fixture } from \"../Fixture.t.sol\";\nimport { Distributor, MerkleTree } from \"../../contracts/Distributor.sol\";\nimport { IAccessControlManager } from \"../../contracts/interfaces/IAccessControlManager.sol\";\nimport { IClaimRecipient } from \"../../contracts/interfaces/IClaimRecipient.sol\";\nimport { IERC20 } from \"@openzeppelin/contracts/token/ERC20/IERC20.sol\";\n\n/// @notice Recipient that reverts on callback to enforce validation\ncontract RevertingCallbackRecipient is IClaimRecipient {\n    function onClaim(\n        address /* user */,\n        address /* token */,\n        uint256 /* amount */,\n        bytes calldata /* data */\n    ) external pure override returns (bytes32) {\n        revert(\"Access denied - validation failed\");\n    }\n}\n\ncontract C4PoC_CallbackBypass is Fixture {\n    Distributor public distributor;\n    RevertingCallbackRecipient public validatingRecipient;\n\n    function setUp() public override {\n        super.setUp();\n\n        // Deploy and initialize Distributor\n        Distributor distributorImpl = new Distributor();\n        distributor = Distributor(deployUUPS(address(distributorImpl), hex\"\"));\n        distributor.initialize(IAccessControlManager(address(accessControlManager)));\n\n        // Fund distributor\n        deal(address(angle), address(distributor), 100000e18);\n\n        // Deploy validating recipient\n        validatingRecipient = new RevertingCallbackRecipient();\n    }\n\n    /// @notice Test callback that reverts is silently bypassed\n    function test_submissionValidity() external {\n        // Alice sets reverting recipient (wants to enforce validation)\n        vm.prank(alice);\n        distributor.setClaimRecipient(address(validatingRecipient), address(angle));\n\n        // Setup valid tree\n        bytes32 merkleRoot = keccak256(abi.encode(alice, address(angle), uint256(1000e18)