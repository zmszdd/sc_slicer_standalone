/ ============================================================\n+        uint256 vaultUsdcAfter = usdc.balanceOf(address(vault));\n+        uint256 foundationGain = usdc.balanceOf(foundation) - foundationBefore;\n+        uint256 insuranceGain = usdc.balanceOf(address(insurance)) - insuranceBefore;\n+        uint256 realUsdcExited = foundationGain + insuranceGain;\n+        uint256 phantomUsdmMinted = usdm.totalSupply() - usdmSupplyBefore;\n+\n+        // 1) Real USDC permanently exited to Foundation (20%) and InsuranceFund (10%)\n+        assertTrue(foundationGain > 0, \"Foundation received real USDC\");\n+        assertTrue(insuranceGain > 0, \"InsuranceFund received real USDC\");\n+\n+        // 2) Unbacked USDM minted into sUSDM (70% of phantom yield)\n+        assertTrue(phantomUsdmMinted > 0, \"USDM supply inflated without backing\");\n+\n+        // 3) INV-1 VIOLATED: true backing < USDM totalSupply\n+        //    True backing = vault USDC (decreased) + L1 net (0)\n+        //    USDM supply = original 1M + phantom minted (increased)\n+        int256 trueBacking = int256(vaultUsdcAfter); // L1 net = 0\n+        int256 usdmSupply = int256(usdm.totalSupply());\n+        assertTrue(trueBacking < usdmSupply,\n+            \"INSOLVENT: true backing < USDM supply (INV-1 violated)\");\n+\n+        // 4) Accounting identity: all phantom yield accounted for\n+        assertEq(realUsdcExited + phantomUsdmMinted, totalPhantomYield,\n+            \"Total damage = phantom yield settled\");\n+\n+        emit log_named_uint(\"Total phantom yield settled (USDC)\", totalPhantomYield);\n+        emit log_named_uint(\"Real USDC exited to Foundation\", foundationGain);\n+        emit log_named_uint(\"Real USDC exited to InsuranceFund\", insuranceGain);\n+        emit log_named_uint(\"Phantom USDM minted into sUSDM\", phantomUsdmMinted);\n+        emit log_named_uint(\"Vault USDC before\", vaultUsdcBefore);\n+        emit log_named_uint(\"Vault USDC after\", vaultUsdcAfter);\n+ 