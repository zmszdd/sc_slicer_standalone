C20Harness(\"USDC\", \"USDC\");\n        ERC20Harness usdt = new ERC20Harness(\"USDT\", \"USDT\");\n\n        usdc.mint(address(launchpad), 1000e18);\n        usdt.mint(address(launchpad), 1000e18);\n        usdc.mint(alice, 10e18);\n        usdt.mint(bob, 10e18);\n        usdc.mint(thomas, 10e18);\n\n        // Initialize with tokens, dummy distributor and Lp\n        pair.initialize(address(usdc), address(usdt), address(launchpad), address(mockDistributor));\n\n        vm.startPrank(address(launchpad));\n        usdc.transfer(address(pair), 1000e18);\n        usdt.transfer(address(pair), 1000e18);\n\n        pair.mint(address(launchpad)); //sets reserve0, reserve1, blocktimestampLast and other important variables\n        vm.stopPrank();\n\n        (uint112 reserve0, uint112 reserve1,) = pair.getReserves();\n\n        console.log(\"Initial reserve0: and reserve1:\", reserve0, reserve1);\n\n        vm.warp(block.timestamp + 1 hours);\n\n        //As timeElapsed > 0 at the time alice swapped, so fee is distributed directly\n        //Using approx amount of tokens here, just to not complicate the swap math\n        vm.startPrank(alice);\n        usdc.transfer(address(pair), 10e18);\n        pair.swap(0, 9e18, alice, \"\"); //alice should get ~9.9e18 tokens after swap\n        vm.stopPrank();\n\n        console.log(\"usdt transferred to alice :\", usdt.balanceOf(alice));\n\n        //to get rid of stack too deep error, using these blocks\n        {\n            //checking if reserves match the expected reserves\n            uint112 LaunchpadFee0AlicePaid = 10e18 / 1000;\n            uint112 calculatedReserve0AfterAlice = reserve0 + 10e18 - LaunchpadFee0AlicePaid; //Not taking into account 0.3% swap fee as we set feeTo address(0), so no fee deducted\n            uint112 calculatedReserve1AfterAlice = reserve1 - 9e18;\n\n            (uint112 updatedReserve0AfterAlice, uint112 updatedReserve1AfterAlice,) = pair.getReserves();\n\n            console.log(\n                