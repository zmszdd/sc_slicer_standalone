      uint112 fee1AccruedFromBob = pair.accruedLaunchpadFee1(); //as bob deposited token1 only, so only fee1 will be accrued\n        console.log(\"Fee 1 Accrued from Bob:\", fee1AccruedFromBob);\n\n        /*After some time, Thomas swaps his tokens, as block.timestamp changed,\n        His transaction distributes the fee to Launchpad.\n        This undistributed fee is added to amounIn of next\n        User, also another fee is charged*/\n        vm.warp(block.timestamp + 1 hours);\n\n        vm.startPrank(thomas);\n        usdc.transfer(address(pair), 10e18); //only transferring token0, but events show both token0 and token1, because undistributed fee is added\n        vm.expectEmit();\n        emit Swap(thomas, 10e18, fee1AccruedFromBob, 0, 9e18, thomas); //events showing how fee accrued from bob's tx is counted as amount1In in thomas's tx\n        pair.swap(0, 9e18, thomas, \"\"); //thomas should get ~9.8e18 tokens after swap\n        vm.stopPrank();\n\n        {\n            uint112 LaunchpadFee0ThomasPaid = 10e18 / 1000;\n            uint112 calculatedReserve0AfterThomas = reserve0 + 10e18 - LaunchpadFee0ThomasPaid; //no swap fee accounted, because we added feeTo address(0)\n            /*As in Bob's transaction, fees only accrued from the balance because timeElapsed was 0.\n            As _distributeLaunchpadFees is triggered in thomas's swap, fee is deducted here, but\n            it is already subtract virtually from reserves so we don't have to subtract here as well*/\n            uint112 calculatedReserve1AfterThomas = reserve1 - 9e18;\n\n            (uint112 updatedReserve0AfterThomas, uint112 updatedReserve1AfterThomas,) = pair.getReserves();\n\n            console.log(\n                \"reserve0: and reserve1: after Thomas's swap\", updatedReserve0AfterThomas, updatedReserve1AfterThomas\n            );\n            //Ideally both the calculated reserves should match with actual reserves,  but reserve1 doesn't, because fees are subtracted twice and fee on fee is charged falsely on undistributed fee from bob's transaction, so we check if calculated reserves1 are more than actual\n            assertEq(calculatedReserve0AfterThomas, updatedReserve0AfterThomas, \"Incorrect accounting\");\n            assertGt(calculatedReserve1AfterThomas, updatedReserve1AfterThomas);\n\n            /*This happened because the undistributed fee is counted as amountIn for thomas's swap\n            On which an addition 0.001% fee is also charged from LP's token value and the fee is\n            also deducted twice from reserves0*/\n\n            //Simulating the buggy transaction\n            //Fee-On-Fee\n            uint112 FeeOnFeeCharged = fee1AccruedFromBob / 1000;\n\n            uint112 actualReserve1AfterThomas = reserve1 - 9e18 - FeeOnFeeCharged;\n\n            assertEq(actualReserve1AfterThomas, updatedReserve1AfterThomas, \"Still incorrect\");\n        }\n    }\n}\n\n```\n\n**Here are the test results:-**\n\n```solidity\nRan 1 test for test/c4-poc/PoCLaunchpad.t.sol:PoCLaunchpad\n[PASS] test_FeeOnFeeBugInAMM() (gas: 4056725)\nLogs:\n  totalLaunchpadFee0:  0\n  totalLaunchpadFee1:  0\n  Initial reserve0: and reserve1: 1000000000000000000000 1000000000000000000000\n  fee0: and fee1: 10000000000000000 0\n  totalLaunchpadFee0:  10000000000000000\n  totalLaunchpadFee1:  0\n  usdt transferred to alice : 9000000000000000000\n  reserve0: and reserve1 after alice's swap  1009990000000000000000 991000000000000000000\n  fee0: and fee1: 0 10000000000000000\n  totalLaunchpadFee0:  0\n  totalLaunchpadFee1:  10000000000000000\n  usdc transferred to bob: 10000000000000000000\n  reserve0: and reserve1 after Bob's swap in same block 999990000000000000000 1000990000000000000000\n  Fee 1 Accrued from Bob: 10000000000000000\n  fee0: and fee1: 10000000000000000 10000000000000\n  totalLaunchpadFee0:  10000000000000000\n  totalLaunchpadFee1:  10010000000000000\n  reserve0: and reserve1: after Thomas's swap 1009980000000000000000 9919899900000000000