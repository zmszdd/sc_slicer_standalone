../harnesses/ERC20Harness.sol\";\n\ncontract MockDistributor {\n    address public launchpad;\n\n    constructor(address _launchpad) {\n        launchpad = _launchpad;\n    }\n\n    function addRewards(address token0, address token1, uint128 amount0, uint128 amount1) external {\n        ERC20Harness(token0).transferFrom(msg.sender, address(this), amount0);\n        ERC20Harness(token1).transferFrom(msg.sender, address(this), amount1);\n    }\n}\n\ncontract PoCLaunchpad is LaunchpadTestBase {\n    /**\n     * PoC can utilize the following variables to access the relevant contracts:\n     * - factory: ERC1967Factory.sol\n     * - launchpad: Launchpad.sol\n     * - distributor: Distributor.sol\n     * - curve: SimpleBondingCurve.sol\n     * - launchpadLPVault: LaunchpadLPVault.sol\n     * - quoteToken: Quote token used in Launchpad system\n     * - uniV2Router: Uniswap V2 Router used in Launchpad system\n     */\n    function test_submissionValidity() external {}\n\n    /*Added here as because we deploy pair here,\n    it assumes address this as factory, \n    and pair makes a call to factory to feeTo function,\n     as factory is this contract, so made a temporary function*/\n    function feeTo() public returns (address) {\n        return address(0); //using address(0) just to skip paying 0.3% swap fee and easy calculations\n    }\n\n    //For testing\n    event Swap(\n        address indexed sender,\n        uint256 amount0In,\n        uint256 amount1In,\n        uint256 amount0Out,\n        uint256 amount1Out,\n        address indexed to\n    );\n\n    function test_FeeOnFeeBugInAMM() public {\n        address alice = makeAddr(\"alice\");\n        address bob = makeAddr(\"bob\");\n        address thomas = makeAddr(\"thomas\");\n        GTELaunchpadV2Pair pair = new GTELaunchpadV2Pair();\n        MockDistributor mockDistributor = new MockDistributor(address(launchpad));\n\n        // Token addresses to create a temporary AMM pool\n        ERC20Harness usdc = new ERC20Harness(\"USDC\", \"USDC\");\n        ERC20Harness usdt = new ERC20Harness(\"USDT\", \"USDT\");\n\n        usdc.mint(address(launchpad), 1000e18);\n        usdt.mint(address(launchpad), 1000e18);\n        usdc.mint(alice, 10e18);\n        usdt.mint(bob, 10e18);\n        usdc.mint(thomas, 10e18);\n\n        // Initialize with tokens, dummy distributor and Lp\n        pair.initialize(address(usdc), address(usdt), address(launchpad), address(mockDistributor));\n\n        vm.startPrank(address(launchpad));\n        usdc.transfer(address(pair), 1000e18);\n        usdt.transfer(address(pair), 1000e18);\n\n        pair.mint(address(launchpad)); //sets reserve0, reserve1, blocktimestampLast and other important variables\n        vm.stopPrank();\n\n        (uint112 reserve0, uint112 reserve1,) = pair.getReserves();\n\n        console.log(\"Initial reserve0: and reserve1:\", reserve0, reserve1);\n\n        vm.warp(block.timestamp + 1 hours);\n\n        //As timeElapsed > 0 at the time alice swapped, so fee is distributed directly\n        //Using approx amount of tokens here, just to not complicate the swap math\n        vm.startPrank(alice);\n        usdc.transfer(address(pair), 10e18);\n        pair.swap(0, 9e18, alice, \"\"); //alice should get ~9.9e18 tokens after swap\n        vm.stopPrank();\n\n        console.log(\"usdt transferred to alice :\", usdt.balanceOf(alice));\n\n        //to get rid of stack too deep error, using these blocks\n        {\n            //checking if reserves match the expected reserves\n            uint112 LaunchpadFee0AlicePaid = 10e18 / 1000;\n            uint112 calculatedReserve0AfterAlice = reserve0 + 10e18 - LaunchpadFee0AlicePaid; //Not taking into account 0.3% swap fee as we set feeTo address(0), so no fee deducted\n            uint112 calculatedReserve1AfterAlice = reserve1 - 9e18;\n\n            (uint112 updatedReserve0AfterAlice, uint112 updatedReserve1AfterAlice,) = pair.getReserves();\n\n            console.log(\n                \"reserve0: and reserve1 after alice's swap \", updatedReserve0AfterAlice, updatedReserve1AfterAlice\n            );\n            assertEq(calculatedReserve0AfterAlice, updatedReserve0AfterAlice, \"Incorrect accounting\");\n            assertEq(calculatedReserve1AfterAlice, updatedReserve1AfterAlice, \"Incorrect accounting\");\n        }\n\n        //updating reserves\n        (reserve0, reserve1,) = pair.getReserves();\n\n        //Now in the same block another user swaps their tokens, so block.timestamp is same and timeElapsed == 0, fee doesn't get distributed\n        vm.startPrank(bob);\n        usdt.transfer(address(pair), 10e18);\n        pair.swap(10e18, 0, bob, \"\"); //bob should get ~10.5e18 tokens after swap\n        vm.stopPrank();\n\n        console.log(\"usdc transferred to bob:\", usdc.balanceOf(bob));\n        {\n            //checking if reserves match the expected reserves\n            uint112 LaunchpadFee1BobPaid = 10e18 / 1000;\n            uint112 calculatedReserve0AfterBob = reserve0 - 10e18; //because alice swapped total 10e18 tokens for exact 10e18 tokens\n            /*Even though Lauchpad fee is not distributed yet\n            But it is subtracted from reserves, so subtracting the fee*/\n            uint112 calculatedReserve1AfterBob = reserve1 + 10e18 - LaunchpadFee1BobPaid;\n\n            (uint112 updatedReserve0AfterBob, uint112 updatedReserve1AfterBob,) = pair.getReserves();\n\n            console.log(\n                \"reserve0: and reserve1 after Bob's swap in same block\",\n                updatedReserve0AfterBob,\n                updatedReserve1AfterBob\n            );\n            assertEq(calculatedReserve0AfterBob, updatedReserve0AfterBob, \"Incorrect accounting\");\n            assertEq(calculatedReserve1AfterBob, updatedReserve1AfterBob, \"Incorrect accounting\");\n        }\n\n        //updating reserves\n        (reserve0, reserve1,) = pair.getReserves();\n\n        //Undistributed Fee in the pool from Bob's transaction\n        uint112 fee1AccruedFromBob = pair.accruedLaunchpadFee1(); //as bob deposited token1 only, so only fee1 will be accrued\n        console.log(\"Fee 1 Accrued from Bob:\", fee1AccruedFromBob);\n\n        /*After some time, Thomas swaps his tokens, as block.timestamp changed,\n        His transaction distributes the fee to Launchpad.\n        This undistributed fee is added to amounIn of next\n        User, also another fee is charged*/\n        vm.warp(block.timestamp + 1 hours);\n\n        vm.startPrank(thomas);\n        usdc.transfer(address(pair), 10e18); //only transferring token0, but events show both token0 and token1, because undistributed fee is added\n        vm.expectEmit();\n        emit Swap(thomas, 10e18, fee1AccruedFromBob, 0, 9e18, thomas); //events showing how fee accrued from bob's tx is counted as amount1In in thomas's tx\n        pair.swap(0, 9e18, thomas, \"\"); //thomas should get ~9.8e18 tokens after swap\n        vm.stopPrank();\n\n        {\n            uint112 LaunchpadFee0ThomasPaid = 10e18 / 1000;\n            uint112 calculatedReserve0AfterThomas = reserve0 + 10e18 - LaunchpadFee0ThomasPaid; //no swap fee accounted, because we added feeTo address(0)\n            /*As in Bob's transaction, fees only accrued from the balance because timeElapsed was 0.\n            As _distributeLaunchpadFees is triggered in thomas's swap, fee is deducted here, but\n            it is already subtract virtually from reserves so we don't have to subtract here as well*/\n            uint112 calculatedReserve1AfterThomas = reserve1 - 9e18;\n\n            (uint112 updatedReserve0AfterThomas, uint112 updatedReserve1AfterThomas,) = pair.getReserves();\n\n            console.log(\n                \"reserve0: and reserve1: after Thomas's swap\", updatedReserve0AfterThomas, updatedReserve1AfterThomas\n            );\n            //Ideally both the calculated reserves should match with actual reserves,  but reserve1 doesn't, because fees are subtracted twice and fee on fee is charged falsely on undistributed fee from bob's transaction, so we check if calculated reserves1 are more than actual\n            assertEq(calculatedReserve0AfterThomas, updatedReserve0AfterThomas, \"Incorrect accounting\");\n            assertGt(calculatedReserve1AfterThomas, updatedReserve1AfterThomas);\n\n            /*This happened because the undistributed fee is counted as amountIn for thomas's swap\n            On which an addition 0.001% fee is also charged from LP's token value and the fee is\n            also deducted twice from reserves0*/\n\n            //Simulating the buggy transaction\n            //Fee-On-Fee\n            uint112 FeeOnFeeCharged = fee1AccruedFromBob / 1000;\n\n            uint112 actualReserve1AfterThomas = reserve1 - 9e18 - FeeOnFeeCharged;\n\n            assertEq(actualReserve1AfterThomas, updatedReserve1AfterThomas, \"Still incorrect\");\n        }\n    }\n}\n\n```\n\n**Here are the test results:-**\n\n```solidity\nRan 1 test for test/c4-poc/PoCLaunchpad.t.sol:PoCLaunchpad\n[PASS] test_FeeOnFeeBugInAMM() (gas: 4056725)\nLogs:\n  totalLaunchpadFee0:  0\n  totalLaunchpadFee1:  0\n  Initial reserve0: and reserve1: 1000000000000000000000 1000000000000000000000\n  fee0: and fee1: 10000000000000000 0\n  totalLaunchpadFee0:  10000000000000000\n  totalLaunchpadFee1:  0\n  usdt transferred to alice : 9000000000000000000\n  reserve0: and reserve1 after alice's swap  1009990000000000000000 991000000000000000000\n  fee0: and fee1: 0 10000000000000000\n  totalLaunchpadFee0:  0\n  totalLaunchpadFee1:  10000000000000000\n  usdc transferred to bob: 10000000000000000000\n  reserve0: and reserve1 after Bob's swap in same block 999990000000000000000 1000990000000000000000\n  Fee 1 Accrued from Bob: 10000000000000000\n  fee0: and fee1: 10000000000000000 10000000000000\n  totalLaunchpadFee0:  10000000000000000\n  totalLaunchpadFee1:  10010000000000000\n  reserve0: and reserve1: after Thomas's swap 1009980000000000000000 991989990000000000000\n```",
