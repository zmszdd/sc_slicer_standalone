    },
    {
      "id": "e_f12d207c7791_0005",
      "text": "### Impact",
      "start": 209,
      "end": 219,
      "line": 8
    },
    {
      "id": "e_f12d207c7791_0006",
      "text": "The `head_not_withdraw_time` variable at line 41 has a critical value/comment mismatch. The comment indicates \"5days\" but the actual value is **1200 seconds (20 minutes)**, creating a **360x error factor**. This severely undermines governance security by allowing head position withdrawal after only 20 minutes instead of the intended 5 days.",
      "start": 221,
      "end": 563,
      "line": 10
    },
    {
      "id": "e_f12d207c7791_0007",
      "text": "**Security Impact:**",
      "start": 565,
      "end": 585,
      "line": 12
    },
    {
      "id": "e_f12d207c7791_0008",
      "text": "- Users can withdraw from head position **4 days, 23 hours, 40 minutes earlier** than intended",
      "start": 586,
      "end": 680,
      "line": 13
    },
    {
      "id": "e_f12d207c7791_0009",
      "text": "- Maximum head turnovers increase from **6/month (intended)** to **2,160/month (actual)**",
      "start": 681,
      "end": 770,
      "line": 14
    },
    {
      "id": "e_f12d207c7791_0010",
      "text": "- Governance lock mechanism completely defeated",
      "start": 771,
      "end": 818,
      "line": 15
    },
    {
      "id": "e_f12d207c7791_0011",
      "text": "- Protocol stability compromised by rapid head rotation",
      "start": 819,
      "end": 874,
      "line": 16
    },
    {
      "id": "e_f12d207c7791_0012",
      "text": "- Attackers can game governance with minimal commitment (20 min vs 5 days)",
      "start": 875,
      "end": 949,
      "line": 17
    },
    {
      "id": "e_f12d207c7791_0013",
      "text": "**Mathematical Proof:**",
      "start": 951,
      "end": 974,
      "line": 19
    },
    {
      "id": "e_f12d207c7791_0014",
      "text": "Current value: 1,200 seconds = 20 minutes",
      "start": 976,
      "end": 1017,
      "line": 21
    },
    {
      "id": "e_f12d207c7791_0015",
      "text": "Intended value: 432,000 seconds = 5 days",
      "start": 1018,
      "end": 1058,
      "line": 22
    },
    {
      "id": "e_f12d207c7791_0016",
      "text": "Error factor: 432,000 / 1,200 = 360x too small",
      "start": 1059,
      "end": 1105,
      "line": 23
    },
    {
      "id": "e_f12d207c7791_0017",
      "text": "Premature withdrawal: 430,800 seconds (4.98 days) early",
