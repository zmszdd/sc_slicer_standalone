    {
      "id": "rc_backlink_memory_copy",
      "kind": "root_cause",
      "text": "Only the forward link is saved to storage; the back-link is written to a memory copy and discarded, so non-head orders read prevOrderId == 0.",
      "modality": "asserted",
      "entity_ids": [
        "book_contract",
        "price_level_list"
      ],
      "evidence_ids": [
        "e_7d3e0bbc7995_0007",
        "e_7d3e0bbc7995_0009",
        "e_7d3e0bbc7995_0010"
      ]
    },
    {
      "id": "i_head_moved_past_real_head",
      "kind": "impact",
      "text": "Removal of a non-head order makes the routine believe it is the head and blindly moves limit.headOrder past the real head, orphaning earlier orders.",
      "modality": "asserted",
      "entity_ids": [
        "price_level_list",
        "rival_orders"
      ],
      "evidence_ids": [
        "e_7d3e0bbc7995_0012",
        "e_7d3e0bbc7995_0013"
      ]
    },
    {
      "id": "i_orphaned_orders_invisible",
      "kind": "impact",
      "text": "Orphaned orders become invisible to traversal, matching and user cancels while still counted in numBids/Asks and open-interest.",
      "modality": "asserted",
      "entity_ids": [
        "rival_orders",
        "open_interest_counters"
      ],
      "evidence_ids": [
        "e_7d3e0bbc7995_0014",
        "e_7d3e0bbc7995_0015"
      ]
    },
    {
      "id": "i_best_price_sentinel",
      "kind": "impact",
      "text": "After the final orphaned order is deleted, the RB-tree node is removed and getBestBid/Ask returns the MAX_UINT sentinel, disabling taker fills for that side.",
