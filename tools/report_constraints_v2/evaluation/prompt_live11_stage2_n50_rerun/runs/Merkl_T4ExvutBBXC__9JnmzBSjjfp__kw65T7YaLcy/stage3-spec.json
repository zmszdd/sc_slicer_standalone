      ],
      "claim_ids": [
        "impact_claim_disputer_stuck_25048fbd"
      ],
      "status": "formalized",
      "reason": "Program-generated exact coverage for selected direct impact."
    },
    {
      "impact_id": "no_recovery",
      "evidence": [
        "- `recoverERC20()` cannot help because `resolveDispute()` needs to succeed first to clear `disputer`",
        "- Even depositing more tokens doesn't help - the FoT token will take fees on the outgoing transfer too",
        "- Contract upgrade/migration is the only recovery option"
      ],
      "claim_ids": [
        "impact_claim_no_recovery_d3ac3594"
      ],
      "status": "unformalized",
      "reason": "No faithful claim generated after bounded retries: semantic faithfulness mismatch: intent_resolution_succeeds other_mismatch: The statement says resolution should succeed, but the predicate allows either resolution or recovery, weakening the success claim into a disjunction."
    },
    {
      "impact_id": "resolve_reverts",
      "evidence": [
        "- Contract only holds 990 tokens",
