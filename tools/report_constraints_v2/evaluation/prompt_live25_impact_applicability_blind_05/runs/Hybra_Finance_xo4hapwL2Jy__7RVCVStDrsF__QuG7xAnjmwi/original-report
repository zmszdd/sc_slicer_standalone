le.log(\"- Affects EVERY deposit (100% likelihood)\");\n        console.log(\"- 50% value loss per deposit\");\n        console.log(\"- Systematic wealth transfer\");\n        console.log(\"- Breaks fundamental accounting\");\n        console.log(\"- Not an attack - it's a code bug\");\n        console.log(\"\");\n        \n        console.log(\"WHY THIS IS NOT MEDIUM:\");\n        console.log(\"- Material value loss (50%)\");\n        console.log(\"- Affects all users permanently\");\n        console.log(\"- Fundamental accounting error\");\n        console.log(\"- Standard ERC4626 violation\");\n        console.log(\"\");\n        \n        console.log(\"COMPARISON TO FINDING #8:\");\n        console.log(\"=========================\");\n        console.log(\"Finding #8: First depositor inflation ATTACK\");\n        console.log(\"  - Malicious attacker manipulates\");\n        console.log(\"  - Affects first victim\");\n        console.log(\"  - Requires front-running\");\n        console.log(\"\");\n        console.log(\"Finding #9: Post-deposit accounting BUG\");\n        console.log(\"  - Code error, not attack\");\n        console.log(\"  - Affects EVERY depositor\");\n        console.log(\"  - Automatic, always happens\");\n        console.log(\"\");\n        console.log(\"BOTH ARE HIGH SEVERITY BUT DIFFERENT BUGS!\");\n        console.log(\"\");\n        \n        console.log(\"FIX (reorder operations):\");\n        console.log(\"  function deposit(uint256 amount, address recipient) external {\");\n        console.log(\"      IERC20(HYBR).transferFrom(msg.sender, address(this), amount);\");\n        console.log(\"      \");\n        console.log(\"      // MOVE THIS UP - calculate shares FIRST\");\n        console.log(\"      uint256 shares = calculateShares(amount);  // BEFORE deposit!\");\n        console.log(\"      \");\n        console.log(\"      // THEN deposit to veNFT\");\n        console.log(\"      if (veTokenId == 0) {\");\n        console.log(\"          _initializeVeNFT(amount);\");\n        console.log(\"      } else {\");\n        console.log(\"          IVotingEscrow(votingEscrow).deposit_for(veTokenId, amount);\");\n        console.log(\"      }\");\n        console.log(\"      \");\n        console.log(\"      _mint(recipient, shares);\");\n        console.log(\"  }\");\n        console.log(\"\");\n        \n        console.log(\"Simple reordering fixes the bug!\");\n        console.log(\"Standard ERC4626 pattern!\");\n    }\n    \n    //////////////////////////////////////////////////////////////\n    // TEST 2: Mathematical Demonstration\n    //////////////////////////////////////////////////////////////\n    \n    /// @notice HIGH: Demonstrates the value loss mathematically\n    /// @dev Shows exact calculation with numbers\n    function test_HIGH_gHYBR_PostDeposit_MathProof() external pure {\n        console.log(\"\\n=== HIGH: Mathematical Proof of Value Loss ===\\n\");\n        \n        console.log(\"SCENARIO: Equal deposit to existing vault\");\n        console.log(\"=========================================\");\n        \n        uint256 existingAssets = 100 ether;\n        uint256 existingSupply = 100 ether;\n        uint256 newDeposit = 100 ether;\n        \n        console.log(\"Initial state:\");\n        console.log(\"  totalAssets:\", existingAssets / 1e18, \"HYBR\");\n        console.log(\"  totalSupply:\", existingSupply / 1e18, \"shares\");\n        console.log(\"  Price per share:\", (existingAssets * 1e18) / existingSupply / 1e18, \"HYBR\");\n        console.log(\"\");\n        console.log(\"New deposit:\", newDeposit / 1e18, \"HYBR\");\n        console.log(\"\");\n        \n        // CURRENT (BUG)\n        uint256 assetsAfterDeposit = existingAssets + newDeposit;\n        uint256 sharesBug = (newDeposit * existingSupply) / assetsAfterDeposit;\n        \n        console.log(\"CURRENT IMPLEMENTATION (BUG):\");\n        console.log(\"  1. Deposit to veNFT first\");\n        console.lo