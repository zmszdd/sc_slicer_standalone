 from \"../../src/libraries/Utils.sol\";\nimport {TestMath} from \"../utils/TestMath.sol\";\nimport {Events} from \"../../src/libraries/Events.sol\";\nimport {Errors} from \"../../src/libraries/Errors.sol\";\nimport {LatentSwapLib} from \"../../src/periphery/libraries/LatentSwapLib.sol\";\nimport {PercentageMath} from \"@aave/libraries/math/PercentageMath.sol\";\nimport {IERC4626} from \"forge-std/interfaces/IERC4626.sol\";\nimport {StubERC4626} from \"../mocks/StubERC4626.sol\";\nimport {Ownable} from \"@openzeppelin/access/Ownable.sol\";\n\n/**\n * @title Redemption Cap Bypass PoC\n * @notice Demonstrates that users can bypass the intended redemption rate limit\n *         by making frequent small redemptions instead of large single redemptions\n * \n * VULNERABILITY SUMMARY:\n * - The ETWAP (Exponential Time-Weighted Average) updates on EVERY transaction\n * - This allows users to force ETWAP updates by making frequent small transactions\n * - By doing so, they can redeem ~2x faster than the intended rate limit\n * \n * INTENDED BEHAVIOR:\n * - 30-minute ETWAP half-life\n * - ~25% of ETWAP redeemable at once\n * - Expected rate: ~25-30% per hour\n * \n * ACTUAL BEHAVIOR (EXPLOIT):\n * - Make redemptions every 5 minutes\n * - ETWAP updates after each transaction\n * - Achieved rate: ~45% per hour (2x faster!)\n */\ncontract RedeemCapBypassPoC is Test {\n    using WadRayMath for uint256;\n\n    // LatentSwapLEX init pricing constants\n    uint160 internal constant P_MAX = uint160((1095445 * FixedPoint.Q96) / 1000000);\n    uint160 internal constant P_MIN = uint160(FixedPoint.Q192 / P_MAX);\n    uint32 internal constant DURATION = 30 * 24 * 60 * 60;\n    uint8 internal constant SWAP_FEE = 0;\n    int64 internal constant LN_RATE_BIAS = 5012540000000000;\n\n    address private _mockOracle;\n    address private _mockBaseAsset;\n    address private _mockQuoteAsset;\n    uint160 private P_LIM_H = LatentSwapLib.getSqrtPriceFromLTVX96(P_MIN, P_MAX, 9500);\n    uint160 private P_LIM_MAX = LatentSwapLib.getSqrtPriceFromLTVX96(P_MIN, P_MAX, 9999);\n\n    // Contract deployments\n    Covenant public covenant;\n    LatentSwapLEX public lex;\n    MarketId internal _marketId;\n    MarketParams internal _marketParams;\n\n    // Test constants\n    uint256 constant INITIAL_MINT = 1000 ether; // Large initial market\n    uint256 constant ATTACKER_MINT = 1000 ether; // Attacker's position\n\n    function setUp() public {\n        // Deploy mock Oracle\n        _mockOracle = address(new MockOracle(address(this)));\n        MockOracle(_mockOracle).setPrice(2000 * 10**18); // $2000 per base token\n\n        // Deploy mock Base Asset with large supply\n        _mockBaseAsset = address(new MockERC20(address(this), \"MockBaseAsset\", \"MBA\", 18));\n        MockERC20(_mockBaseAsset).mint(address(this), 10000 ether);\n\n        // Deploy mock Quote Asset\n        _mockQuoteAsset = address(new MockERC20(address(this), \"MockQuoteAsset\", \"MQA\", 18));\n\n        // Deploy Covenant\n        covenant = new Covenant(address(this));\n\n        // Deploy LEX implementation\n        lex = new LatentSwapLEX(\n            address(this),\n            address(covenant),\n            P_MAX,\n            P_MIN,\n            P_LIM_H,\n            P_LIM_MAX,\n            LN_RATE_BIAS,\n            DURATION,\n            SWAP_FEE\n        );\n\n        // Connect LEX with Covenant\n        covenant.setEnabledLEX(address(lex), true);\n\n        // Connect mock oracle with Covenant\n        covenant.setEnabledCurator(_mockOracle, true);\n\n        // Create market\n        _marketParams = MarketParams({\n            baseToken: _mockBaseAsset,\n            quoteToken: _mockQuoteAsset,\n            curator: _mockOracle,\n            lex: address(lex)\n        });\n        _marketId = covenant.createMarket(_marketParams, hex\"\");\n\n        // Initial mint to establish market\n        IERC20(_mockBaseAsset).approve(address(covenant), INITIAL_MINT);\n        covenant.min