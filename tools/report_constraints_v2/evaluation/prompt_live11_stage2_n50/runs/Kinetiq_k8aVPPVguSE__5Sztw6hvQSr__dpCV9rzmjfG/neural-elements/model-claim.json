      "entity_ids": [
        "staking_manager",
        "pending_withdrawers"
      ],
      "evidence_ids": [
        "e_60a915cc84d4_0019",
        "e_60a915cc84d4_0026"
      ]
    },
    {
      "id": "i_permanent_fund_loss",
      "kind": "impact",
      "text": "After the queue reset, all pending withdrawal operations are deleted with no record, users' ETH remains trapped in the contract, and all users with pending withdrawals permanently lose their funds.",
