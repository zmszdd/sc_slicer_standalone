  "fragments": [
    {
      "id": "e_39c6e2117964_0001",
      "text": "Missing Access Control in BuilderWallet.init() Allows for Account Takeover and Theft of All Builder Fees",
      "start": 0,
      "end": 104,
      "line": 1
    },
    {
      "id": "e_39c6e2117964_0002",
      "text": "### Description",
      "start": 106,
      "end": 121,
      "line": 3
    },
    {
      "id": "e_39c6e2117964_0003",
      "text": "The `init()` function in the `BuilderWallet` contract lacks any access control checks. This allows any arbitrary user to call the function and overwrite the `builderAdmin` address repeatedly.",
      "start": 122,
      "end": 313,
      "line": 4
    },
    {
      "id": "e_39c6e2117964_0004",
      "text": "https://github.com/code-423n4/2025-12-panoptic/blob/fe557748210a529ae414d7c487b6514be0d9e220/contracts/RiskEngine.sol#L2315-L2317",
      "start": 315,
      "end": 444,
      "line": 6
    },
    {
      "id": "e_39c6e2117964_0005",
      "text": "An attacker can take over the `builderAdmin` role and use the `sweep()` function to drain all tokens from the `BuilderWallet`.",
      "start": 448,
      "end": 574,
      "line": 9
    },
    {
      "id": "e_39c6e2117964_0006",
      "text": "## Impact",
      "start": 577,
      "end": 586,
      "line": 12
    },
    {
      "id": "e_39c6e2117964_0007",
      "text": "Loss of Funds.",
      "start": 588,
      "end": 602,
      "line": 14
    },
    {
      "id": "e_39c6e2117964_0008",
      "text": "## Mitigate",
      "start": 604,
      "end": 615,
      "line": 16
    },
    {
      "id": "e_39c6e2117964_0009",
      "text": "Add access control và initialization check",
      "start": 617,
      "end": 659,
      "line": 17
    }
  ]
}
