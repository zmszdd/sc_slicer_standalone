  "fragments": [
    {
      "id": "e_8fb527d33f6e_0001",
      "text": "Hardcoded Deadline in L2TokenReceiverV2 Liquidity Functions",
      "start": 0,
      "end": 59,
      "line": 1
    },
    {
      "id": "e_8fb527d33f6e_0002",
      "text": "L2TokenReceiverV2 contains a critical vulnerability in the increaseLiquidityCurrentRange() function where deadline is hardcoded to block.timestamp, eliminating transaction expiration protection and enabling MEV attacks.",
      "start": 61,
      "end": 280,
      "line": 3
    },
    {
      "id": "e_8fb527d33f6e_0003",
      "text": "Root Cause",
      "start": 282,
      "end": 292,
      "line": 5
    },
    {
      "id": "e_8fb527d33f6e_0004",
      "text": "The function hardcodes deadline: block.timestamp when calling Uniswap V3's increaseLiquidity().",
      "start": 293,
      "end": 388,
      "line": 6
    },
    {
      "id": "e_8fb527d33f6e_0005",
      "text": "1. Incorrect and Vulnerable:",
      "start": 390,
      "end": 418,
      "line": 8
    },
    {
      "id": "e_8fb527d33f6e_0006",
      "text": "function increaseLiquidityCurrentRange(",
      "start": 420,
      "end": 459,
      "line": 10
    },
    {
      "id": "e_8fb527d33f6e_0007",
      "text": "uint256 tokenId_,",
      "start": 464,
      "end": 481,
      "line": 11
    },
    {
