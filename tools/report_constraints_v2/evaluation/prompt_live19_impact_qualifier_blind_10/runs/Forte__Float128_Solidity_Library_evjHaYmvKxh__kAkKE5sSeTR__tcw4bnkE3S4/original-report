t128.decode(result);\n        emit LogInt(\"ln(negative) mantissa\", resultMantissa);\n        emit LogInt(\"ln(negative) exponent\", resultExp);\n        \n        assertTrue(true, \"Ln.ln did not revert with negative input\");\n    }\n    \n    function testLnZeroInput() public {\n        packedFloat zeroInput = Float128.toPackedFloat(0, 0);\n        \n        emit LogInt(\"Zero input raw\", int(packedFloat.unwrap(zeroInput)));\n        \n        packedFloat result;\n        result = Ln.ln(zeroInput);\n        \n        (int resultMantissa, int resultExp) = Float128.decode(result);\n        emit LogInt(\"ln(zero) mantissa\", resultMantissa);\n        emit LogInt(\"ln(zero) exponent\", resultExp);\n        \n        assertTrue(true, \"Ln.ln handled zero input without proper validation\");\n    }\n    \n    function testLnPositiveInput() public {\n        packedFloat positiveInput = Float128.toPackedFloat(10, 0);\n        \n        packedFloat result = Ln.ln(positiveInput);\n        \n        (int resultMantissa, int resultExp) = Float128.decode(result);\n        emit LogInt(\"ln(positive) mantissa\", resultMantissa);\n        emit LogInt(\"ln(positive) exponent\", resultExp);\n        \n        assertTrue(resultMantissa > 0 || (resultMantissa == 0 && resultExp > 0), \n            \"ln(positive) should return a positive value\");\n    }\n    \n    function testProperLnImplementation() public {\n        packedFloat negativeInput = Float128.toPackedFloat(-10, 0);\n        \n        bool isNegative = (packedFloat.unwrap(negativeInput) & MANTISSA_SIGN_MASK) != 0;\n        bool isZero = packedFloat.unwrap(negativeInput) == 0;\n        \n        if (isNegative || isZero) {\n            emit LogBool(\"Input validation\", true);\n            assertTrue(true, \"Input validation correctly identified invalid input\");\n            return;\n        }\n        \n        assertFalse(true, \"Should not reach here with negative input\");\n    }\n}\n```",
