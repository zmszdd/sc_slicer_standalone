ract balance\n    function test_submissionValidity() external {\n        // Configure fee recipient and relax tail window to avoid edge timing\n        gHybr.setTeam(address(0xBEEF));\n        gHybr.setTailNotWithdrawTime(0);\n\n        // 1) Deposit 100 HYBR into gHYBR => fully locked into veNFT and mint 100 gHYBR shares\n        uint256 depositAmount = 100 ether;\n        address user = address(0xB0B);\n        // fund user for deposit\n        hybr.transfer(user, depositAmount);\n        // user deposits and receives shares\n        vm.startPrank(user);\n        hybr.approve(address(gHybr), depositAmount);\n        gHybr.deposit(depositAmount, user);\n        vm.stopPrank();\n\n        // 2) Send extra 50 HYBR directly to gHYBR => sits as pending in contract balance (not locked)\n        uint256 pending = 50 ether;\n        hybr.transfer(address(gHybr), pending);\n        assertEq(hybr.balanceOf(address(gHybr)), pending, \"pending HYBR must sit in gHYBR\");\n\n        // Pre-withdraw metrics for fair-share calculation\n        uint256 preLocked = gHybr.totalAssets();        // = 100e18 (locked in veNFT)\n        uint256 preSupply = gHybr.totalSupply();        // = 100e18 (minted shares)\n        assertEq(preLocked, 100 ether, \"preLocked should be 100e18\");\n        assertEq(preSupply, 100 ether, \"preSupply should be 100e18\");\n\n        // 3) Move time into allowed withdraw window\n        uint256 WEEK = 1800; // HybraTimeLibrary.WEEK (testnet)\n        uint256 epochStart = (block.timestamp / WEEK) * WEEK;\n        vm.warp(epochStart + 1201); // past head_not_withdraw_time (1200s), tail set to 0\n\n        // Enable splitting on VotingEscrow for gHYBR to avoid !SPLIT revert in withdraw\n        votingEscrow.toggleSplit(address(gHybr), true);\n\n        // 4) Withdraw half the shares (50 gHYBR)\n        uint256 sharesToWithdraw = preSupply / 2; // 50e18\n        vm.startPrank(user);\n        uint256 userTokenId = gHybr.withdraw(sharesToWithdraw);\n        vm.stopPrank();\n\n        // 5) Check user's new veNFT locked amount: 49.5e18 (1% fee on 50e18, locked-only assets)\n        (int128 amt, , ) = votingEscrow.locked(userTokenId);\n        uint256 userLocked = uint256(int256(amt));\n        assertEq(userLocked, 49.5 ether, \"user receives only locked-based assets minus fee\");\n\n        // 6) Pending HYBR remains unaccounted in contract\n        assertEq(hybr.balanceOf(address(gHybr)), pending, \"pending HYBR remains in gHYBR post-withdraw\");\n\n        // 7) Demonstrate underpayment: fair share should include pending (50/100 * (100+50) = 75)\n        uint256 expectedFair = (sharesToWithdraw * (preLocked + pending)) / preSupply;\n        assertEq(expectedFair, 75 ether, \"expected fair share must include pending HYBR\");\n        assertLt(userLocked, expectedFair, \"withdraw underpays vs fair total assets including pending\");\n    }\n}\n```",
