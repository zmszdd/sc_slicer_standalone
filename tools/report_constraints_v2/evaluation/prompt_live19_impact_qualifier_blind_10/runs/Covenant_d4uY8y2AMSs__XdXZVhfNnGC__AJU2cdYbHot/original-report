  console.log(\"Covenant balance before baseline batch\", address(covenant).balance);\n        covenant.multicall{value: 1 ether}(baselineBatch);\n        console.log(\"Oracle msg.value on last baseline call\", MockOracle(_mockOracle).lastReceivedMsgValue());\n        console.log(\"Oracle callCount after baseline batch\", MockOracle(_mockOracle).callCount());\n        console.log(\"Covenant balance after baseline batch\", address(covenant).balance);\n\n        // Assemble a nested batch: first entry re-enters multicall (with zero payload) before replaying the baseline calls.\n        bytes[] memory nestedInner = new bytes[](0);\n        bytes[] memory nestedBatch = new bytes[](3);\n        nestedBatch[0] = abi.encodeWithSelector(Covenant.multicall.selector, nestedInner);\n        nestedBatch[1] = baselineBatch[0];\n        nestedBatch[2] = baselineBatch[1];\n\n        // Expect the first post-nesting updateState call to revert because _isMulticall is reset to false mid-batch.\n        console.log(\"Oracle callCount before nested batch\", MockOracle(_mockOracle).callCount());\n        vm.expectRevert(Errors.E_IncorrectPayment.selector);\n        covenant.multicall{value: 1 ether}(nestedBatch);\n    }\n}\n\n```\n\nRun:\n\n```bash\nforge test --match-test test_nestedMulticallDesyncsPaymentFlag\n```\n\nResults:\n\n```text\nRan 1 test for test/poc/C4PoC.t.sol:CovenantTest\n[PASS] test_nestedMulticallDesyncsPaymentFlag() (gas: 306837)\nLogs:\n  Covenant balance before baseline batch 0\n  Oracle msg.value on last baseline call 600000000000000000\n  Oracle callCount before nested batch 2\n\nSuite result: ok. 1 passed; 0 failed; 0 skipped\n```",
