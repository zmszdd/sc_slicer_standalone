nt256 amount) external returns (bool) {\n        require(_balances[from] >= amount, \"Insufficient balance\");\n        _balances[from] -= amount;\n        _balances[to] += amount;\n        return true;\n    }\n}\n\ncontract MockL1Write {\n    struct DelegateCall {\n        address validator;\n        uint64 amount;\n        bool isWithdrawal;\n    }\n    \n    struct WithdrawalCall {\n        uint64 amount;\n    }\n    \n    DelegateCall[] public delegateCalls;\n    WithdrawalCall[] public withdrawalCalls;\n    \n    function sendTokenDelegate(address validator, uint64 amount, bool isWithdrawal) external {\n        delegateCalls.push(DelegateCall(validator, amount, isWithdrawal));\n    }\n    \n    function sendCWithdrawal(uint64 amount) external {\n        withdrawalCalls.push(WithdrawalCall(amount));\n    }\n    \n    function sendCDeposit(uint64 amount) external {\n    }\n    \n    function getDelegateCalls() external view returns (DelegateCall[] memory) {\n        return delegateCalls;\n    }\n    \n    function getWithdrawalCalls() external view returns (WithdrawalCall[] memory) {\n        return withdrawalCalls;\n    }\n}\n\ncontract VulnerableStakingManager {\n    bytes32 public constant MANAGER_ROLE = keccak256(\"MANAGER_ROLE\");\n    bytes32 public constant OPERATOR_ROLE = keccak256(\"OPERATOR_ROLE\");\n    \n    enum OperationType {\n        UserDeposit,\n        SpotDeposit,\n        RebalanceDeposit,\n        UserWithdrawal,\n        RebalanceWithdrawal\n    }\n    \n    struct WithdrawalRequest {\n        uint256 hypeAmount;\n        uint256 kHYPEAmount;\n        uint256 kHYPEFee;\n        uint256 timestamp;\n    }\n    \n    struct L1Operation {\n        address validator;\n        uint256 amount;\n        OperationType operationType;\n    }\n    \n    MockKHYPE public kHYPE;\n    MockL1Write public l1Write;\n    address public treasury;\n    \n    mapping(address => mapping(uint256 => WithdrawalRequest)) private _withdrawalRequests;\n    mapping(address => uint256) public nextWithdrawalId;\n    uint256 public totalQueuedWithdrawals;\n    uint256 private _cancelledWithdrawalAmount;\n    L1Operation[] private _pendingWithdrawals;\n    uint256 private _withdrawalProcessingIndex;\n    \n    mapping(bytes32 => mapping(address => bool)) private _roles;\n    \n    event WithdrawalQueued(address indexed user, uint256 indexed withdrawalId, uint256 hypeAmount);\n    event WithdrawalCancelled(address indexed user, uint256 indexed withdrawalId, uint256 amount, uint256 totalCancelAmount);\n    event L1DelegationProcessed(address indexed caller, address indexed validator, uint256 amount, OperationType operationType);\n    \n    constructor() {\n        kHYPE = new MockKHYPE();\n        l1Write = new MockL1Write();\n        treasury = address(0x1234567890123456789012345678901234567890);\n        _roles[MANAGER_ROLE][msg.sender] = true;\n        _roles[OPERATOR_ROLE][msg.sender] = true;\n    }\n    \n    modifier onlyRole(bytes32 role) {\n        require(_roles[role][msg.sender], \"AccessControl: account does not have role\");\n        _;\n    }\n    \n    function grantRole(bytes32 role, address account) external {\n        _roles[role][account] = true;\n    }\n    \n    function cancelWithdrawal(address user, uint256 withdrawalId) external onlyRole(MANAGER_ROLE) {\n        WithdrawalRequest storage request = _withdrawalRequests[user][withdrawalId];\n        require(request.hypeAmount > 0, \"No such withdrawal request\");\n\n        uint256 hypeAmount = request.hypeAmount;\n        uint256 kHYPEAmount = request.kHYPEAmount;\n        uint256 kHYPEFee = request.kHYPEFee;\n\n        require(kHYPE.balanceOf(address(this)) >= kHYPEAmount + kHYPEFee, \"Insufficient kHYPE balance\");\n\n        delete _withdrawalRequests[user][withdrawalId];\n        totalQueuedWithdrawals -= hypeAmount;\n\n        kHYPE.transfer(user, kHYPEAmount + kHYPEFee);\n\n        _cancelledWithdrawalAmount += hypeAmount;\n\n        emit WithdrawalCancelled(user, withdrawalId, hypeAmount, _cancelledWithdrawalAmount);\n    }\n    \n    function queueWithdrawal(address user, uint256 kHYPEAmount) external {\n        require(kHYPEAmount > 0, \"Invalid amount\");\n        \n        uint256 withdrawalId = nextWithdrawalId[user];\n        \n        uint256 kHYPEFee = kHYPEAmount / 100;\n        uint256 postFeeKHYPE = kHYPEAmount - kHYPEFee;\n        \n        uint256 hypeAmount = postFeeKHYPE;\n        \n        kHYPE.mint(address(this), kHYPEAmount);\n        \n        _withdrawalRequests[user][withdrawalId] = WithdrawalRequest({\n            hypeAmount: hypeAmount,\n            kHYPEAmount: postFeeKHYPE,\n            kHYPEFee: kHYPEFee,\n            timestamp: block.timestamp\n        });\n        \n        nextWithdrawalId[user]++;\n        totalQueuedWithdrawals += hypeAmount;\n        \n        address validator = address(0x7777777777777777777777777777777777777777);\n        _queueL1Operation(validator, hypeAmount, OperationType.UserWithdrawal);\n        \n        emit WithdrawalQueued(user, withdrawalId, hypeAmount);\n    }\n    \n    function _queueL1Operation(address validator, uint256 amount, OperationType operationType) internal {\n        L1Operation memory operation = L1Operation({\n            validator: validator,\n            amount: amount,\n            operationType: operationType\n        });\n        \n        _pendingWithdrawals.push(operation);\n    }\n    \n    function processL1Operations() external onlyRole(OPERATOR_ROLE) {\n        uint256 length = _pendingWithdrawals.length;\n        if (length <= _withdrawalProcessingIndex) {\n            return;\n        }\n        \n        for (uint256 i = _withdrawalProcessingIndex; i < length; i++) {\n            L1Operation memory op = _pendingWithdrawals[i];\n            \n            uint64 amount64 = uint64(op.amount);\n            \n            l1Write.sendTokenDelegate(op.validator, amount64, true);\n            if (op.operationType == OperationType.UserWi