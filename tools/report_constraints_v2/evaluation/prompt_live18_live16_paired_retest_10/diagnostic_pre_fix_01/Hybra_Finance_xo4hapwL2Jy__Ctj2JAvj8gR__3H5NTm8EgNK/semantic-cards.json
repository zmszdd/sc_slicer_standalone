{
  "schema_version": "stage2-impact-semantic-cards/1",
  "cards": [
    {
      "schema_version": "stage2-impact-semantic-card/1",
      "impact": {
        "id": "dynamic_fee_mechanism_ineffective",
        "text": "The dynamic fee system contains a cconflicting fee caps between `DynamicSwapFeeModule.getFee()` and `CLFactory.getSwapFee()` which renders the dynamic fee mechanism ineffective.",
        "modality": "asserted",
        "evidence_ids": [
          "e_244b113541c8_0003"
        ]
      },
      "impact_qualifier_types": [
        "range"
      ],
      "precondition_sources": [
        {
          "id": "max_fee_cap_500000",
          "kind": "precondition",
          "text": "DynamicSwapFeeModule.MAX_FEE_CAP is set to 500,000 (50%).",
          "modality": "asserted",
          "evidence_ids": [
            "e_244b113541c8_0004"
          ]
        },
        {
          "id": "factory_rejects_above_100000",
          "kind": "precondition",
          "text": "CLFactory.getSwapFee() rejects any fee above 100,000 (10%).",
          "modality": "asserted",
          "evidence_ids": [
            "e_244b113541c8_0005"
          ]
        }
      ],
      "intent_sources": [
        {
          "id": "intent_dynamic_fee_accepted",
          "kind": "security_intent",
          "text": "A dynamically calculated fee within DynamicSwapFeeModule's MAX_FEE_CAP (500,000) should be accepted by CLFactory.getSwapFee() rather than rejected.",
          "modality": "asserted",
          "evidence_ids": [
            "e_244b113541c8_0003",
            "e_244b113541c8_0004",
            "e_244b113541c8_0008"
          ]
        },
        {
          "id": "intent_caps_aligned",
          "kind": "security_intent",
          "text": "CLFactory.getSwapFee() threshold should be aligned with DynamicSwapFeeModule.MAX_FEE_CAP (500,000) so full dynamic fees are allowed.",
          "modality": "asserted",
          "evidence_ids": [
            "e_244b113541c8_0008"
          ]
        }
      ],
      "excluded_inferred_intent_ids": [],
      "formalizability": {
        "status": "selected",
        "reason": "The explicit P/I source selection is recorded; formula validity remains unassessed.",
        "applicability": {
          "impact_id": "dynamic_fee_mechanism_ineffective",
          "status": "selected",
          "precondition_ids": [
            "max_fee_cap_500000",
            "factory_rejects_above_100000"
          ],
          "intent_ids": [
            "intent_dynamic_fee_accepted",
            "intent_caps_aligned"
          ]
        }
      },
      "rules": [
        "Only the selected impact may supply V.",
