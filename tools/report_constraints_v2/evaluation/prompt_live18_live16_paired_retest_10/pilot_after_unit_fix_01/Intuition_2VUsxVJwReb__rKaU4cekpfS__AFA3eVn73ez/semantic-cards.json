    {
      "schema_version": "stage2-impact-semantic-card/1",
      "impact": {
        "id": "new_locker_loses_70_percent_first_epoch_rewards",
        "text": "Every new veTRUST locker who does not interact with MultiVault during their first claimable epoch loses 70% of that epoch's rewards",
        "modality": "asserted",
        "evidence_ids": [
          "e_d1544f37b1f5_0043"
        ]
      },
      "impact_qualifier_types": [
        "scope",
        "trigger"
      ],
      "precondition_sources": [
        {
          "id": "alice_first_ever_lock_epoch_n",
          "kind": "precondition",
          "text": "Alice locks 100,000 wrapped TRUST in epoch N as her first-ever lock and had no veTRUST before epoch N.",
          "modality": "asserted",
          "evidence_ids": [
            "e_d1544f37b1f5_0024",
            "e_d1544f37b1f5_0026"
          ]
        },
        {
          "id": "alice_no_multivault_activity",
          "kind": "precondition",
          "text": "Alice never calls deposit or redeem in MultiVault, so her personalUtilization is 0 for every epoch.",
          "modality": "asserted",
          "evidence_ids": [
            "e_d1544f37b1f5_0012",
            "e_d1544f37b1f5_0024",
            "e_d1544f37b1f5_0028"
          ]
        },
        {
          "id": "alice_eligible_prev_zero",
          "kind": "precondition",
          "text": "eligible[epoch N-1] = 0 for Alice.",
          "modality": "asserted",
          "evidence_ids": [
            "e_d1544f37b1f5_0026"
          ]
        },
        {
          "id": "alice_claimed_prev_zero",
          "kind": "precondition",
          "text": "userClaimedRewardsForEpoch[Alice][epoch N-1] = 0 because she never claimed.",
          "modality": "asserted",
          "evidence_ids": [
            "e_d1544f37b1f5_0027"
          ]
        }
      ],
      "intent_sources": [
        {
          "id": "first_timer_should_get_full",
          "kind": "security_intent",
          "text": "A first-time claimant with nothing claimable last epoch (target == 0 and eligible[prev] == 0) must not be penalized and should receive the full 100% personal utilization ratio.",
          "modality": "asserted",
          "evidence_ids": [
            "e_d1544f37b1f5_0003",
            "e_d1544f37b1f5_0004",
            "e_d1544f37b1f5_0030"
          ]
        },
        {
          "id": "first_timer_check_reachable",
          "kind": "security_intent",
          "text": "The first-timer eligibility check must be reachable and evaluated even when rawUtilizationDelta <= 0.",
          "modality": "asserted",
          "evidence_ids": [
            "e_d1544f37b1f5_0005",
            "e_d1544f37b1f5_0022",
            "e_d1544f37b1f5_0055"
          ]
        }
      ],
