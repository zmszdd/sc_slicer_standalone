        "evidence_ids": [
          "e_244b113541c8_0003"
        ]
      },
      "impact_qualifier_types": [
        "range"
      ],
      "precondition_sources": [
        {
          "id": "max_fee_cap_500000",
          "kind": "precondition",
          "text": "DynamicSwapFeeModule.MAX_FEE_CAP is set to 500,000 (50%).",
          "modality": "asserted",
          "evidence_ids": [
            "e_244b113541c8_0004"
          ]
        },
        {
          "id": "factory_rejects_above_100000",
          "kind": "precondition",
          "text": "CLFactory.getSwapFee() rejects any fee above 100,000 (10%).",
          "modality": "asserted",
          "evidence_ids": [
            "e_244b113541c8_0005"
          ]
        }
      ],
      "intent_sources": [
        {
          "id": "intent_accept_dynamic_fee",
          "kind": "security_intent",
          "text": "A dynamically calculated fee within MAX_FEE_CAP (500,000) should be accepted and applied rather than rejected by the factory.",
          "modality": "asserted",
          "evidence_ids": [
            "e_244b113541c8_0003",
            "e_244b113541c8_0008"
          ]
        }
