inBefore);\n        \n        //try to remove margin\n        vm.prank(rite);\n        perpManager.removeMargin(rite, 1, 99_000 * 1e18);\n\n        //check margin of rite\n        int256 marginAfter = perpManager.getMarginBalance(rite, 1);\n        console.log(\"Margin: %18e\", marginAfter);\n        assertLt(marginAfter, marginBefore, \"Margin is not decreased\");\n    }\n}",
