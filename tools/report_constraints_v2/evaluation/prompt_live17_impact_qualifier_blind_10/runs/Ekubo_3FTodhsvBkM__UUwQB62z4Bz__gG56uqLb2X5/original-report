pperFactory} from \"../src/TokenWrapperFactory.sol\";\n\ncontract PoC is FullTest {\n    address alice = makeAddr(\"alice\");\n    address bob = makeAddr(\"bob\");\n\n    function testMissingDeadlineInSwaps(CallPoints memory callPoints) public {\n        // SET UP WITH MODERATE LIQUIDITY\n        PoolKey memory poolKey = createPool(0, 1 << 63, 100, callPoints);\n\n        // Add reasonable liquidity - not too much, not too little\n        token0.approve(address(positions), 1500);\n        token1.approve(address(positions), 1500);\n        positions.mintAndDeposit(poolKey, -100, 100, 1500, 1500, 0);\n\n        // GIVE USERS TOKENS\n        token0.transfer(alice, 1000);\n        token1.transfer(alice, 1000);\n        token0.transfer(bob, 2300);\n        token1.transfer(bob, 2300);\n\n        vm.startPrank(alice);\n        token0.approve(address(router), 800);\n        token1.approve(address(router), 800);\n\n        // 1. ALICE PREPARES TRANSACTION AT FAVOURABLE PRICES\n        // SNAPSHOT: SHOWS TOKENS ALICE WOULD HAVE GOT\n        uint256 snapshot = vm.snapshot();\n        PoolBalanceUpdate balanceUpdate = router.swap(\n            poolKey,\n            false,\n            800,\n            SqrtRatio.wrap(0),\n            0,\n            348,\n            alice\n        );\n        int128 expectedToken1 = balanceUpdate.delta1();\n\n        console.log(\"EXPECTED AT SUBMISSION: \", uint128(-expectedToken1));\n\n        vm.revertTo(snapshot);\n        vm.stopPrank();\n\n        // 2. TRANSACTION SITS IN MEMPOOL\n        // DURING THIS TIME, MARKET CONDITIONS CHANGE\n        vm.warp(block.timestamp + 2 hours);\n\n        // 3. LARGE SWAP MOVES THE PRICE\n        vm.startPrank(bob);\n        token0.approve(address(router), 2300);\n        router.swap(poolKey, false, 2300, SqrtRatio.wrap(0), 0, 0, bob);\n        vm.stopPrank();\n\n        // 4. ALICE'S TRANSACTION EXECUTES AT WORSE PRICE\n        vm.startPrank(alice);\n        PoolBalanceUpdate balanceUpdate1 = router.swap(\n            poolKey,\n            false,\n            800,\n            SqrtRatio.wrap(0),\n            0,\n            348,\n            alice\n        );\n        int128 actualToken1 = balanceUpdate1.delta1();\n\n        console.log(\"ACTUAL AT EXECUTION:\", uint128(-actualToken1));\n\n        uint128 expected = uint128(-expectedToken1);\n        uint128 actual = uint128(-actualToken1);\n        console.log(\"LOSS: \", expected - actual);\n\n        assertLt(actual, expected);\n        // WITH DEADLINE: TRANSACTION WOULD HAVE BEEN REVERTED AFTER SET TIME\n        // PROTECTING USER FROM STALE EXECUTION\n\n        vm.stopPrank();\n    }\n}\n```",
