ess(tokenA), 10000e18);\n        tokenB.approve(address(accountManager), 10000e18);\n        accountManager.deposit(userB, address(tokenB), 10000e18);\n\n        // post limit order\n        vm.startPrank(userA);\n        ICLOB.PostLimitOrderArgs memory argsA = ICLOB.PostLimitOrderArgs({\n            amountInBase: 1e18, \n            price: 1999e18,\n            cancelTimestamp: 0,\n            side: Side.SELL,\n            clientOrderId: 0,\n            limitOrderType: ICLOB.LimitOrderType.POST_ONLY\n        });\n        ICLOB(abCLOB).postLimitOrder(userA, argsA);\n\n        // userB makes an order that is divisible by lot size\n        vm.startPrank(userB);\n        ICLOB.PostFillOrderArgs memory argsB = ICLOB.PostFillOrderArgs({\n            amount: 0.001e18,\n            priceLimit: 1999e18,\n            side: Side.BUY,\n            amountIsBase: true,\n            fillOrderType: ICLOB.FillOrderType.FILL_OR_KILL\n        });\n        // assert that amount is divisible by lot size\n        assertEq(argsB.amount % 0.001 ether, 0);\n        ICLOB(abCLOB).postFillOrder(userB, argsB);\n\n        // userB makes an undivisible order\n        // FOK order reverts when the amount rounded off of ags.amount is left unfilled\n        argsB.amount = 0.001001e18;\n        // assert new amount is NOT divisible by lot size\n        assertEq(argsB.amount % 0.001 ether, 1000000000000);\n        vm.expectRevert();\n        // order fails in contradiction with protocol specs\n        ICLOB(abCLOB).postFillOrder(userB, argsB);\n\n        // one more trade with a bigger amount than the last one to prove it wasn't a liquidity issue\n        argsB.amount = 0.002e18;\n        ICLOB(abCLOB).postFillOrder(userB, argsB);\n    }\n}\n\ninterface IMissingFunctions {\n    function setLotSizeInBase(uint256 newLotSizeInBase) external;\n    function setMinLimitOrderAmountInBase(uint256 newMinLimitOrderAmountInBase) external;\n}\n```",
