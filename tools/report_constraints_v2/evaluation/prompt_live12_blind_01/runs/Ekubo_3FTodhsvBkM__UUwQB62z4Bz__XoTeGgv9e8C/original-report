  uint256 orderCreationTimestamp = block.timestamp;\n        uint256 executionTimestamp = orderCreationTimestamp + 86400; // +1 day\n        uint256 orderCreationTimestampForLog = orderCreationTimestamp;\n        uint256 executionTimestampForLog = executionTimestamp;\n        console2.log(\"Timestamp before warp\", orderCreationTimestampForLog);\n        console2.log(\"Warp target\", executionTimestampForLog);\n        vm.warp(executionTimestamp); // order sits pending for 1 day\n        console2.log(\"Timestamp after warp\", block.timestamp);\n\n        // Move price so token0 is worth more (1 -> 2 in the scenario)\n        uint128 manipulation = 500_000 ether;\n        token1.approve(address(router), manipulation);\n        router.swap(poolKey, true, int128(uint128(manipulation)), SqrtRatio.wrap(0), 0, type(int256).min, address(this));\n\n        uint256 priceAfter = _spotPriceWad(poolKey);\n\n        // Bob swaps after the price move and gets the better rate\n        token0.transfer(bob, amountIn);\n        vm.startPrank(bob);\n        token0.approve(address(router), amountIn);\n        PoolBalanceUpdate bobSwap =\n            router.swap(poolKey, false, int128(uint128(amountIn)), SqrtRatio.wrap(0), 0, type(int256).min, bob);\n        vm.stopPrank();\n        uint256 bobOut = uint128(uint256(int256(-bobSwap.delta1())));\n\n        // Alice's pending order executes at only her minAmountOut\n        uint256 actualOut = executor.executeOrder();\n        uint256 aliceOut = token1.balanceOf(alice);\n        uint256 executorProfit = token1.balanceOf(address(executor));\n\n        uint256 profitFromBob = bobOut - aliceOut;\n\n        assertGt(priceAfter, priceBefore, \"price should improve for token0\");\n        assertEq(aliceOut, minAmountOut, \"alice only gets her minimum\");\n        assertGt(actualOut, minAmountOut, \"pool would pay more after price move\");\n        assertGt(bobOut, aliceOut, \"bob captures better price than pending order\");\n        assertEq(executorProfit, actualOut - minAmountOut, \"executor keeps the spread\");\n        console2.log(\"Price before %e\", priceBefore);\n        console2.log(\"Price after %e\", priceAfter);\n        console2.log(\"Alice receives %e\", aliceOut);\n        console2.log(\"Bob receives %e\", bobOut);\n        console2.log(\"Bob - Alice %e\", profitFromBob);\n        // console2.log(\"Executor profit %e\", executorProfit);\n\n    }\n\n    function _spotPriceWad(PoolKey memory poolKey) internal returns (uint256) {\n        (PoolBalanceUpdate balanceUpdate,) = router.quote({\n            poolKey: poolKey,\n            isToken1: false,\n            amount: int128(int256(1 ether)),\n            sqrtRatioLimit: MIN_SQRT_RATIO,\n            skipAhead: 0\n        });\n\n        int128 delta0 = balanceUpdate.delta0();\n        int128 delta1 = balanceUpdate.delta1();\n        require(delta0 > 0 && delta1 < 0, \"unexpected quote deltas\");\n\n        uint256 amount0 = uint256(uint128(uint256(int256(delta0))));\n        uint256 amount1 = uint256(uint128(uint256(int256(-delta1))));\n        return FixedPointMathLib.mulDiv(amount1, 1e18, amount0);\n    }\n}\n```",
