r, address(token), amount, amount, intentAddress, deadline, nonce, 0, address(0),\n            pv, pr, ps, sv, sr, ss\n        );\n        assertEq(entrypoint.nonces(user), nonce + 1, \"Happy path: Nonce should increment\");\n        \n\n        // Chain ID updates\n        vm.chainId(newChainId);\n\n        // User attempts the exact same action on the new chain.\n        nonce = entrypoint.nonces(user);\n        \n        (pv, pr, ps) = _signPermit(user, amount, deadline); \n\n        // Simulate Wallet Behavior: Wallet correctly detects new chain and signs using newChainId\n        bytes32 domainSeparatorNew = keccak256(\n            abi.encode(\n                keccak256(\"EIP712Domain(string name,string version,uint256 chainId,address verifyingContract)\"),\n                keccak256(bytes(\"TrailsIntentEntrypoint\")),\n                keccak256(bytes(entrypoint.VERSION())),\n                newChainId, // <-- Wallet uses NEW Chain ID\n                address(entrypoint)\n            )\n        );\n\n        bytes32 intentHashNew = keccak256(\n            abi.encode(\n                entrypoint.TRAILS_INTENT_TYPEHASH(),\n                user,\n                address(token),\n                amount,\n                intentAddress,\n                deadline,\n                newChainId, // <-- Wallet uses NEW Chain ID\n                nonce,\n                0,\n                address(0)\n            )\n        );\n        \n        bytes32 digestNew = keccak256(abi.encodePacked(\"\\x19\\x01\", domainSeparatorNew, intentHashNew));\n        (sv, sr, ss) = vm.sign(userPrivateKey, digestNew);\n\n        // FAILURE: \n        // The contract recovers the address using the STALE (immutable) Domain Separator (ID 31337),\n        // but the user signed using the LIVE Domain Separator (ID 31338).\n        vm.expectRevert(TrailsIntentEntrypoint.InvalidIntentSignature.selector);    \n        entrypoint.depositToIntentWithPermit(\n            user, address(token), amount, amount, intentAddress, deadline, nonce, 0, address(0),\n            pv, pr, ps, sv, sr, ss\n        );\n        \n        vm.stopPrank();\n    }\n```",
