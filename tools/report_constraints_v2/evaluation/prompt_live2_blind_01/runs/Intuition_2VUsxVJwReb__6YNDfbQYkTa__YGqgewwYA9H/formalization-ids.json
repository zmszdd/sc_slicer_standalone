    {
      "id": "core_claim",
      "scope": "AtomWallet UserOperation signature validity window (validUntil/validAfter) handling",
      "modality": "potential",
      "impact_ids": [
        "i_execute_after_intended_window"
      ],
      "properties": {
        "preconditions": {
          "text": "The AtomWallet owner produces a 77-byte signature consisting of a 65-byte ECDSA signature followed by validUntil and validAfter, intending to restrict the UserOperation to a specific time window.; The 12-byte validUntil/validAfter suffix is appended to the signature blob but is not included in the signed digest (userOpHash).; The attacker can be the bundler, a relayer, or anyone who can intercept and re-submit the UserOp before the EntryPoint processes it.",
          "expression": {
            "op": "and",
            "args": [
              {
                "op": "lt",
                "args": [
                  {
                    "var": "valid_after"
                  },
                  {
                    "var": "valid_until"
                  }
                ]
              },
              {
                "op": "not",
                "args": [
                  {
                    "var": "suffix_in_digest"
                  }
                ]
              },
              {
                "var": "attacker_can_intercept"
              }
            ]
          },
          "evidence_ids": [
            "e_fd342706df75_0009",
            "e_fd342706df75_0010",
