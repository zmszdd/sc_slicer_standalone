edRewards = 0;\n\n    mapping(uint256 => address[]) public depositPoolAddresses;\n    mapping(uint256 => mapping(address => DepositPool)) public depositPools;\n    mapping(uint256 => uint128) public rewardPoolLastCalculatedTimestamp;\n    mapping(uint256 => mapping(address => uint256)) public distributedRewards;\n\n    constructor(address _rewardPool) {\n        rewardPool = _rewardPool;\n    }\n\n    function addDepositPool(\n        uint256 rewardPoolIndex_,\n        address depositPoolAddress_,\n        address token_,\n        address aToken_\n    ) external {\n        depositPoolAddresses[rewardPoolIndex_].push(depositPoolAddress_);\n        depositPools[rewardPoolIndex_][depositPoolAddress_] = DepositPool({\n            token: token_,\n            tokenPrice: 2500e18,\n            lastUnderlyingBalance: 0,\n            strategy: Strategy.AAVE,\n            aToken: aToken_,\n            isExist: true\n        });\n    }\n\n    function setLastUnderlyingBalance(\n        uint256 rewardPoolIndex_,\n        address depositPoolAddress_,\n        uint256 balance_\n    ) external {\n        depositPools[rewardPoolIndex_][depositPoolAddress_].lastUnderlyingBalance = balance_;\n    }\n\n    function setTimestamp(uint256 rewardPoolIndex_, uint128 timestamp_) external {\n        rewardPoolLastCalculatedTimestamp[rewardPoolIndex_] = timestamp_;\n    }\n\n    // VULNERABLE FUNCTION - Contains underflow bug\n    function distributeRewards(uint256 rewardPoolIndex_) external {\n        MockRewardPool rewardPool_ = MockRewardPool(rewardPool);\n        rewardPool_.onlyExistedRewardPool(rewardPoolIndex_);\n\n        uint128 lastTimestamp = rewardPoolLastCalculatedTimestamp[rewardPoolIndex_];\n        require(lastTimestamp != 0, \"Timestamp not set\");\n\n        uint256 rewards_ = rewardPool_.getPeriodRewards(rewardPoolIndex_, lastTimestamp, uint128(block.timestamp));\n        if (rewards_ == 0) return;\n\n        if (!rewardPool_.isRewardPoolPublic(rewardPoolIndex_)) return;\n        if (block.timestamp <= lastTimestamp + minRewardsDistributePeriod) return;\n\n        rewardPoolLastCalculatedTimestamp[rewardPoolIndex_] = uint128(block.timestamp);\n\n        uint256 length_ = depositPoolAddresses[rewardPoolIndex_].length;\n        uint256 totalYield_ = 0;\n        uint256[] memory yields_ = new uint256[](length_);\n\n        for (uint256 i = 0; i < length_; i++) {\n            DepositPool storage pool = depositPools[rewardPoolIndex_][depositPoolAddresses[rewardPoolIndex_][i]];\n\n            address yieldToken = pool.aToken;\n            uint256 balance_ = MockYieldToken(yieldToken).balanceOf(address(this));\n            uint8 decimals_ = MockYieldToken(yieldToken).decimals();\n\n            // VULNERABLE LINE - No underflow protection!\n            uint256 underlyingYield_ = (balance_ - pool.lastUnderlyingBalance).to18(decimals_);\n            uint256 yield_ = underlyingYield_ * pool.tokenPrice;\n\n            pool.lastUnderlyingBalance = balance_;\n            yields_[i] = yield_;\n            totalYield_ += yield_;\n        }\n\n        if (totalYield_ == 0) {\n            undistributedRewards += rewards_;\n            return;\n        }\n\n        for (uint256 i = 0; i < length_; i++) {\n            if (yields_[i] == 0) continue;\n            distributedRewards[rewardPoolIndex_][depositPoolAddresses[rewardPoolIndex_][i]] += \n                (yields_[i] * rewards_) / totalYield_;\n        }\n    }\n}\n\n// Main test contract\ncontract FixedUnderflowTest is Test {\n    VulnerableDistributor public distributor;\n    MockRewardPool public rewardPool;\n    MockYieldToken public aaveToken;\n\n    address public depositPool1 = makeAddr(\"depositPool1\");\n    uint256 public constant REWARD_POOL_INDEX = 0;\n\n    function setUp() public {\n        // Set a proper timestamp first to avoid underflow\n        vm.warp(10000); // Set timestamp to 10000 seconds\n\n        rewardPool = new MockRewardPool();\n        distributor = new VulnerableDistributor(address(rewardPool));\n        aaveToken = new MockYieldToken(\"aETH\");\n\n        // Set initial balance\n        aaveToken.setBalance(address(distributor), 1000e18);\n\n        // Add deposit pool\n        distributor.addDepositPool(REWARD_POOL_INDEX, depositPool1, address(aaveToken), address(aaveToken));\n\n        // Now we can safely subtract from block.timestamp\n        distributor.setTimestamp(REWARD_POOL_INDEX, uint128(block.timestamp - 7200));\n\n        console.log(\"Setup complete - Initial balance: 1000 tokens\");\n        console.log(\"Current timestamp: %s\", block.timestamp);\n    }\n\n    /**\n     * @notice Test demonstrating underflow vulnerability\n     */\n    function testUnderflowVulnerability() public {\n        console.log(\"=== UNDERFLOW VULNERABILITY TEST ===\");\n\n        // Set lastUnderlyingBalance to current balance\n        distributor.setLastUnderlyingBalance(REWARD_POOL_INDEX, depositPool1, 1000e18);\n        console.log(\"Set lastUnderlyingBalance: 1000 tokens\");\n\n        // Simulate balance decrease (slashing, fees, etc.)\n        aaveToken.enableDecrease(100e18); // 100 token decrease\n\n        uint256 newBalance = aaveToken.balanceOf(address(distributor));\n        console.log(\"Balance after decrease: %s tokens\", newBalance / 1e18);\n        console.log(\"This will cause underflow: %s - %s\", newBalance / 1e18, 1000);\n\n        // This should revert due to underflow\n        vm.expectRevert();\n        distributor.distributeRewards(REWARD_POOL_INDEX);\n\n        console.log(\" VULNERABILITY CONFIRMED: distributeRewards reverts due to underflow\");\n        console.log(\"   Protocol reward distribution is completely broken\");\n    }\n\n    /**\n     * @notice Test showing DOS impact\n     */\n    function testDOSImpact() public {\n        console.log(\"=== DOS IMPACT TEST ===\");\n\n        // Setup underflow condition\n        distributor.setLastUnderlyingBalance(REWARD_POOL_INDEX, depositPool1, 1000e18);\n        aaveToken.enableDecrease(50e18);\n\n        console.log(\"Underflow condition established\");\n        console.log(\"Testing multiple attempts to distribute rewards...\");\n\n        // Multiple attempts should all fail\n        for (uint i = 0; i < 3; i++) {\n            vm.expectRevert();\n            distributor.distributeRewards(REWARD_POOL_INDEX);\n            console.log(\"Attempt %s: FAILED (as expected)\", i + 1);\n        }\n\n        console.log(\" DOS CONFIRMED: All reward distribution attempts fail\");\n        console.log(\"   Protocol remains broken until manual intervention\");\n    }\n\n    /**\n     * @notice Test showing successful normal operation\n     */\n    function testNormalOperation() public {\n        console.log(\"=== NORMAL OPERATION TEST ===\");\n\n        // Set lastUnderlyingBalance lower than current (normal yield scenario)\n        distributor.setLastUnderlyingBalance(REWARD_POOL_INDEX, depositPool1, 900e18);\n        console.log(\"Set lastUnderlyingBalance: 900 tokens (current: 1000)\");\n        console.log(\"Expected yield: 100 tokens\");\n\n        // This should work fine\n        distributor.distributeRewards(REWARD_POOL_INDEX);\n\n        console.log(\" NORMAL OPERATION: Rewards distributed successfully\");\n        console.log(\"   No underflow when balance >= lastUnderlyingBalance\");\n    }\n\n    /**\n     * @notice Test edge case with zero balance decrease\n     */\n    function testEdgeCaseZeroDecrease() public {\n        console.log(\"=== EDGE CASE: ZERO DECREASE TEST ===\");\n\n        // Set equal balances (no yield, no decrease)\n        distributor.setLastUnderlyingBalance(REWARD_POOL_INDEX, depositPool1, 1000e18);\n        // No decrease enabled, so balance stays at 1000e18\n\n        console.log(\"Both current and last balance: 1000 tokens\");\n        console.log(\"Expected yield: 0 tokens (1000 - 1000 = 0)\");\n\n        // This should work - no underflow since 1000 - 1000 = 0\n        distributor.distributeRewards(REWARD_POOL_INDEX);\n\n        console.log(\" EDGE CASE PASSED: Zero yield handled correctly\");\n    }\n\n    /**\n     * @notice Test showing fix implementation\n     */\n    function testProperFix() public view {\n        console.log(\"=== PROPER FIX DEMONSTRATION ===\");\n        console.log(\"\");\n        console.log(\"VULNERABLE CODE:\");\n        console.log(\"uint256 underlyingYield_ = (balance_ - pool.lastUnderlyingBalance).to18(decimals_);\");\n        console.log(\"\");\n        console.log(\"FIXED CODE:\");\n        console.log(\"uint256 underlyingYield_;\");\n        console.log(\"if (balance_ >= pool.lastUnderlyingBalance) {\");\n        console.log(\"    underlyingYield_ = (balance_ - pool.lastUnderlyingBalance).to18(decimals_);\");\n        console.log(\"} else {\");\n        console.log(\"    underlyingYield_ = 0; // Handle deficit gracefully\");\n        console.log(\"    emit DeficitDetected(poolAddress, pool.lastUnderlyingBalance - balance_);\");\n        console.log(\"}\");\n        console.log(\"pool.lastUnderlyingBalance = balance_; // Always update\");\n    }\n}\n```\n\n\n\nThis setup will allow you to run the comprehensive integer underflow vulnerability demonstration using Foundry within your existing Hardhat project structure.",
