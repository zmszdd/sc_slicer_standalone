withdrawalAmount);\n        // Store the withdrawalId (should be 0 for first withdrawal)\n        uint256 withdrawalId = 0;\n        stakingManager.queueWithdrawal(withdrawalAmount);\n        // the withdarawal has been queued, exchange rate locked, and kHype tokens have not been burned yet\n        vm.stopPrank();\n\n        // 4. user2 stakes 1 ether\n        vm.prank(user2);\n        stakingManager.stake{value: stakeAmount}();\n        uint256 expectMintedkHype = 0.5 ether;\n        // user2 should be minted 0.5 ether of kHype since staked Hype is 2 ether (1 ether staked and 1 ether rewards ) and there is 1 ether of kHype already minted 1*(1/2) = 0.5\n        assertEq(kHYPE.balanceOf(user2), expectMintedkHype, \"User2 should have minted 0.5 ether of kHYPE\");\n\n        // 5. more rewards are recorded in the validator manager\n        vm.prank(address(oracleManager));\n        uint256 rewardAmount_2 = 1 ether;\n        validatorManager.reportRewardEvent(validator, rewardAmount_2);\n\n        //deal the contract enough ether to process a withdrawal of 100% staked Hype + rewards\n        vm.deal(address(stakingManager), 2 * stakeAmount + rewardAmount_1 + rewardAmount_2); //TOTAL 4 ether = 2 * ( 1ether) + 1 ether + 1 ether\n\n        // 6. queue the 100% withdrawal for user2\n        vm.startPrank(user2);\n        kHYPE.approve(address(stakingManager), kHYPE.balanceOf(user2));\n        stakingManager.queueWithdrawal(kHYPE.balanceOf(user2));\n        vm.stopPrank();\n\n        //get both user's balances before confirming the withdrawal\n        uint256 userBalanceBefore = address(user).balance;\n        uint256 user2BalanceBefore = address(user2).balance;\n\n        // 7. both user and user2 confirm the withdrawal\n        vm.prank(user);\n        stakingManager.confirmWithdrawal(withdrawalId);\n        vm.prank(user2);\n        stakingManager.confirmWithdrawal(withdrawalId);\n\n        //verify that eveything has been unstaked and all kHype burned\n        assertEq(kHYPE.totalSupply(), 0, \"Total supply should be  zero\");\n        uint256 totalAmountStakedFinal = stakingManager.totalStaked();\n        uint256 totalRewardsFinal = validatorManager.totalRewards();\n\n        //since everything has been unstaked all the staked amount and rewards should have been equally distributed\n        // however the that is not true\n        uint256 userWithdrawnAmount = address(user).balance - userBalanceBefore;\n        uint256 user2WithdrawnAmount = address(user2).balance - user2BalanceBefore;\n        uint256 totalWithdrawnAmount = userWithdrawnAmount + user2WithdrawnAmount;\n\n        assertLt(totalWithdrawnAmount, totalRewardsFinal + totalAmountStakedFinal);\n\n        //The lost/undistributed amount should be 666666666666666667 or 0.666 ether\n        //_666_666_666_666_666_667\n        console.log(\"The lost amount is \", (totalRewardsFinal + totalAmountStakedFinal) - totalWithdrawnAmount);\n        //NOTE: as previuosly menntioned this will happen with slashing as well\n        // This is because the queued withdrawals affect the exchange rate even though their exchange rate has been locked in.\n    }\n``` \n\n# Slashing Scenario\n\n```solidity\nfunction test_incorrect_exchange_rate_slashing() public {\n        //NOTE: This is the same issue but a PoC for what would happen during a slashing event\n\n        //set the ustake fee to zero for clarity\n        vm.startPrank(manager);\n        stakingManager.setUnstakeFeeRate(0);\n        // Set withdrawal delay to 0 to allow immediate confirmation\n        stakingManager.setWithdrawalDelay(0);\n        // increase the staking size to keep the math simple with whole numbers\n        stakingManager.setMaxStakeAmount(2 ether);\n        vm.stopPrank();\n\n        // Setup initial stake and withdrawal\n        uint256 stakeAmount = 2 ether;\n\n        //create an another user\n        address user2 = makeAddr(\"user2\");\n        //deal user and user2 1 ether which they will both stake\n        vm.deal(user2, stakeAmount);\n        vm.deal(user, stakeAmount);\n\n        vm.startPrank(manager);\n        validatorManager.activateValidator(validator);\n        validatorManager.setDelegation(address(stakingManager), validator);\n        vm.stopPrank();\n\n        // 1. user stakes 2 ether\n        vm.prank(user);\n        stakingManager.stake{value: stakeAmount}();\n\n        // 2. 1 ether of rewards are recorded in the validator manager\n        vm.prank(address(oracleManager));\n        uint256 slashedAmount_1 = 1 ether;\n        validatorManager.reportSlashingEvent(validator, slashedAmount_1);\n\n        // 3. user queues a withdrawal of their total kHype balance which is 1 ether;\n        assertEq(kHYPE.balanceOf(user), stakeAmount, \"User should have 1 ether of kHYPE\");\n        // Approve and queue withdrawal\n        vm.startPrank(user);\n        uint256 withdrawalAmount = kHYPE.balanceOf(user);\n        kHYPE.approve(address(stakingManager), withdrawalAmount);\n        // Store the withdrawalId (should be 0 for first withdrawal)\n        uint256 withdrawalId = 0;\n        stakingManager.queueWithdrawal(withdrawalAmount);\n        // the withdarawal has been queued, exchange rate locked, and kHype tokens have not been burned yet\n        vm.stopPrank();\n\n        // 4. user2 stakes 2 ether\n        vm.prank(user2);\n        stakingManager.stake{value: stakeAmount}();\n        console.log(\"User2 minted kHype\", kHYPE.balanceOf(user2));\n\n        // 5. Another slashing event recorded\n        vm.prank(address(oracleManager));\n        uint256 slashedAmount_2 = 1 ether;\n        validatorManager.reportSlashingEvent(validator, slashedAmount_2);\n\n        //deal the contract enough ether to process a withdrawal of 100% staked Hype + rewards\n        vm.deal(address(stakingManager), 2 * stakeAmount - slashedAmount_1 - slashedAmount_2); //TOTAL 2 ether = 2 * ( 2 ether) - 1 ether - 1 ether\n\n        // 6. queue the 100% withdrawal for user2\n        vm.startPrank(user2);\n        kHYPE.approve(address(stakingManager), kHYPE.balanceOf(user2));\n        stakingManager.queueWithdrawal(kHYPE.balanceOf(user2));\n        vm.stopPrank();\n\n        //get both user's balances before confirming the withdrawal\n        uint256 userBalanceBefore = address(user).balance;\n        uint256 user2BalanceBefore = address(user2).balance;\n\n        // 7. both user and user2 confirm the withdrawal, which will revert second withdrawal\n        vm.prank(user);\n        stakingManager.confirmWithdrawal(withdrawalId);\n        vm.prank(user2);\n        vm.expectRevert(\"Insufficient contract balance\");\n        stakingManager.confirmWithdrawal(withdrawalId);\n\n        //Go ahead and deal the stakingManager funds to see how much would have been withdrawn\n        vm.deal(address(stakingManager), 2 ether);\n        //re-try confirming withdrawal for user2\n        vm.prank(user2);\n        stakingManager.confirmWithdrawal(withdrawalId);\n\n        //verify that eveything has been unstaked and all kHype burned\n        assertEq(kHYPE.totalSupply(), 0, \"Total supply should be  zero\");\n        uint256 totalAmountStakedFinal = stakingManager.totalStaked();\n        uint256 totalRewardsFinal = validatorManager.totalRewards(); // this should be zero\n        uint256 totalSlashedAmount = validatorManager.totalSlashing();\n\n        // since everything has been unstaked all the staked amount and rewards should have been equally distributed\n        // However, the that is not true\n        uint256 userWithdrawnAmount = address(user).balance - userBalanceBefore;\n        uint256 user2WithdrawnAmount = address(user2).balance - user2BalanceBefore;\n        uint256 totalWithdrawnAmount = userWithdrawnAmount + user2WithdrawnAmount;\n\n        //In this test we deposited 4 ether and slashed 2 ether so there SHOULD be 2 ether withdrawn\n        // However, the amount will actually be more leaving the protocol with a loss\n\n        assertGt(totalWithdrawnAmount, (totalRewardsFinal + totalAmountStakedFinal) - totalSlashedAmount);\n\n        //The lost or undistributed slashed amount will be 333333333333333332 or 0.33333... ether\n        uint256 protocalLoss =\n            totalWithdrawnAmount - ((totalRewardsFinal + totalAmountStakedFinal) - totalSlashedAmount);\n        console.log(\"The lost amount is \", protocalLoss);\n    }\n```",
