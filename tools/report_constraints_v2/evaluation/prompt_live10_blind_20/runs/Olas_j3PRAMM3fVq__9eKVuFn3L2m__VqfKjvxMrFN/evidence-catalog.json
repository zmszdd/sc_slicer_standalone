{
  "schema_version": "report-evidence/1",
  "source_sha256": "7432359ce9bc70756fbc5db4575e63a92d7144713b6f12d8495d7bda16f14ced",
  "fragments": [
    {
      "id": "e_7432359ce9bc_0001",
      "text": "UniswapPriceOracle.validatePrice() TWAP calculation is broken",
      "start": 0,
      "end": 61,
      "line": 1
    },
    {
      "id": "e_7432359ce9bc_0002",
      "text": "## Summary",
      "start": 63,
      "end": 73,
      "line": 3
    },
    {
      "id": "e_7432359ce9bc_0003",
      "text": "The validatePrice() function in UniswapPriceOracle.sol contains a mathematical error",
      "start": 74,
      "end": 158,
      "line": 4
    },
    {
      "id": "e_7432359ce9bc_0004",
      "text": "where the calculated TWAP always equals the current spot price, rendering the",
      "start": 160,
      "end": 237,
      "line": 5
    },
    {
      "id": "e_7432359ce9bc_0005",
      "text": "slippage protection completely ineffective.",
      "start": 239,
      "end": 282,
      "line": 6
    },
    {
      "id": "e_7432359ce9bc_0006",
      "text": "## Vulnerability Details",
      "start": 284,
      "end": 308,
      "line": 8
    },
    {
      "id": "e_7432359ce9bc_0007",
      "text": "The function attempts to calculate a Time-Weighted Average Price (TWAP) to compare",
      "start": 310,
      "end": 392,
      "line": 10
    },
    {
      "id": "e_7432359ce9bc_0008",
      "text": "against the current spot price:",
      "start": 394,
      "end": 425,
      "line": 11
    },
    {
      "id": "e_7432359ce9bc_0009",
      "text": "solidity",
      "start": 427,
      "end": 435,
      "line": 13
    },
    {
      "id": "e_7432359ce9bc_0010",
      "text": "uint256 cumulativePrice = cumulativePriceLast + (tradePrice * elapsedTime);",
      "start": 436,
      "end": 511,
      "line": 14
    },
    {
      "id": "e_7432359ce9bc_0011",
      "text": "uint256 timeWeightedAverage = (cumulativePrice - cumulativePriceLast) / elapsedTime;",
      "start": 512,
      "end": 596,
      "line": 15
    },
    {
      "id": "e_7432359ce9bc_0012",
      "text": "Mathematical simplification:",
      "start": 599,
      "end": 627,
      "line": 18
    },
    {
      "id": "e_7432359ce9bc_0013",
      "text": "timeWeightedAverage = (cumulativePriceLast + tradePrice * elapsedTime - cumulativePriceLast) / elapsedTime",
      "start": 628,
      "end": 734,
      "line": 19
    },
    {
      "id": "e_7432359ce9bc_0014",
      "text": "= (tradePrice * elapsedTime) / elapsedTime",
      "start": 755,
      "end": 797,
      "line": 20
    },
    {
      "id": "e_7432359ce9bc_0015",
      "text": "= tradePrice",
      "start": 818,
      "end": 830,
      "line": 21
    },
    {
      "id": "e_7432359ce9bc_0016",
      "text": "Since timeWeightedAverage == tradePrice, the derivation calculation always returns 0:",
      "start": 833,
      "end": 918,
      "line": 24
    },
    {
      "id": "e_7432359ce9bc_0017",
      "text": "solidity",
      "start": 919,
      "end": 927,
      "line": 25
    },
    {
      "id": "e_7432359ce9bc_0018",
      "text": "uint256 derivation = (tradePrice > timeWeightedAverage)",
      "start": 928,
      "end": 983,
      "line": 26
    },
    {
      "id": "e_7432359ce9bc_0019",
      "text": "? ((tradePrice - timeWeightedAverage) * 1e16) / timeWeightedAverage",
      "start": 988,
      "end": 1055,
      "line": 27
    },
    {
      "id": "e_7432359ce9bc_0020",
      "text": ": ((timeWeightedAverage - tradePrice) * 1e16) / timeWeightedAverage;",
      "start": 1060,
      "end": 1128,
      "line": 28
    },
    {
      "id": "e_7432359ce9bc_0021",
      "text": "// derivation = 0 always",
      "start": 1129,
      "end": 1153,
      "line": 29
    },
    {
      "id": "e_7432359ce9bc_0022",
      "text": "This means validatePrice() always returns true regardless of price manipulation.",
      "start": 1156,
      "end": 1236,
      "line": 32
    },
    {
      "id": "e_7432359ce9bc_0023",
      "text": "## Impact",
      "start": 1238,
      "end": 1247,
      "line": 34
    },
    {
      "id": "e_7432359ce9bc_0024",
      "text": "HIGH - The slippage protection in BuyBackBurner._buyOLAS() is ineffective:",
      "start": 1249,
      "end": 1323,
      "line": 36
    },
    {
      "id": "e_7432359ce9bc_0025",
      "text": "1. Attacker flash loans tokens and manipulates Uniswap V2 pool price",
      "start": 1325,
      "end": 1393,
      "line": 38
    },
    {
      "id": "e_7432359ce9bc_0026",
      "text": "2. Calls buyBack() on BuyBackBurner",
      "start": 1394,
      "end": 1429,
      "line": 39
    },
    {
      "id": "e_7432359ce9bc_0027",
      "text": "3. validatePrice(maxSlippage) passes (TWAP = manipulated spot price)",
      "start": 1430,
      "end": 1498,
      "line": 40
    },
    {
      "id": "e_7432359ce9bc_0028",
      "text": "4. previousPrice captures the manipulated price",
      "start": 1499,
      "end": 1546,
      "line": 41
    },
    {
      "id": "e_7432359ce9bc_0029",
      "text": "5. Swap executes at unfavorable rate",
      "start": 1547,
      "end": 1583,
      "line": 42
    },
    {
      "id": "e_7432359ce9bc_0030",
      "text": "6. Post-swap check compares against already-manipulated previousPrice, so it passes",
      "start": 1584,
      "end": 1667,
      "line": 43
    },
    {
      "id": "e_7432359ce9bc_0031",
      "text": "7. Protocol loses funds to sandwich attack",
      "start": 1668,
      "end": 1710,
      "line": 44
    },
    {
      "id": "e_7432359ce9bc_0032",
      "text": "Affected functions:",
      "start": 1712,
      "end": 1731,
      "line": 46
    },
    {
      "id": "e_7432359ce9bc_0033",
      "text": "- BuyBackBurner.sol:185 - pre-swap validation",
      "start": 1732,
      "end": 1777,
      "line": 47
    },
    {
      "id": "e_7432359ce9bc_0034",
      "text": "- LiquidityManagerETH.sol:170",
      "start": 1778,
      "end": 1807,
      "line": 48
    },
    {
      "id": "e_7432359ce9bc_0035",
      "text": "- LiquidityManagerOptimism.sol:232",
      "start": 1808,
      "end": 1842,
      "line": 49
    }
  ]
}
