5e18 - 0.5e18| / 0.5e18 = 0\n        // 0 <= 500 (5%), so it passes\n    }\n}\n\n\nRun with:\nbash\nforge test --match-test testTWAPAlwaysEqualsSpotPrice -vvv\n\n\n\n\n## Recommended Mitigation\n\nStore cumulative price snapshots and calculate TWAP properly:\n\nsolidity\nstruct PriceSnapshot {\n    uint256 cumulativePrice;\n    uint256 timestamp;\n}\nPriceSnapshot public lastSnapshot;\n\nfunction updatePrice() external returns (bool) {\n    uint256 currentCumulative = direction == 0 \n        ? IUniswapV2(pair).price1CumulativeLast()\n        : IUniswapV2(pair).price0CumulativeLast();\n    lastSnapshot = PriceSnapshot(currentCumulative, block.timestamp);\n    return true;\n}\n\nfunction validatePrice(uint256 slippage) external view returns (bool) {\n    uint256 currentCumulative = direction == 0 \n        ? IUniswapV2(pair).price1CumulativeLast()\n        : IUniswapV2(pair).price0CumulativeLast();\n    \n    uint256 elapsedTime = block.timestamp - lastSnapshot.timestamp;\n    require(elapsedTime > 0, \"No time elapsed\");\n    \n    uint256 twap = (currentCumulative - lastSnapshot.cumulativePrice) / elapsedTime;\n    uint256 spotPrice = getPrice();\n    \n    uint256 derivation = spotPrice > twap\n        ? ((spotPrice - twap) * 1e16) / twap\n        : ((twap - spotPrice) * 1e16) / twap;\n    \n    return derivation <= slippage;\n}",
