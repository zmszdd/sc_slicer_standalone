{
  "schema_version": "report-evidence/1",
  "source_sha256": "32a90ccca6b59b17f8cf162337efe592d2883930282ab50057dce5d9cacc4c43",
  "fragments": [
    {
      "id": "e_32a90ccca6b5_0001",
      "text": "Market Creation Fails for Pyth-Based Volatile Assets Due to Missing Oracle Price Update Mechanism",
      "start": 0,
      "end": 97,
      "line": 1
    },
    {
      "id": "e_32a90ccca6b5_0002",
      "text": "## Finding description and impact",
      "start": 99,
      "end": 132,
      "line": 3
    },
    {
      "id": "e_32a90ccca6b5_0003",
      "text": "### Summary",
      "start": 134,
      "end": 145,
      "line": 5
    },
    {
      "id": "e_32a90ccca6b5_0004",
      "text": "The createMarket() function cannot atomically update Pyth oracle price feeds before market initialization, causing market creation to systematically fail for volatile assets (ETH, BTC, MON) when the cached Pyth price exceeds the staleness threshold (typically 10 minutes). This directly contradicts the protocol's documented design where \"volatile assets (e.g., ETH, BTC, MON) are priced through pull feeds from Pyth\" (from audit README).",
      "start": 146,
      "end": 584,
      "line": 6
    },
    {
      "id": "e_32a90ccca6b5_0005",
      "text": "## Root Cause Analysis",
      "start": 586,
      "end": 608,
      "line": 8
    },
    {
      "id": "e_32a90ccca6b5_0006",
      "text": "Root Cause Analysis",
      "start": 610,
      "end": 629,
      "line": 10
    },
    {
      "id": "e_32a90ccca6b5_0007",
      "text": "The vulnerability exists in the createMarket() execution flow:",
      "start": 630,
      "end": 692,
      "line": 11
    },
    {
      "id": "e_32a90ccca6b5_0008",
      "text": "1. Entry Point - Covenant.sol",
      "start": 693,
      "end": 722,
      "line": 12
    },
    {
      "id": "e_32a90ccca6b5_0009",
      "text": "## Attack Scenario / User Impact",
      "start": 724,
      "end": 756,
      "line": 13
    },
    {
      "id": "e_32a90ccca6b5_0010",
      "text": "User wants to create ETH/USDC market using Pyth oracle",
      "start": 758,
      "end": 812,
      "line": 15
    },
    {
      "id": "e_32a90ccca6b5_0011",
      "text": "Pyth's cached ETH price is 11 minutes old (normal during low activity)",
      "start": 813,
      "end": 883,
      "line": 16
    },
    {
      "id": "e_32a90ccca6b5_0012",
      "text": "User calls createMarket(marketParams, initData)",
      "start": 884,
      "end": 931,
      "line": 17
    },
    {
      "id": "e_32a90ccca6b5_0013",
      "text": "Execution path: createMarket() → initMarket() → readBasePriceAndCalculateLiqRatio() → getQuote()",
      "start": 932,
      "end": 1028,
      "line": 18
    },
    {
      "id": "e_32a90ccca6b5_0014",
      "text": "PythOracle checks: staleness = 11 minutes > maxStaleness (10 minutes)",
      "start": 1029,
      "end": 1098,
      "line": 19
    },
    {
      "id": "e_32a90ccca6b5_0015",
      "text": "Transaction REVERTS with PriceOracle_InvalidAnswer",
      "start": 1099,
      "end": 1149,
      "line": 20
    },
    {
      "id": "e_32a90ccca6b5_0016",
      "text": "User must now:",
      "start": 1150,
      "end": 1164,
      "line": 21
    },
    {
      "id": "e_32a90ccca6b5_0017",
      "text": "Call curator.updatePriceFeeds{value: fee}() separately",
      "start": 1166,
      "end": 1220,
      "line": 23
    },
    {
      "id": "e_32a90ccca6b5_0018",
      "text": "Immediately call createMarket() before price goes stale again",
      "start": 1221,
      "end": 1282,
      "line": 24
    },
    {
      "id": "e_32a90ccca6b5_0019",
      "text": "Hope no one else creates the market first (race condition)",
      "start": 1283,
      "end": 1341,
      "line": 25
    },
    {
      "id": "e_32a90ccca6b5_0020",
      "text": "Pay double gas costs",
      "start": 1342,
      "end": 1362,
      "line": 26
    }
  ]
}
