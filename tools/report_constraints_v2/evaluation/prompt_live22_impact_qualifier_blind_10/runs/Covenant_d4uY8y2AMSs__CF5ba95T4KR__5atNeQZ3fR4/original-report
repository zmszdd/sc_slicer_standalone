import {TestMath} from \"../utils/TestMath.sol\";\nimport {Events} from \"../../src/libraries/Events.sol\";\nimport {Errors} from \"../../src/libraries/Errors.sol\";\nimport {LatentSwapLib} from \"../../src/periphery/libraries/LatentSwapLib.sol\";\nimport {PercentageMath} from \"@aave/libraries/math/PercentageMath.sol\";\nimport {IERC4626} from \"forge-std/interfaces/IERC4626.sol\";\nimport {StubERC4626} from \"../mocks/StubERC4626.sol\";\nimport {Ownable} from \"@openzeppelin/access/Ownable.sol\";\n\ncontract CovenantTest is Test {\n    using WadRayMath for uint256;\n\n    // LatentSwapLEX init pricing constants\n    uint160 internal constant P_MAX = uint160((1095445 * FixedPoint.Q96) / 1000000);\n    uint160 internal constant P_MIN = uint160(FixedPoint.Q192 / P_MAX);\n    uint32 internal constant DURATION = 30 * 24 * 60 * 60;\n    uint8 internal constant SWAP_FEE = 0;\n    int64 internal constant LN_RATE_BIAS = 5012540000000000;\n\n    address internal _mockOracle;  // ← Changed from private to internal\n    address internal _mockBaseAsset;  // ← Changed from private to internal\n    address internal _mockQuoteAsset;  // ← Changed from private to internal\n    uint160 private P_LIM_H = LatentSwapLib.getSqrtPriceFromLTVX96(P_MIN, P_MAX, 9500);\n    uint160 private P_LIM_MAX = LatentSwapLib.getSqrtPriceFromLTVX96(P_MIN, P_MAX, 9999);\n\n    // PoC Contract Deployments\n    Covenant public covenant;\n    LatentSwapLEX public lex;\n    CovenantCurator public covenantCurator;\n    StubPriceOracle public covenantCuratorOracle;\n    MarketId internal _marketId;\n    MockChainlinkAggregator public chainlinkAggregator;\n    ChainlinkOracle public chainlinkOracle;\n    MockPyth public pyth;\n    PythOracle public pythOracle;\n\n    ////////////////////////////////////////////////////////////////////////////\n\n    function setUp() public {\n        // Deploy mock Oracle\n        _mockOracle = address(new MockOracle(address(this)));\n\n        // Deploy mock Base Asset w/ pre-mint\n        _mockBaseAsset = address(new MockERC20(address(this), \"MockBaseAsset\", \"MBA\", 18));\n        MockERC20(_mockBaseAsset).mint(address(this), 100e18);\n\n        // Deploy mock Quote Asset\n        _mockQuoteAsset = address(new MockERC20(address(this), \"MockQaseAsset\", \"MQA\", 18));\n\n        // Deploy Covenant\n        covenant = new Covenant(address(this));\n\n        // Deploy LEX implementation\n        lex = new LatentSwapLEX(\n            address(this),\n            address(covenant),\n            P_MAX,\n            P_MIN,\n            P_LIM_H,\n            P_LIM_MAX,\n            LN_RATE_BIAS,\n            DURATION,\n            SWAP_FEE\n        );\n\n        // Connect LEX w/ Covenant\n        covenant.setEnabledLEX(address(lex), true);\n\n        // Connect mock oracle w/ Covenant\n        covenant.setEnabledCurator(_mockOracle, true);\n\n        // Create a mock market\n        MarketParams memory marketParams = MarketParams({\n            baseToken: _mockBaseAsset,\n            quoteToken: _mockQuoteAsset,\n            curator: _mockOracle,\n            lex: address(lex)\n        });\n        _marketId = covenant.createMarket(marketParams, hex\"\");\n\n        // Deploy the Covenant Curator (Oracle Router)\n        covenantCurator = new CovenantCurator(address(this));\n\n        // Deploy a *stub* oracle for the Covenant Curator\n        covenantCuratorOracle = new StubPriceOracle();\n\n        // Link *stub* oracle with mock base and quote assets\n        covenantCurator.govSetConfig(_mockBaseAsset, _mockQuoteAsset, address(covenantCuratorOracle));\n\n        // Deploy mock Chainlink Aggregator\n        chainlinkAggregator = new MockChainlinkAggregator(8);\n\n        // Deploy Chainlink Oracle\n        chainlinkOracle = new ChainlinkOracle(_mockBaseAsset, _mockQuoteAsset, address(chainlinkAggregator), 1 hours);\n\n        // Deploy mock Pyth\n        pyth = new MockPyth();\n\n        // Deploy Pyth Oracle\n        pythOracle = new PythOracle(\n            address(pyth),\n            _mockBaseAsset,\n            _mockQuoteAsset,\n            bytes32(uint256(196)),\n            10 minutes,\n            250\n        );\n    }\n\n    function test_submissionValidity() public {}\n\n    function test_createMarket_FailsWithStalePythPrice() public {\n        // Deploy NEW mock tokens for this test to avoid market collision\n        address testBaseAsset = address(new MockERC20(address(this), \"TestBase\", \"TB\", 18));\n        address testQuoteAsset = address(new MockERC20(address(this), \"TestQuote\", \"TQ\", 18));\n        \n        // Deploy NEW Pyth Oracle for these tokens\n        PythOracle testPythOracle = new PythOracle(\n            address(pyth),\n            testBaseAsset,\n            testQuoteAsset,\n            bytes32(uint256(999)),  // Different feed ID\n            10 minutes,\n            250\n        );\n        \n        // Configure curator for new tokens\n        covenant.setEnabledCurator(address(covenantCurator), true);\n        covenantCurator.govSetConfig(testBaseAsset, testQuoteAsset, address(testPythOracle));\n        \n        // Set fresh Pyth price\n        PythStructs.Price memory freshPrice = PythStructs.Price({\n            price: 2000 * 1e8,\n            conf: 10 * 1e8,\n            expo: -8,\n            publishTime: uint64(block.timestamp)\n        });\n        pyth.setPrice(freshPrice);\n        \n        // Prepare market parameters with NEW tokens\n        MarketParams memory marketParams = MarketParams({\n            baseToken: testBaseAsset,\n            quoteToken: testQuoteAsset,\n            curator: address(covenantCurator),\n            lex: address(lex)\n        });\n        \n        // TEST 1: Market creation succeeds with fresh price\n        MarketId marketId1 = covenant.createMarket(marketParams, hex\"\");\n        assertTrue(MarketId.unwrap(marketId1) != bytes32(0), \"Market 1 should be created\");\n        \n        // TEST 2: Fast forward 11 minutes (exceeds 10 min maxStaleness)\n        vm.warp(block.timestamp + 11 minutes);\n        \n        // Create a DIFFERENT market to test (change curator to create unique market ID)\n        // We'll use a slightly different setup to get a new market ID\n        address anotherTestBase = address(new MockERC20(address(this), \"AnotherBase\", \"AB\", 18));\n        address anotherTestQuote = address(new MockERC20(address(this), \"AnotherQuote\", \"AQ\", 18));\n        \n        PythOracle anotherPythOracle = new PythOracle(\n            address(pyth),\n            anotherTestBase,\n            anotherTestQuote,\n            bytes32(uint256(888)),\n            10 minutes,\n            250\n        );\n        \n        covenantCurator.govSetConfig(anotherTestBase, anotherTestQuote, address(anotherPythOracle));\n        \n        MarketParams memory staleMarketParams = MarketParams({\n            baseToken: anotherTestBase,\n            quoteToken: anotherTestQuote,\n            curator: address(covenantCurator),\n            lex: address(lex)\n        });\n        \n        // TEST 3: Market creation fails with stale price\n        vm.expectRevert();\n        covenant.createMarket(staleMarketParams, hex\"\");\n        \n        // TEST 4: Update price manually\n        PythStructs.Price memory updatedPrice = PythStructs.Price({\n            price: 2001 * 1e8,\n            conf: 10 * 1e8,\n            expo: -8,\n            publishTime: uint64(block.timestamp)\n        });\n        pyth.setPrice(updatedPrice);\n        \n        bytes[] memory updateData = new bytes[](1);\n        bytes memory encodedUpdateData = abi.encode(updateData);\n        uint256 fee = anotherPythOracle.getUpdateFee(anotherTestBase, anotherTestQuote, encodedUpdateData);\n        anotherPythOracle.updatePriceFeeds{value: fee}(anotherTestBase, anotherTestQuote, encodedUpdateData);\n        \n        // TEST 5: Market creation succeeds after update\n        MarketId marketId2 = covenant.createMarket(staleMarketParams, hex\"\");\n        assertTrue(MarketId.unwrap(marketId2) != bytes32(0), \"Market 2 should be created after price update\");\n    }\n}\n```",
