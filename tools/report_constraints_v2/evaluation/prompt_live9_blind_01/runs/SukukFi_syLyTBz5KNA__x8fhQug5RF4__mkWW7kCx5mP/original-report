illDeposit(user, depositAmount);\n        vm.stopPrank();\n\n        // 3. claim fulfill\n        vm.prank(user);\n        mainVault.deposit(depositAmount, user);\n\n        console.log(\"1. Shares held by user \" , mainShareToken.balanceOf(user) );\n        uint256 initialShares = mainShareToken.balanceOf(user) ;\n\n        // ******************************************************************************************************************* */\n\n        // 3. request deposit in second vault\n        depositAmount = 1000e18;\n        vm.startPrank(user);\n        secondVault.requestDeposit(depositAmount, user, user);\n        vm.stopPrank();\n\n        // 2. fulfill deposit \n        vm.startPrank(investmentManager);\n        secondVault.fulfillDeposit(user, depositAmount);\n        vm.stopPrank();\n\n        // 3. claim initial fulfill deposit\n        vm.prank(user);\n        secondVault.deposit(depositAmount, user);\n\n        console.log(\"2. Shares held by user \" , mainShareToken.balanceOf(user) );\n        uint256 secondShares = mainShareToken.balanceOf(user) ;\n\n        \n        // ******************************************************************************************************************* */\n        vm.prank(user);\n        mainShareToken.approve(address(secondVault), type(uint256).max) ;\n    \n        // 4. request redeem in second vault\n        depositAmount = 1000e18;\n        uint256 shares = secondShares - initialShares; // shares minted by second vault \n\n        vm.startPrank(user);\n        secondVault.requestRedeem( shares, user, user);\n        vm.stopPrank();\n\n        //5. fulfill redeem\n        vm.startPrank(investmentManager);\n        secondVault.fulfillRedeem(user, shares);\n        vm.stopPrank();\n\n        //6. request redeem again\n        shares = initialShares;\n        vm.startPrank(user);\n        secondVault.requestRedeem( shares, user, user);\n        vm.stopPrank();\n\n        // 4. claim initial fulfill redeem\n        vm.prank(user);\n        secondVault.redeem(secondShares - initialShares, user, user );\n\n        console.log(\"maxWithdraw for user \", secondVault.maxWithdraw(user) );\n        console.log(\"maxRedeem for user \", secondVault.maxRedeem(user) );\n\n        // 5. unregister vault\n        secondVault.setVaultActive(false);\n        mainShareToken.unregisterVault(address(asset2));\n\n        // second vault has share balance but no assets\n        shares = mainShareToken.balanceOf(address(secondVault)); \n        uint256 assets = asset2.balanceOf(address(secondVault)); \n\n        console.log(\"Assets in second vault \" , assets);\n        console.log(\"Shares in second vault \" , shares);\n\n\n\n    }\n```",
