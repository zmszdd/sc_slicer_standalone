  "fragments": [
    {
      "id": "e_a52e03e97b09_0001",
      "text": "The constructor of HypoVault.sol sets totalSupply to 1,000,000 without minting any shares, breaking the ERC20 invariant.",
      "start": 0,
      "end": 120,
      "line": 1
    },
    {
      "id": "e_a52e03e97b09_0002",
      "text": "## Finding description and impact",
      "start": 122,
      "end": 155,
      "line": 3
    },
    {
      "id": "e_a52e03e97b09_0003",
      "text": "The constructor of HypoVault.sol includes the following line:",
      "start": 157,
      "end": 218,
      "line": 5
    },
    {
      "id": "e_a52e03e97b09_0004",
      "text": "**ERC-20 Invariants**:",
      "start": 221,
      "end": 243,
      "line": 8
    },
    {
      "id": "e_a52e03e97b09_0005",
      "text": "- **`balanceOf`** initialized as empty mapping",
      "start": 248,
      "end": 294,
      "line": 9
    },
    {
      "id": "e_a52e03e97b09_0006",
      "text": "- Sum of balances = 0 ≠ totalSupply (1M)",
      "start": 299,
      "end": 339,
      "line": 10
    },
    {
      "id": "e_a52e03e97b09_0007",
      "text": "- Violates ERC-20 specification",
      "start": 344,
      "end": 375,
      "line": 11
    },
    {
      "id": "e_a52e03e97b09_0008",
      "text": "**First Deposit Impact**: Pre-minted shares without backing assets",
      "start": 376,
      "end": 442,
      "line": 12
    },
    {
      "id": "e_a52e03e97b09_0009",
      "text": "## First Depositor Exploitation",
      "start": 444,
      "end": 475,
      "line": 14
    },
    {
      "id": "e_a52e03e97b09_0010",
      "text": "Deposit Flow:",
      "start": 477,
      "end": 490,
      "line": 15
    },
    {
      "id": "e_a52e03e97b09_0011",
      "text": "Scenario:",
      "start": 491,
      "end": 500,
      "line": 16
    },
    {
      "id": "e_a52e03e97b09_0012",
      "text": "- First deposit: 1,000 assets",
      "start": 501,
      "end": 530,
      "line": 17
    },
    {
      "id": "e_a52e03e97b09_0013",
      "text": "- Calculation: (1,000 × 1,000,000) / 1 = 1,000,000,000 shares",
      "start": 531,
      "end": 592,
      "line": 18
    },
    {
      "id": "e_a52e03e97b09_0014",
      "text": "-> Result: 1,000 assets → 1 billion shares",
      "start": 593,
      "end": 635,
      "line": 19
    },
    {
      "id": "e_a52e03e97b09_0015",
      "text": "Post-Deposit State Analysis:",
      "start": 637,
      "end": 665,
      "line": 21
    },
    {
      "id": "e_a52e03e97b09_0016",
      "text": "Balances:",
      "start": 666,
      "end": 675,
      "line": 22
    },
    {
      "id": "e_a52e03e97b09_0017",
      "text": "- Depositor: 1,000,000,000 shares",
      "start": 676,
      "end": 709,
      "line": 23
    },
    {
      "id": "e_a52e03e97b09_0018",
      "text": "- Others: 0 shares",
      "start": 710,
      "end": 728,
      "line": 24
    },
    {
      "id": "e_a52e03e97b09_0019",
      "text": "- ∑ balances = 1,000,000,000",
      "start": 729,
      "end": 757,
      "line": 25
    },
    {
      "id": "e_a52e03e97b09_0020",
      "text": "Total Supply: 1,000,000 (initial) + 1,000,000,000 = 1,001,000,000",
      "start": 758,
      "end": 823,
      "line": 26
    },
    {
      "id": "e_a52e03e97b09_0021",
      "text": "Invariant Status: 1,000,000,000 ≠ 1,001,000,000 -> broken",
      "start": 824,
      "end": 881,
      "line": 27
    },
    {
      "id": "e_a52e03e97b09_0022",
      "text": "Impact: First depositor gets 1000x more shares",
      "start": 883,
      "end": 929,
      "line": 29
    }
  ]
