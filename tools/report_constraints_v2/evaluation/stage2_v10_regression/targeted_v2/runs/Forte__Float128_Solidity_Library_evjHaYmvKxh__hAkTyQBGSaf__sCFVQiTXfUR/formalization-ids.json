    {
      "id": "impact_claim_equal_values_compare_unequal_8a1d9d33",
      "scope": "packedFloat comparison functions (eq, lt) operating on raw representation instead of mathematical value",
      "modality": "potential",
      "impact_ids": [
        "equal_values_compare_unequal"
      ],
      "properties": {
        "preconditions": {
          "text": "pfThreshold has mathematical value 10 and is stored in normalized form (mantissa 1e37, exponent -36).; pfCollateral has mathematical value 1000 but is provided in a non-normalized representation (mantissa 1e40, exponent -37) that the protocol wraps directly.; The collateral's mathematical value 1000 is greater than the liquidation threshold 10, so no liquidation should occur.",
          "expression": null,
          "evidence_ids": [
            "e_edd7707a7d1f_0010",
            "e_edd7707a7d1f_0013",
            "e_edd7707a7d1f_0011",
