    {
      "id": "impact_claim_i_eq_fails_equal_values_74477919",
      "scope": "packedFloat comparison functions (eq, lt) operating on raw representation instead of mathematical value",
      "modality": "potential",
      "impact_ids": [
        "i_eq_fails_equal_values"
      ],
      "properties": {
        "preconditions": {
          "text": "The collateral's mathematical value is 1000, which is greater than the liquidation threshold of 10, so no liquidation should occur.; pfThreshold (value 10) is stored as a normalized value by the protocol with mantissa 1e37 and exponent -36.; pfCollateral (value 1000) is provided by an attacker-influenced oracle in a non-normalized format with mantissa 1e40 and exponent -37, which the protocol wraps directly.; packedFloat is an alias for uint256, so packedFloat.wrap(any_uint256) allows creating unnormalized packedFloat values; normalization via toPackedFloat is not enforced.; The attacker can influence the oracle to supply the collateral value in a specific non-normalized representation that the protocol wraps directly.",
          "expression": null,
          "evidence_ids": [
            "e_edd7707a7d1f_0010",
            "e_edd7707a7d1f_0011",
            "e_edd7707a7d1f_0013",
            "e_edd7707a7d1f_0014",
            "e_edd7707a7d1f_0004",
            "e_edd7707a7d1f_0005"
          ],
          "derivation": "未能生成忠实的形式化前提。",
          "source_ids": [
            "p_collateral_above_threshold",
            "p_threshold_normalized",
            "p_collateral_unnormalized",
            "p_type_allows_unnormalized",
            "assume_oracle_influence"
          ]
        },
        "safety": {
          "text": "Comparison functions should compare the mathematical value of packedFloat inputs, so that a collateral value above the threshold is not treated as below it regardless of representation.",
          "expression": null,
          "evidence_ids": [
            "e_edd7707a7d1f_0003",
            "e_edd7707a7d1f_0004",
            "e_edd7707a7d1f_0011"
          ],
          "derivation": "未能为该影响生成忠实的安全关系。",
