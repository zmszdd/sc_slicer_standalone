managers\n        serviceRegistry.changeManager(address(serviceManager));\n        serviceRegistryTokenUtility.changeManager(address(serviceManager));\n        \n        vm.label(address(serviceRegistry), \"ServiceRegistry\");\n        vm.label(address(serviceManager), \"ServiceManager\");\n    }\n    \n    function _deployMultisigInfrastructure() internal {\n        gnosisSafe = new GnosisSafe();\n        gnosisSafeProxy = new GnosisSafeProxy(address(gnosisSafe));\n        gnosisSafeProxyFactory = new GnosisSafeProxyFactory();\n        gnosisSafeMultisig = new GnosisSafeMultisig(\n            payable(address(gnosisSafe)), \n            address(gnosisSafeProxyFactory)\n        );\n        \n        // Whitelist multisig implementation\n        serviceRegistry.changeMultisigPermission(address(gnosisSafeMultisig), true);\n        \n        vm.label(address(gnosisSafeMultisig), \"GnosisSafeMultisig\");\n    }\n    \n    function _deployStakingInfrastructure() internal {\n        // Get multisig proxy bytecode hash for verification\n        bytes32 multisigProxyHash = keccak256(address(gnosisSafeProxy).code);\n        \n        // Deploy staking activity checker\n        stakingActivityChecker = new StakingActivityChecker(LIVENESS_RATIO);\n        \n        // Deploy staking factory\n        stakingFactory = new StakingFactory(address(0));\n        \n        // Prepare staking parameters\n        StakingBase.StakingParams memory stakingParams = StakingBase.StakingParams({\n            metadataHash: bytes32(uint256(uint160(address(msg.sender)))),\n            maxNumServices: MAX_NUM_SERVICES,\n            rewardsPerSecond: REWARDS_PER_SECOND,\n            minStakingDeposit: MIN_STAKING_DEPOSIT,\n            minNumStakingPeriods: MIN_NUM_STAKING_PERIODS,\n            maxNumInactivityPeriods: MAX_NUM_INACTIVITY_PERIODS,\n            livenessPeriod: LIVENESS_PERIOD,\n            timeForEmissions: TIME_FOR_EMISSIONS,\n            numAgentInstances: NUM_AGENT_INSTANCES,\n            agentIds: emptyArray,\n            threshold: 0,\n            configHash: bytes32(0),\n            proxyHash: multisigProxyHash,\n            serviceRegistry: address(serviceRegistry),\n            activityChecker: address(stakingActivityChecker)\n        });\n        \n        // Deploy staking implementation\n        stakingNativeTokenImpl = new StakingNativeToken();\n        \n        // Create staking instance via factory\n        bytes memory initPayload = abi.encodeWithSelector(\n            stakingNativeTokenImpl.initialize.selector,\n            stakingParams,\n            address(serviceRegistry),\n            multisigProxyHash\n        );\n        stakingNativeToken = StakingNativeToken(payable(\n            stakingFactory.createStakingInstance(address(stakingNativeTokenImpl), initPayload)\n        ));\n        \n        vm.label(address(stakingNativeToken), \"StakingNativeToken\");\n        vm.label(address(stakingActivityChecker), \"StakingActivityChecker\");\n    }\n    \n    function _createAttackerServices() internal {\n        IService.AgentParams[] memory agentParams = new IService.AgentParams[](1);\n        agentParams[0].slots = 1;\n        agentParams[0].bond = REG_BOND;\n        \n        // Service A - owned by attacker\n        serviceManager.create(\n            address(attacker), \n            serviceManager.ETH_TOKEN_ADDRESS(), \n            UNIT_HASH, \n            agentIds,\n            agentParams, \n            THRESHOLD\n        );\n        serviceIdA = 1;\n        \n        // Service B - owned by attacker\n        serviceManager.create(\n            address(attacker), \n            serviceManager.ETH_TOKEN_ADDRESS(), \n            UNIT_HASH, \n            agentIds,\n            agentParams, \n            THRESHOLD\n        );\n        serviceIdB = 2;\n        \n        // Activate and deploy Service A\n        vm.prank(address(attacker));\n        serviceManager.activateRegistration{value: REG_DEPOSIT}(serviceIdA);\n        \