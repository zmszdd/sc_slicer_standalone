kenUtility internal serviceRegistryTokenUtility;\n    ServiceManager internal serviceManager;\n    StakingNativeToken internal stakingNativeTokenImpl;\n    StakingNativeToken internal stakingNativeToken;\n    StakingFactory internal stakingFactory;\n    StakingActivityChecker internal stakingActivityChecker;\n    \n    // --- ACTORS ---\n    address payable[] internal users;\n    address internal deployer;\n    address internal operator;\n    MaliciousAttacker internal attacker;\n    \n    // --- SERVICES ---\n    uint256 internal serviceIdA;\n    uint256 internal serviceIdB;\n    address internal agentInstanceA;\n    address internal agentInstanceB;\n    \n    // --- STAKING PARAMETERS ---\n    uint256 internal constant MAX_NUM_SERVICES = 10;\n    uint256 internal constant REWARDS_PER_SECOND = 549768518519; // ~1.5 ETH/month\n    uint256 internal constant MIN_STAKING_DEPOSIT = 10 ether;\n    uint256 internal constant MIN_NUM_STAKING_PERIODS = 3;\n    uint256 internal constant MAX_NUM_INACTIVITY_PERIODS = 3;\n    uint256 internal constant LIVENESS_PERIOD = 1 days;\n    uint256 internal constant TIME_FOR_EMISSIONS = 1 weeks;\n    uint256 internal constant LIVENESS_RATIO = 0.0001 ether;\n    uint256 internal constant NUM_AGENT_INSTANCES = 1;\n    \n    uint96 internal constant REG_BOND = 10 ether;\n    uint256 internal constant REG_DEPOSIT = 10 ether;\n    uint32 internal constant THRESHOLD = 1;\n    \n    bytes32 internal constant UNIT_HASH = 0x9999999999999999999999999999999999999999999999999999999999999999;\n    uint32[] internal agentIds;\n    uint256[] internal emptyArray;\n    bytes internal payload;\n\n    // ========================================================================\n    // SETUP\n    // ========================================================================\n    \n    function setUp() public {\n        // Initialize agent IDs\n        agentIds = new uint32[](1);\n        agentIds[0] = 1;\n        \n        // Create users\n        utils = new U