Impact;\n        } else {\n            _impacts[proposalId] = rawImpact;\n        }\n    }\n\n    function getImpact(uint256 tokenId) external view returns (uint256) {\n        return _impacts[tokenId];\n    }\n\n    function getMaturity(uint256 tokenId) external view returns (uint256) {\n        return _maturities[tokenId];\n    }\n}\n\ncontract ServiceNftFixedTest is Test {\n    ServiceNftFixed public serviceNft;\n    address public dao;\n    address public attacker;\n\n    uint256 constant VIRTUAL_ID = 1;\n    uint256 constant CORE_ID = 1;\n    uint256 constant DATASET_ID = 100;\n    uint256 constant DATASET_IMPACT_WEIGHT = 1000;\n\n    function setUp() public {\n        dao = address(0x1);\n        attacker = address(0x2);\n\n        vm.prank(dao);\n        serviceNft = new ServiceNftFixed();\n    }\n\n    function testUpdateImpactFixed() public {\n        vm.startPrank(dao);\n\n        uint256 firstServiceId = serviceNft.mint(\n            VIRTUAL_ID,\n            CORE_ID,\n            500,\n            0,\n            0\n        );\n        console.log(\"First service minted with ID:\", firstServiceId);\n\n        uint256 serviceId = serviceNft.mint(\n            VIRTUAL_ID,\n            CORE_ID,\n            1000,\n            DATASET_ID,\n            DATASET_IMPACT_WEIGHT\n        );\n        vm.stopPrank();\n\n        console.log(\"Service minted with ID:\", serviceId);\n        console.log(\"Dataset ID:\", DATASET_ID);\n\n        uint256 initialServiceImpact = serviceNft.getImpact(serviceId);\n        uint256 initialDatasetImpact = serviceNft.getImpact(DATASET_ID);\n\n        console.log(\"Initial service impact:\", initialServiceImpact);\n        console.log(\"Initial dataset impact:\", initialDatasetImpact);\n\n        assertGt(initialServiceImpact, 0, \"Service impact should be non-zero\");\n        assertGt(initialDatasetImpact, 0, \"Dataset impact should be non-zero\");\n\n        uint256 afterServiceImpact = serviceNft.getImpact(serviceId);\n        uint256 afterDatasetImpact = serviceNft.getImpact(DATASET_ID);\n\n        console.log(\"Service impact after attempted attack:\", afterServiceImpact);\n        console.log(\"Dataset impact after attempted attack:\", afterDatasetImpact);\n\n        assertEq(afterServiceImpact, initialServiceImpact, \"Service impact should be unchanged\");\n        assertEq(afterDatasetImpact, initialDatasetImpact, \"Dataset impact should be unchanged\");\n    }\n}\n\ncontract ServiceNft {\n    mapping(uint256 => uint256) public _maturities;\n    mapping(uint256 => uint256) public _impacts;\n    mapping(uint256 => uint256) public _cores;\n    mapping(uint256 => mapping(uint256 => uint256)) public _coreServices;\n    mapping(uint256 => uint256) public _datasetServiceIds;\n\n    uint256 private _tokenIdCounter = 1;\n\n    address public dao;\n\n    constructor() {\n        dao = msg.sender;\n    }\n\n    modifier onlyDAO() {\n        require(msg.sender == dao, \"Caller is not the DAO\");\n        _;\n    }\n\n    function mint(\n        uint256 virtualId,\n        uint256 coreId,\n        uint256 maturity,\n        uint256 datasetId,\n        uint256 datasetImpactWeight\n    ) external onlyDAO returns (uint256) {\n        uint256 proposalId = _tokenIdCounter++;\n\n        _cores[proposalId] = coreId;\n        _maturities[proposalId] = maturity;\n\n        if (datasetId > 0) {\n            _datasetServiceIds[datasetId] = proposalId;\n        }\n\n        updateImpact(virtualId, proposalId, datasetId, datasetImpactWeight);\n\n        _coreServices[virtualId][coreId] = proposalId;\n\n        return proposalId;\n    }\n\n    function updateImpact(\n        uint256 virtualId,\n        uint256 proposalId,\n        uint256 datasetId,\n        uint256 datasetImpactWeight\n    ) public {\n        uint256 prevServiceId = _coreServices[virtualId][_cores[proposalId]];\n        uint256 rawImpact = 0;\n\n        if (_maturities[proposalId] > _maturities[prevServiceId]) {\n            rawImpact = _maturities[proposalId] - _maturities[prevServiceId];\n        }\n\n        if (datasetId > 0) {\n            _maturities[datasetId] = _maturities[proposalId];\n            uint256 datasetImpact = (rawImpact * datasetImpactWeight) / 10000;\n            _impacts[datasetId] = datasetImpact;\n            _impacts[proposalId] = rawImpact - datasetImpact;\n        } else {\n            _impacts[proposalId] = rawImpact;\n        }\n    }\n\n    function getImpact(uint256 tokenId) external view returns (uint256) {\n        return _impacts[tokenId];\n    }\n\n    function getMaturity(uint256 tokenId) external view returns (uint256) {\n        return _maturities[tokenId];\n    }\n}\n\ncontract ServiceNftVulnerabilityTest is Test {\n    ServiceNft public serviceNft;\n    address public dao;\n    address public attacker;\n\n    uint256 constant VIRTUAL_ID = 1;\n    uint256 constant CORE_ID = 1;\n    uint256 constant DATASET_ID = 100;\n    uint256 constant DATASET_IMPACT_WEIGHT = 1000;\n\n    function setUp() public {\n        dao = address(0x1);\n        attacker = address(0x2);\n\n        vm.prank(dao);\n        serviceNft = new ServiceNft();\n    }\n\n    function testUpdateImpactVulnerability() public {\n        vm.startPrank(dao);\n\n        uint256 firstServiceId = serviceNft.mint(\n            VIRTUAL_ID,\n            CORE_ID,\n            500,\n            0,\n            0\n        );\n        console.log(\"First service minted with ID:\", firstServiceId);\n\n        uint256 serviceId = serviceNft.mint(\n            VIRTUAL_ID,\n            CORE_ID,\n            1000,\n            DATASET_ID,\n            DATASET_IMPACT_WEIGHT\n        );\n        vm.stopPrank();\n\n        console.log(\"Service minted with ID:\", serviceId);\n        console.log(\"Dataset ID:\", DATASET_ID);\n\n        uint256 initialServiceImpact = serviceNft.getImpact(serviceId);\n        uint256 initialDatasetImpact = serviceNft.getImpact(DATASET_ID);\n\n        console.log(\"Initial service impact:\",