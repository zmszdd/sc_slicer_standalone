n        uint64 fee = uint64((uint256(5) << 64) / 100);\n        int32 tick = 0;\n\n        PoolKey memory poolKey = createTwammPool({fee: fee, tick: tick});\n        createPosition(poolKey, MIN_TICK, MAX_TICK, 10000, 10000);\n\n        token0.approve(address(orders), type(uint256).max);\n        token1.approve(address(orders), type(uint256).max);\n        token0.approve(address(router), type(uint256).max);\n\n        uint256 pID = positions.mint();\n\n        token0.approve(address(positions), type(uint256).max);\n        token1.approve(address(positions), type(uint256).max);\n\n        uint64 startTime = 0;\n        uint64 endTime = 256;\n\n        OrderKey memory key = OrderKey({\n            token0: poolKey.token0,\n            token1: poolKey.token1,\n            config: createOrderConfig({_fee: fee, _isToken1: false, _startTime: startTime, _endTime: endTime})\n        });\n        orders.mintAndIncreaseSellAmount(key, 100, 28633115306);\n\n        vm.warp(endTime);\n\n        uint256 token0BalanceBefore = token0.balanceOf(address(this));\n        uint256 token1BalanceBefore = token1.balanceOf(address(this));\n\n        uint128 maxAmount0 = 10000;\n        uint128 maxAmount1 = 10000;\n        uint128 minLiquidity = 10000;\n        positions.deposit(pID, poolKey, MIN_TICK, MAX_TICK, maxAmount0, maxAmount1, minLiquidity);\n\n        uint256 token0BalanceAfter = token0.balanceOf(address(this));\n        uint256 token1BalanceAfter = token1.balanceOf(address(this));\n\n        uint256 token0Spent = token0BalanceBefore - token0BalanceAfter;\n        uint256 token1Spent = token1BalanceBefore - token1BalanceAfter;\n\n        // Show that the token0 spent is greater than the max amount0\n        console.log(\"token0 spent\", token0Spent);\n        console.log(\"token1 spent\", token1Spent);\n        assertGt(token0Spent, maxAmount0);\n    }\n}\n```",
