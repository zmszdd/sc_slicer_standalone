      "impact_ids": [
        "impact_decimals_6_instead_of_12"
      ],
      "properties": {
        "preconditions": {
          "text": "USDM, the underlying asset of the sUSDM vault, has 6 decimals.; sUSDM overrides _decimalsOffset() to return 6.; sUSDM overrides decimals() to return a hardcoded 6.",
          "expression": {
            "op": "and",
            "args": [
              {
                "op": "eq",
                "args": [
                  {
                    "var": "underlying_decimals"
                  },
