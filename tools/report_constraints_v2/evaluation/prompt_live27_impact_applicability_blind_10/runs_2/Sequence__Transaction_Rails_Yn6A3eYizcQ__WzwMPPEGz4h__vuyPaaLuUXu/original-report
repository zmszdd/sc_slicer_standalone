ole.log(\"DOMAIN_SEPARATOR (still old):\", vm.toString(entrypoint.DOMAIN_SEPARATOR()));\n        console.log(\"\");\n\n        // ==================== PHASE 3: USER TRIES TO TRANSACT AFTER FORK ====================\n        console.log(\"=== PHASE 3: USER ATTEMPTS TRANSACTION AFTER FORK ===\");\n        \n        // Setup new transaction (nonce incremented)\n        address intentAddress2 = address(0x888);\n        uint256 intentNonce2 = 1; // Next nonce\n        \n        // User creates NEW signature with NEW chainId (as wallet would do)\n        // Wallet (Metamask, etc) will use NEW chainId for DOMAIN_SEPARATOR\n        console.log(\"User wallet creates signature with NEW chainId:\", block.chainid);\n        \n        // This is what user WOULD sign (with new chainId in DOMAIN_SEPARATOR)\n        bytes32 newDomainSeparator = keccak256(\n            abi.encode(\n                keccak256(\"EIP712Domain(string name,string version,uint256 chainId,address verifyingContract)\"),\n                keccak256(bytes(\"TrailsIntentEntrypoint\")),\n                keccak256(bytes(\"1\")),\n                block.chainid, // NEW chainId = 10001\n                address(entrypoint)\n            )\n        );\n        \n        console.log(\"User's DOMAIN_SEPARATOR (with new chainId):\", vm.toString(newDomainSeparator));\n        console.log(\"Contract's DOMAIN_SEPARATOR (immutable, old chainId):\", vm.toString(entrypoint.DOMAIN_SEPARATOR()));\n        console.log(\"\");\n        console.log(\"MISMATCH\");\n        console.log(\"User signature will be INVALID because:\");\n        console.log(\"- User signs with: DOMAIN_SEPARATOR(chainId=10001)\");\n        console.log(\"- Contract verifies with: DOMAIN_SEPARATOR(chainId=31337) + intentHash(chainId=10001)\");\n        console.log(\"\");\n\n        // User signs with NEW chainId (simulating wallet behavior after fork)\n        (uint8 sigV2, bytes32 sigR2, bytes32 sigS2) = \n            _signIntentWithCustomDomainSeparator(\n                newDomainSeparator,\n                user, \n                depositAmount, \n                intentAddress2, \n                deadline, \n                intentNonce2, \n                feeAmount, \n                feeCollector\n            );\n\n        console.log(\"=== ATTEMPTING TRANSACTION ===\");\n        \n        // Try to execute - this will FAIL\n        vm.prank(feeCollector);\n        vm.expectRevert(); // Expect InvalidIntentSignature error\n        entrypoint.depositToIntent(\n            user,\n            address(token),\n            depositAmount,\n            intentAddress2,\n            deadline,\n            intentNonce2,\n            feeAmount,\n            feeCollector,\n            sigV2,\n            sigR2,\n            sigS2\n        );\n\n        console.log(\"Transaction REVERTED\");\n        console.log(\"Error: InvalidIntentSignature\");\n        console.log(\"\");\n    }\n\n    function _signIntent2(\n        address usr,\n        uint256 amt,\n        address intent,\n        uint256 dl,\n        uint256 nonce,\n        uint256 fee,\n        address collector\n    ) internal view returns (uint8 v, bytes32 r, bytes32 s) {\n        bytes32 hash = keccak256(\n            abi.encode(\n                entrypoint.TRAILS_INTENT_TYPEHASH(),\n                usr,\n                address(token),\n                amt,\n                intent,\n                dl,\n                block.chainid,\n                nonce,\n                fee,\n                collector\n            )\n        );\n        bytes32 digest = keccak256(abi.encodePacked(\"\\x19\\x01\", entrypoint.DOMAIN_SEPARATOR(), hash));\n        return vm.sign(userPrivateKey, digest);\n    }\n\n    function _signIntentWithCustomDomainSeparator(\n        bytes32 customDomainSeparator,\n        address usr,\n        uint256 amt,\n        address intent,\n        uint256 dl,\n        uint256 nonce,\n        uint256 fee,\n        address collector\n    ) internal view returns (uint8 v, bytes32 r, bytes32 s) {\n        bytes32 hash = keccak256(\n            abi.encode(\n                entrypoint.TRAILS_INTENT_TYPEHASH(),\n                usr,\n                address(token),\n                amt,\n                intent,\n                dl,\n                block.chainid, // Uses CURRENT chainId (after fork)\n                nonce,\n                fee,\n                collector\n            )\n        );\n        // Use CUSTOM domain separator (with new chainId) - simulating user wallet behavior\n        bytes32 digest = keccak256(abi.encodePacked(\"\\x19\\x01\", customDomainSeparator, hash));\n        return vm.sign(userPrivateKey, digest);\n    }\n\n    function _signPermit(address owner, uint256 permitAmount, uint256 deadline)\n        internal\n        view\n        returns (uint8 v, bytes32 r, bytes32 s)\n    {\n        bytes32 hash = keccak256(\n            abi.encodePacked(\n                \"\\x19\\x01\",\n                token.DOMAIN_SEPARATOR(),\n                keccak256(\n                    abi.encode(\n                        keccak256(\"Permit(address owner,address spender,uint256 value,uint256 nonce,uint256 deadline)\"),\n                        owner,\n                        address(entrypoint),\n                        permitAmount,\n                        token.nonces(owner),\n                        deadline\n                    )\n                )\n            )\n        );\n        return vm.sign(userPrivateKey, hash);\n    }\n}\n```\nResult:\n```\n> forge test --match-contract TrailsIntentEntrypointTest -vvvv\n[⠊] Compiling...\n[⠒] Compiling 1 files with Solc 0.8.30\n[⠑] Solc 0.8.30 finished in 3.48s\nCompiler run successful!\n\nRan 1 test for test/TrailsIntentEntrypoint.t.sol:TrailsIntentEntrypointTest\n[PASS] test_ChainForkCausesPermanentDoSDueToImmutableDomainSeparator() (gas: 196798)\nLogs:\n  === PHASE 1: BEFORE HARD FORK ===\n  Initial chainId: 31337\n  DOMAIN_SEPARATOR (immutable): 0xf34ed92df5d560a