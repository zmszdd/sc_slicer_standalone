     uint256 mockRewardAmount = 1000e18;\n        address gaugeRHYBR = GaugeCL(brokenGauge).rHYBR();\n\n        console.log(\"Mock reward amount:\", mockRewardAmount);\n        console.log(\"Gauge rHYBR value:\", gaugeRHYBR);\n\n        // Prove call 1: depostionEmissionsToken\n        console.log(\"\\nTest 1: IRHYBR(address(0)).depostionEmissionsToken()\");\n        vm.expectRevert();\n        (bool success1, ) = gaugeRHYBR.call(\n            abi.encodeWithSignature(\n                \"depostionEmissionsToken(uint256)\",\n                mockRewardAmount\n            )\n        );\n        assertFalse(\n            success1,\n            \"depostionEmissionsToken to address(0) must fail\"\n        );\n        console.log(\"  [PROVEN] This call REVERTS\");\n\n        // Prove call 2: redeemFor\n        console.log(\"\\nTest 2: IRHYBR(address(0)).redeemFor()\");\n        vm.expectRevert();\n        (bool success2, ) = gaugeRHYBR.call(\n            abi.encodeWithSignature(\n                \"redeemFor(uint256,uint8,address)\",\n                mockRewardAmount,\n                0,\n                alice\n            )\n        );\n        assertFalse(success2, \"redeemFor to address(0) must fail\");\n        console.log(\"  [PROVEN] This call REVERTS\");\n\n        console.log(\n            \"\\n==============================================================================\"\n        );\n        console.log(\"CONCLUSION:\");\n        console.log(\"  1. Gauge has rHYBR = address(0)\");\n        console.log(\"  2. withdraw() ALWAYS calls _getReward()\");\n        console.log(\"  3. _getReward() calls functions on address(0)\");\n        console.log(\"  4. Calls to address(0) ALWAYS revert (proven above)\");\n        console.log(\"  5. Therefore: WITHDRAWAL IS IMPOSSIBLE\");\n        console.log(\"  6. NFT PERMANENTLY LOCKED\");\n        console.log(\"  7. NO RECOVERY POSSIBLE\");\n        console.log(\n            \"==============================================================================\\n\"\n        );\n    }\n\n    /**\n     * @notice Shows working gauge for comparison\n     */\n    function test_WorkingGauge_WithValidRHYBR() public {\n        console.log(\n            \"\\n==============================================================================\"\n        );\n        console.log(\"COMPARISON: Working gauge with valid rHYBR\");\n        console.log(\n            \"==============================================================================\\n\"\n        );\n\n        vm.prank(gaugeAdmin);\n        address workingGauge = gaugeFactoryCL.createGauge(\n            address(rewardHybr),\n            address(votingEscrow),\n            address(0x5678),\n            address(gaugeManager),\n            address(0x1),\n            address(0x2),\n            true,\n            clNonfungiblePositionManager\n        );\n\n        assertTrue(workingGauge != address(0), \"Working gauge created\");\n        assertEq(\n            GaugeCL(workingGauge).rHYBR(),\n            address(rewardHybr),\n            \"Working gauge has valid rHYBR\"\n        );\n        assertTrue(\n            GaugeCL(workingGauge).rHYBR() != address(0),\n            \"Working gauge rHYBR is NOT address(0)\"\n        );\n\n        console.log(\"Working gauge withdrawals WOULD succeed (valid rHYBR)\");\n        console.log(\"Broken gauge withdrawals WILL FAIL (address(0) rHYBR)\");\n    }\n\n    /**\n     * @notice Master test proving the complete vulnerability\n     */\n    function test_MasterProof_AllAssertions() public {\n        console.log(\n            \"\\n==============================================================================\"\n        );\n        console.log(\"MASTER PROOF: All Vulnerability Assertions\");\n        console.log(\n            \"==============================================================================\\n\"\n        );\n\n        freshFactory = new GaugeFactoryCL();\n        freshFactory.initialize(address(permissionsRegistry));\n\n        vm.prank(gaugeAdmin);\n        brokenGauge = freshFactory.createGauge(\n            address(rewardHybr),\n            address(votingEscrow),\n            address(0x1234),\n            address(gaugeManager),\n            address(0x1),\n            address(0x2),\n            true,\n            clNonfungiblePositionManager\n        );\n\n        // PROOF 1: Gauge created with address(0)\n        assertEq(\n            GaugeCL(brokenGauge).rHYBR(),\n            address(0),\n            \"PROOF 1: Gauge has address(0) rHYBR\"\n        );\n\n        // PROOF 2: Gauge exists in registry\n        assertEq(\n            freshFactory.length(),\n            1,\n            \"PROOF 2: Gauge in factory registry\"\n        );\n\n        // PROOF 3: Gauge is retrievable\n        assertEq(\n            freshFactory.gauges(0),\n            brokenGauge,\n            \"PROOF 3: Gauge at index 0\"\n        );\n\n        // PROOF 4: setRHYBR doesn't fix gauge\n        freshFactory.setRHYBR(address(rewardHybr));\n        assertEq(\n            GaugeCL(brokenGauge).rHYBR(),\n            address(0),\n            \"PROOF 4: rHYBR still address(0) after setRHYBR\"\n        );\n\n        // PROOF 5: Owner is factory\n        assertEq(\n            GaugeCL(brokenGauge).owner(),\n            address(freshFactory),\n            \"PROOF 5: Factory is gauge owner\"\n        );\n\n        // PROOF 6: Calls to address(0) revert\n        vm.expectRevert();\n        (bool success, ) = address(0).call(\n            abi.encodeWithSignature(\"anyFunction()\")\n        );\n        assertFalse(success, \"PROOF 6: Calls to address(0) revert\");\n\n        // PROOF 7: No recovery mechanism\n        assertTrue(\n            GaugeCL(brokenGauge).rHYBR() == address(0),\n            \"PROOF 7: NFT permanently locked - NO RECOVERY POSSIBLE\"\n        );\n\n        console.log(\n            \"ALL PROOFS PASSED: NFT PERMANENTLY LOCKED - NO RECOVERY POSSIBLE\"\n        );\n    }\n}\n\n```",
