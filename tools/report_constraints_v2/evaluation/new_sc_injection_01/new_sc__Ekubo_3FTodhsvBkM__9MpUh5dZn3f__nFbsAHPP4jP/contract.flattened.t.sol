type TickInfo is bytes32;

using {liquidityDelta__src_types_tickInfo_sol, liquidityNet__src_types_tickInfo_sol, parse__src_types_tickInfo_sol} for TickInfo global;

function liquidityDelta__src_types_tickInfo_sol(TickInfo info) pure returns (int128 delta) {
    assembly ("memory-safe") {
        delta := signextend(15, info)
    }
}

function liquidityNet__src_types_tickInfo_sol(TickInfo info) pure returns (uint128 net) {
    assembly ("memory-safe") {
        net := shr(128, info)
    }
}

function parse__src_types_tickInfo_sol(TickInfo info) pure returns (int128 delta, uint128 net) {
    assembly ("memory-safe") {
        delta := signextend(15, info)
        net := shr(128, info)
    }
}

function createTickInfo(int128 _liquidityDelta, uint128 _liquidityNet) pure returns (TickInfo info) {
    assembly ("memory-safe") {
        // info = (liquidityNet << 128) | liquidityDelta
        info := or(shl(128, _liquidityNet), shr(128, shl(128, _liquidityDelta)))
    }
}

