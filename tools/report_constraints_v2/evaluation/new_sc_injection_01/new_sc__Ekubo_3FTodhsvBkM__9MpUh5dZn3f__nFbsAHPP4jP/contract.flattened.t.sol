/// @notice Thrown when stableswap pool positions are not at the min/max tick for the config
error StableswapMustBeFullRange();

function validate__src_types_positionId_sol(PositionId positionId, PoolConfig config) pure {
    if (isConcentrated__src_types_poolConfig_sol(config)) {
        if (tickLower__src_types_positionId_sol(positionId) >= tickUpper__src_types_positionId_sol(positionId)) revert BoundsOrder();
        if (tickLower__src_types_positionId_sol(positionId) < MIN_TICK || tickUpper__src_types_positionId_sol(positionId) > MAX_TICK) revert MinMaxBounds();
        int32 spacing = int32(concentratedTickSpacing__src_types_poolConfig_sol(config));
        if (tickLower__src_types_positionId_sol(positionId) % spacing != 0 || tickUpper__src_types_positionId_sol(positionId) % spacing != 0) revert BoundsTickSpacing();
    } else {
        (int32 lower, int32 upper) = stableswapActiveLiquidityTickRange__src_types_poolConfig_sol(config);
        // For stableswap pools, positions must be exactly min/max tick
        if (tickLower__src_types_positionId_sol(positionId) != lower || tickUpper__src_types_positionId_sol(positionId) != upper) revert StableswapMustBeFullRange();
    }
}

