        if (stableswapAmplification__src_types_poolConfig_sol(config) > 26) {
            revert InvalidStableswapAmplification();
        }
        int32 centerTick = stableswapCenterTick__src_types_poolConfig_sol(config);
        if (centerTick < MIN_TICK || centerTick > MAX_TICK) {
            revert InvalidCenterTick();
        }
    }
}

