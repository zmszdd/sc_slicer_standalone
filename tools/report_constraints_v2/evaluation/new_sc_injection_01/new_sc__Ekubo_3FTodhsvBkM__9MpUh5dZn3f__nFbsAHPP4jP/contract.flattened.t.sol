contract TokenWrapperPeriphery is BaseLocker {
    using FlashAccountantLib for *;

    constructor(ICore core) BaseLocker(core) {}

    function wrap(TokenWrapper wrapper, uint128 amount) external {
        lock(abi.encode(wrapper, msg.sender, msg.sender, int256(uint256(amount))));
    }
    
    function handleLockData(uint256, bytes memory data) internal override returns (bytes memory) {
        (TokenWrapper wrapper, address payer, address recipient, int256 amount) =
            abi.decode(data, (TokenWrapper, address, address, int256));

        if (amount >= 0) {
            ACCOUNTANT.forward(address(wrapper), abi.encode(amount));
            if (uint128(uint256(amount)) > 0) {
                ACCOUNTANT.withdraw(address(wrapper), recipient, uint128(uint256(amount)));
            }
            if (uint256(amount) != 0) {
                if (address(wrapper.UNDERLYING_TOKEN()) == NATIVE_TOKEN_ADDRESS) {
                    SafeTransferLib.safeTransferETH(address(ACCOUNTANT), uint256(amount));
                } else {
                    ACCOUNTANT.payFrom(payer, address(wrapper.UNDERLYING_TOKEN()), uint256(amount));
                }
            }
        }
        return "";
    }
}

contract TokenWrapperPoC is FullTest {
    TokenWrapperFactory factory;
    TokenWrapperPeriphery periphery;
    TestToken underlying;
    TokenWrapper wrapper;

    event Transfer(address indexed from, address indexed to, uint256 value);

    function setUp() public override {
        FullTest.setUp();
        underlying = new TestToken(address(this));
        factory = new TokenWrapperFactory(core);
        periphery = new TokenWrapperPeriphery(core);
        
        wrapper = factory.deployWrapper(IERC20(address(underlying)), 0);
    }

    function testPoCIncorrectEventEmission() public {
        address owner = makeAddr("abcd");
        address spender = makeAddr("ef01");
        address recipient = address(0x1234);
        uint128 amount = 100 ether;

        // 1. Setup: Owner needs wrapped tokens.
        // Transfer underlying to owner first
        underlying.transfer(owner, amount);

        vm.startPrank(owner);
        // Approve periphery to wrap
        underlying.approve(address(periphery), amount);
        // Wrap
        periphery.wrap(wrapper, amount);
        
        // Verify owner has wrapped tokens
        assertEq(wrapper.balanceOf(owner), amount);

        // Owner approves spender
        wrapper.approve(spender, amount);
        vm.stopPrank();

        // 2. Spender transfers tokens from Owner to Recipient
        vm.startPrank(spender);
        
        // 3. Expect the INCORRECT event
        // The bug is that `transferFrom` emits `Transfer(msg.sender, to, amount)`
        // `msg.sender` is `spender`.
        // It SHOULD be `from` (owner).
        
        vm.expectEmit(true, true, true, true);
        emit Transfer(spender, recipient, amount); // We expect the BUGGY event: from = spender

        wrapper.transferFrom(owner, recipient, amount);
        
        vm.stopPrank();

        // Verify transfer actually happened correctly in terms of balances
        assertEq(wrapper.balanceOf(owner), 0);
        assertEq(wrapper.balanceOf(recipient), amount);
    }
}

