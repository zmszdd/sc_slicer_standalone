{
  "schema_version": "report-evidence/1",
  "source_sha256": "54b0da96a49f6f4686796b121f227b9bfb06cb907467f9d228b7656cd5b6b09b",
  "fragments": [
    {
      "id": "e_54b0da96a49f_0001",
      "text": "Public execute and pullAmountAndExecute allow draining router-held residual funds via delegated Multicall3.",
      "start": 0,
      "end": 107,
      "line": 1
    },
    {
      "id": "e_54b0da96a49f_0002",
      "text": "## Lines of code affected",
      "start": 109,
      "end": 134,
      "line": 3
    },
    {
      "id": "e_54b0da96a49f_0003",
      "text": "## Finding description",
      "start": 136,
      "end": 158,
      "line": 5
    },
    {
      "id": "e_54b0da96a49f_0004",
      "text": "Root cause: `TrailsRouter` is publicly callable and `delegatecall`s Multicall3 aggregate3Value, permitting arbitrary targets and ETH values drawn from `address(this)`. The router can accumulate value via:",
      "start": 161,
      "end": 365,
      "line": 7
    },
    {
      "id": "e_54b0da96a49f_0005",
      "text": "- `receive()` accepting ETH.",
      "start": 366,
      "end": 394,
      "line": 8
    },
    {
      "id": "e_54b0da96a49f_0006",
      "text": "- ERC20 pulled in `injectSweepAndCall`.",
      "start": 395,
      "end": 434,
      "line": 9
    },
    {
      "id": "e_54b0da96a49f_0007",
      "text": "- Overpaid ETH not refunded in `pullAmountAndExecute`.",
      "start": 435,
      "end": 489,
      "line": 10
    },
    {
      "id": "e_54b0da96a49f_0008",
      "text": "- Targets returning ETH/tokens to the router. Thus, any nonzero router-held funds can be exfiltrated by a third party via `execute`.",
      "start": 490,
      "end": 622,
      "line": 11
    },
    {
      "id": "e_54b0da96a49f_0009",
      "text": "## Impact explanation",
      "start": 624,
      "end": 645,
      "line": 13
    },
    {
      "id": "e_54b0da96a49f_0010",
      "text": "- Direct theft of residual ETH and/or ERC20 stuck/dusted in router, independent of user mistakes.",
      "start": 647,
      "end": 744,
      "line": 15
    },
    {
      "id": "e_54b0da96a49f_0011",
      "text": "- Likely in real-world routes that partially spend, refund, or rebate.",
      "start": 745,
      "end": 815,
      "line": 16
    }
  ]
}
