      "properties": {
        "preconditions": {
          "text": "User1 and User2 each stake 100 HYPE tokens and receive 100 kHYPE tokens, so total HYPE is 200, total kHYPE supply is 200, and the exchange rate is 1 kHYPE = 1 HYPE.; User1 queues a withdrawal of 100 kHYPE tokens; 100 HYPE is calculated and stored in User1's withdrawal request.; A slashing event penalizes 60 HYPE, leaving total HYPE at 140, total kHYPE supply unchanged at 200, and a new exchange rate of 1 kHYPE = 0.7 HYPE.; After the slashing event, User2 queues a withdrawal of 100 kHYPE; 70 HYPE is calculated and stored in User2's withdrawal request.; After the withdrawal delay, User1 confirms her withdrawal before User2 confirms, and receives 100 HYPE.",
          "expression": {
            "op": "and",
            "args": [
              {
                "op": "eq",
                "args": [
                  {
                    "var": "total_hype_before_slash"
                  },
                  {
                    "const": 200
                  }
                ]
              },
              {
                "op": "eq",
