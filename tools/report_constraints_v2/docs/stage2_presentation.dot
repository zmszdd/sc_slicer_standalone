digraph Stage2 {
  graph [
    rankdir=LR,
    bgcolor="#F7F8FA",
    pad="0.24",
    nodesep="0.28",
    ranksep="0.48",
    splines=ortho,
    fontname="Noto Sans CJK SC",
    fontcolor="#283442",
    fontsize=15,
    labelloc="t",
    label="阶段二：漏洞报告到 P / I / V 规则化"
  ];

  node [
    shape=box,
    style="rounded,filled",
    fillcolor="#FFFFFF",
    color="#C8D0D9",
    fontcolor="#283442",
    fontname="Noto Sans CJK SC",
    fontsize=11,
    margin="0.15,0.10",
    penwidth=1.0
  ];

  edge [
    color="#758292",
    penwidth=1.0,
    arrowsize=0.65
  ];

  input [
    label="输入\n漏洞报告",
    fillcolor="#EEF1F4",
    color="#AAB4BF",
    width=1.35
  ];

  subgraph cluster_prepare {
    label="报告筛查与证据准备";
    style="rounded,filled";
    color="#B4C5D7";
    fillcolor="#EEF4FA";
    fontcolor="#34475B";
    fontname="Noto Sans CJK SC";
    fontsize=12;
    penwidth=1.0;
    margin=12;

    graph [rankdir=TB];

    content [label="整理报告内容\n标题 · 描述 · 影响"];
    evidence [label="按原文分段\n建立证据编号"];
    screening [label="筛查信息是否充分\n对象 · 行为 · 影响 · 安全依据"];

    content -> evidence -> screening;
  }

  subgraph cluster_piv {
    label="场景与 P / I / V 识别";
    style="rounded,filled";
    color="#B9C4CF";
    fillcolor="#F1F4F7";
    fontcolor="#34475B";
    fontname="Noto Sans CJK SC";
    fontsize=12;
    penwidth=1.0;
    margin=12;

    graph [rankdir=TB];

    context [label="识别场景\n范围 · 主体 · 动作 · 根因"];

    p [label="P · 攻击前条件"];
    i [label="I · 应满足的安全性质"];
    v [label="V · 声称发生的直接影响"];

    check [label="核对证据与语义角色\n检查 V 是否直接违反 I\n记录缺失与歧义"];

    { rank=same; p; i; v; }

    context -> p;
    context -> i;
    context -> v;

    p -> check;
    i -> check;
    v -> check;
  }

  subgraph cluster_rules {
    label="规则化";
    style="rounded,filled";
    color="#B7C9BA";
    fillcolor="#EFF5F0";
    fontcolor="#354A39";
    fontname="Noto Sans CJK SC";
    fontsize=12;
    penwidth=1.0;
    margin=12;

    graph [rankdir=TB];

    relation [label="确定安全关系"];
    variables [label="确定观测量与适用范围"];
    organize [label="组织 P / I / V\n形成形式化计划"];

    relation -> variables -> organize;
  }

  output [
    label="输出至阶段三\nP / I / V 形式化计划\n未决项",
    fillcolor="#E8F1E9",
    color="#91AA95",
    width=2.45
  ];

  input -> content;
  screening -> context;
  check -> relation;
  organize -> output;
}
