    {
      "id": "time_passed_computed_from_frozen_timestamp",
      "kind": "root_cause",
      "text": "maybeInsertSnapshot() calculates timePassed using block.timestamp, so when the sequencer was down for an hour but block.timestamp advanced only by seconds, timePassed is artificially small and the snapshot is written with cumulative values that do not reflect the real time gap.",
      "modality": "asserted",
      "entity_ids": [
        "maybe_insert_snapshot",
        "block_timestamp"
      ],
      "evidence_ids": [
        "e_e89564572100_0006",
