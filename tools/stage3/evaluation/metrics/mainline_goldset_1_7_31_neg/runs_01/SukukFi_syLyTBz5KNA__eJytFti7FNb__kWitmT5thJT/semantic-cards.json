  "cards": [
    {
      "schema_version": "stage2-impact-semantic-card/1",
      "impact": {
        "id": "permanent_dos_unregister_vault",
        "text": "An attacker can permanently DoS the unregistration of any vault by sending 1 wei (or any non-zero amount) directly to the vault",
        "modality": "asserted",
        "evidence_ids": [
          "e_d807595ae87e_0007"
        ]
      },
      "impact_qualifier_types": [
        "duration_or_repetition",
        "rate_or_cost",
        "scope"
      ],
      "precondition_sources": [
        {
          "id": "vault_empty_and_deactivated",
          "kind": "precondition",
          "text": "The vault is empty and deactivated, so totalAssets() returns 0.",
          "modality": "asserted",
          "evidence_ids": [
            "e_d807595ae87e_0003",
            "e_d807595ae87e_0004",
            "e_d807595ae87e_0010"
          ]
        },
        {
          "id": "vault_asset_balance_zero_before",
          "kind": "precondition",
          "text": "Before the donation, ERC20(asset).balanceOf(vaultAddress) returns 0.",
          "modality": "asserted",
          "evidence_ids": [
            "e_d807595ae87e_0005",
            "e_d807595ae87e_0006"
          ]
        }
      ],
      "intent_sources": [
        {
          "id": "intent_unregister_when_empty",
          "kind": "security_intent",
          "text": "unregisterVault must succeed in removing a vault from the registry once the vault is empty and deactivated, i.e. when totalAssets() returns 0.",
          "modality": "asserted",
          "evidence_ids": [
            "e_d807595ae87e_0003",
            "e_d807595ae87e_0004"
          ]
        },
        {
          "id": "intent_dust_not_block",
          "kind": "security_intent",
          "text": "Tokens sent directly to the vault (donations, dust, airdrops) must not prevent unregisterVault from succeeding.",
          "modality": "asserted",
          "evidence_ids": [
            "e_d807595ae87e_0006",
            "e_d807595ae87e_0021"
          ]
        }
      ],
      "excluded_inferred_intent_ids": [],
      "formalizability": {
        "status": "selected",
        "reason": "The explicit P/I source selection is recorded; formula validity remains unassessed.",
        "applicability": {
