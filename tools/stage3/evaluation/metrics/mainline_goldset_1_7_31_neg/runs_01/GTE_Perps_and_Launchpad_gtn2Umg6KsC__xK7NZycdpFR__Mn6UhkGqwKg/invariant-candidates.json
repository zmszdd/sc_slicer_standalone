      "candidates": [
        {
          "candidate_id": "impact_claim_liquidity_providers_receive_fa5995a2_e67e4e70::canonical",
          "text": "Liquidity providers must receive the fees they are supposed to receive from swaps.",
          "expression": {
            "op": "ge",
            "args": [
              {
                "var": "c73f41b6c_lp_fees_received"
              },
              {
                "var": "c73f41b6c_lp_fees_expected"
              }
            ]
          },
          "derivation": "canonical_formalization",
          "source_ids": [
            "intent_lp_fee_share"
          ],
          "evidence_ids": [
            "The [GTELaunchpadV2Pair::swap()](https://github.com/code-423n4/2025-08-gte-perps/blob/main/contracts/launchpad/uniswap/GTELaunchpadV2Pair.sol#L232) function first ensures that a fee of **0.3%** is charged on the amountIn (the fee that should be distributed among the liquidity providers), and then calculates and distributes an additional fee towards the `Distributor.sol` contract. However that additional fee is not withheld from the user that made the swap.",
            "ps. This will result in the liquidity providers receiving less fees than they are supposed to."
          ],
          "checkpoints": {
            "raw": {
              "c73f41b6c_lp_fees_expected": "after swap fee distribution",
              "c73f41b6c_lp_fees_received": "after swap fee distribution"
            },
            "normalized": {
              "c73f41b6c_lp_fees_expected": "after",
              "c73f41b6c_lp_fees_received": "after"
            }
          },
          "quality_labels": [],
          "executable": true,
          "score": 3.15
        }
      ]
    },
