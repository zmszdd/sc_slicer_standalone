        "e_8d0179a08a91_0004"
      ]
    },
    {
      "id": "init_once_only",
      "kind": "security_intent",
      "text": "init() must be callable only once, so the builderAdmin set at deployment cannot be overwritten by a later call.",
      "modality": "asserted",
      "entity_ids": [
        "builder_wallet",
        "builder_admin"
      ],
      "evidence_ids": [
