    {
      "id": "init_lacks_access_control",
      "kind": "root_cause",
      "text": "BuilderWallet.init() has no access control and no restriction preventing subsequent calls, so anyone can call it at any time to overwrite the builderAdmin.",
      "modality": "asserted",
      "entity_ids": [
        "builder_wallet",
        "builder_admin",
        "attacker"
      ],
      "evidence_ids": [
