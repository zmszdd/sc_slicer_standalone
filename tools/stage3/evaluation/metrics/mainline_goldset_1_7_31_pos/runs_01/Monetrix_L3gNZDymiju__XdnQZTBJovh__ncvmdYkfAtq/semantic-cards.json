{
  "schema_version": "stage2-impact-semantic-cards/1",
  "cards": [
    {
      "schema_version": "stage2-impact-semantic-card/1",
      "impact": {
        "id": "incorrect_share_pricing_quoting",
        "text": "integrators computing price-per-share, exchange rates, or minOut/maxIn using share decimals can produce incorrect values.",
        "modality": "potential",
        "evidence_ids": [
          "e_1bdedead2cd0_0020"
        ]
      },
      "impact_qualifier_types": [],
      "precondition_sources": [
        {
          "id": "usdm_has_6_decimals",
          "kind": "precondition",
          "text": "USDM, the underlying asset, uses 6 decimals.",
          "modality": "asserted",
          "evidence_ids": [
            "e_1bdedead2cd0_0010"
          ]
        },
        {
          "id": "offset_returns_6",
          "kind": "precondition",
          "text": "sUSDM._decimalsOffset() returns 6.",
          "modality": "asserted",
          "evidence_ids": [
            "e_1bdedead2cd0_0006",
            "e_1bdedead2cd0_0028"
          ]
        },
        {
          "id": "decimals_override_6",
          "kind": "precondition",
          "text": "sUSDM.decimals() is overridden to always return 6.",
          "modality": "asserted",
          "evidence_ids": [
            "e_1bdedead2cd0_0007",
            "e_1bdedead2cd0_0030"
          ]
        }
      ],
      "intent_sources": [
        {
          "id": "intent_decimals_matches_offset",
          "kind": "security_intent",
          "text": "sUSDM.decimals() must equal assetDecimals + _decimalsOffset() (i.e., 12 given USDM's 6 decimals and offset 6), matching ERC-4626 semantics.",
          "modality": "asserted",
          "evidence_ids": [
            "e_1bdedead2cd0_0008",
            "e_1bdedead2cd0_0009",
            "e_1bdedead2cd0_0010",
            "e_1bdedead2cd0_0029",
            "e_1bdedead2cd0_0035"
          ]
        },
        {
          "id": "intent_consistent_share_model",
          "kind": "security_intent",
          "text": "The share token must use one consistent decimals model so that ERC-4626 math and reported share decimals agree.",
          "modality": "asserted",
          "evidence_ids": [
            "e_1bdedead2cd0_0003",
            "e_1bdedead2cd0_0032",
            "e_1bdedead2cd0_0038"
          ]
        }
      ],
      "excluded_inferred_intent_ids": [],
      "formalizability": {
        "status": "selected",
        "reason": "The explicit P/I source selection is recorded; formula validity remains unassessed.",
        "applicability": {
          "impact_id": "incorrect_share_pricing_quoting",
          "status": "selected",
          "precondition_ids": [
            "usdm_has_6_decimals",
            "offset_returns_6",
            "decimals_override_6"
          ],
          "intent_ids": [
            "intent_decimals_matches_offset",
            "intent_consistent_share_model"
          ]
        }
      },
      "rules": [
