digraph Stage3 {
  graph [
    rankdir=LR,
    bgcolor="#F7F8FA",
    pad="0.24",
    nodesep="0.28",
    ranksep="0.48",
    splines=ortho,
    fontname="Noto Sans CJK SC",
    fontcolor="#283442",
    fontsize=15,
    labelloc="t",
    label="阶段三：P / I / V 绑定到代码 → Foundry 差分验证"
  ];

  node [
    shape=box,
    style="rounded,filled",
    fillcolor="#FFFFFF",
    color="#C8D0D9",
    fontcolor="#283442",
    fontname="Noto Sans CJK SC",
    fontsize=11,
    margin="0.15,0.10",
    penwidth=1.0
  ];

  edge [
    color="#758292",
    penwidth=1.0,
    arrowsize=0.65
  ];

  input [
    label="输入\n阶段二 run 三件套\nbinding.json\nsrc · test · PoC",
    fillcolor="#EEF1F4",
    color="#AAB4BF",
    width=1.35
  ];

  subgraph cluster_load {
    label="载入与绑定校验";
    style="rounded,filled";
    color="#B4C5D7";
    fillcolor="#EEF4FA";
    fontcolor="#34475B";
    fontname="Noto Sans CJK SC";
    fontsize=12;
    penwidth=1.0;
    margin=12;

    graph [rankdir=TB];

    load [label="载入阶段二 run\nstage3-spec · constraints · formalization"];
    bind [label="校验 binding 覆盖\n每个 appears_in 符号都有代码绑定"];
    route [label="可表达性与路由分类\nauto_assert / reference_patch"];

    load -> bind -> route;
  }

  subgraph cluster_patch {
    label="生成补丁工程";
    style="rounded,filled";
    color="#B9C4CF";
    fillcolor="#F1F4F7";
    fontcolor="#34475B";
    fontname="Noto Sans CJK SC";
    fontsize=12;
    penwidth=1.0;
    margin=12;

    graph [rankdir=TB];

    codegen [label="P / I / V AST\n→ Solidity 表达式"];

    p [label="P · 前置作用域"];
    i [label="I · assert 不变量"];
    v [label="V · 观察目标"];

    build [label="打补丁 + 构建两套工程\nM1 参考补丁 / M4 自动注入"];

    { rank=same; p; i; v; }

    codegen -> p;
    codegen -> i;
    codegen -> v;

    p -> build;
    i -> build;
    v -> build;
  }

  subgraph cluster_diff {
    label="差分验证与裁决";
    style="rounded,filled";
    color="#B7C9BA";
    fillcolor="#EFF5F0";
    fontcolor="#354A39";
    fontname="Noto Sans CJK SC";
    fontsize=12;
    penwidth=1.0;
    margin=12;

    graph [rankdir=TB];

    forge [label="Foundry 跑原始版 + 补丁版"];
    queries [label="差分四查询\nP∧T / P∧T∧¬I / P∧T∧V / P∧T∧¬V"];
    submit [label="回填并裁决\nstage3-consistency.json"];

    forge -> queries -> submit;
  }

  output [
    label="输出\nstage3-summary.json\nstage3-consistency.json",
    fillcolor="#E8F1E9",
    color="#91AA95",
    width=2.45
  ];

  input -> load;
  route -> codegen;
  build -> forge;
  submit -> output;
}
